<Project>

    <PropertyGroup>
        <TargetFramework>net8.0-windows</TargetFramework>
        <LangVersion>latest</LangVersion>
        <Nullable>enable</Nullable>
        <UseWPF>true</UseWPF>
        <ImplicitUsings>enable</ImplicitUsings>
        <CodeAnalysisRuleSet>..\..\linters\linter.ruleset</CodeAnalysisRuleSet>
    </PropertyGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="DesktopOrganizer.Tests"/>
    </ItemGroup>

</Project>
