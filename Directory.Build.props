<Project>

    <PropertyGroup>
        <Version>0.8.0</Version>
        <!-- DesktopOrganizer.UI's user settings (ChildWindowsState, panel layout, etc. — see
             Properties\Settings.settings) are System.Configuration "User"-scoped, which .NET keys by
             AssemblyVersion: %LocalAppData%\...\<AssemblyVersion>\user.config. If AssemblyVersion moved
             with every release (the SDK default when only <Version> is set), each bump would silently
             orphan every panel/setting the user had under the previous version's folder. Pinned here so
             it never changes across releases; <Version> above still drives FileVersion/
             InformationalVersion (what ships in the installer name and Add/Remove Programs).
             FileVersion must be set explicitly too: the SDK defaults it from AssemblyVersion (not
             Version) once AssemblyVersion is set explicitly, so without this line it would silently
             stay pinned at 1.0.0.0 right along with it. -->
        <AssemblyVersion>1.0.0.0</AssemblyVersion>
        <FileVersion>$(Version)</FileVersion>
        <TargetFramework>net8.0-windows</TargetFramework>
        <LangVersion>latest</LangVersion>
        <Nullable>enable</Nullable>
        <UseWPF>true</UseWPF>
        <ImplicitUsings>enable</ImplicitUsings>
        <CodeAnalysisRuleSet>$(MSBuildThisFileDirectory)linters\linter.ruleset</CodeAnalysisRuleSet>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <!-- Localization (docs/PLANS/localization.md D-2/D-4, ADR-032): only English (neutral) and
             Russian satellite resources are ever produced/published — every other .NET-provided culture
             resource (13+ languages the SDK would otherwise localize framework strings into) is skipped.
             NeutralLanguage also emits [assembly: NeutralResourcesLanguageAttribute("en")], which is what
             closes CA1824 on DesktopOrganizer.Localization. -->
        <SatelliteResourceLanguages>en;ru</SatelliteResourceLanguages>
        <NeutralLanguage>en</NeutralLanguage>
        <!-- Product metadata (release-polish 1.0): shared across every project's assembly attributes.
             Product feeds the Win32 VS_FIXEDFILEINFO "ProductName" field; Task Manager's own "Name"
             column actually reads AssemblyTitle (set per-project — see DesktopOrganizer.UI.csproj for
             why the UI exe overrides it), not Product. Company/Authors/Copyright are otherwise identical
             across all projects, so they belong here rather than being repeated per csproj. -->
        <Product>DesktopOrganizer</Product>
        <Company>khagendev</Company>
        <Authors>khagen</Authors>
        <Copyright>Copyright (c) 2024-2026 khagen</Copyright>
        <Description>A free, open-source Windows desktop organizer that groups your desktop icons into movable, resizable panels.</Description>
    </PropertyGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="DesktopOrganizer.Tests"/>
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="StyleCop.Analyzers" PrivateAssets="all"/>
    </ItemGroup>

</Project>
