<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Skeleton for Ambient Accent panel chrome. Accent brush is expected from panel scope. -->
    <Style x:Key="AmbientPanelBorderStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource Brush.Surface.Base}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Brush.Border.Subtle}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="{StaticResource Radius.Panel}"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
    </Style>
</ResourceDictionary>
