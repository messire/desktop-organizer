<UserControl x:Class="DesktopOrganizer.UI.Controls.SteppedValueEditor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:controls="clr-namespace:DesktopOrganizer.UI.Controls"
             xmlns:loc="clr-namespace:DesktopOrganizer.UI.Localization"
             mc:Ignorable="d"
             x:Name="Root"
             d:DesignWidth="260">
    <!--
        docs/PLANS/color-presets-and-size-step.md §5.3 "SteppedValueEditor": a stepped Slider + manual
        integer entry + unit label, used for all three size sliders (icon size in Customize/New panel
        defaults, grid step in Layout &amp; snapping). Value/Minimum/Maximum/Step are this control's own
        DependencyProperties (code-behind) — the inner Slider/box are NOT bound to them (§5.3's anti-loop
        rule); code-behind synchronizes them imperatively under a guard.
    -->
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <controls:SteppedSlider x:Name="ValueSlider" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,8,0"
                                 AutomationProperties.Name="{Binding AutomationName, ElementName=Root}"/>
        <controls:IntegerInputBox x:Name="ValueBox" Grid.Column="1" Width="48" VerticalAlignment="Center"
                                   AutomationProperties.Name="{Binding AutomationName, ElementName=Root}"/>
        <TextBlock Grid.Column="2" Margin="6,0,0,0" VerticalAlignment="Center" Text="{loc:Loc Common_PixelUnit_Label}"/>
    </Grid>
</UserControl>
