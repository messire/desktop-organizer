<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>WinExe</OutputType>
        <ApplicationIcon>Resources\app.ico</ApplicationIcon>
        <!-- ADR-023 D-2: a custom Program.Main runs the single-instance handshake (mutex + named pipe)
             before any WPF Application is constructed. A Secondary process must never construct App —
             otherwise it runs App.OnExit and can stomp the real Primary's ChildWindowsState (ADR-023
             R-1) — so the WPF SDK's own auto-generated Main() (which always does `new App();
             app.Run();`, wired up via the ApplicationDefinition build action below) cannot be used. -->
        <StartupObject>DesktopOrganizer.UI.Program</StartupObject>
        <!-- release-hardening F1 / ADR-037: PerMonitorV2 DPI awareness (fallback PerMonitor, then
             system-aware) is declared ONLY in this manifest. Rollback = remove this line and the file. -->
        <ApplicationManifest>app.manifest</ApplicationManifest>
        <!-- Release-polish 1.0: AssemblyTitle becomes the Win32 FileDescription resource string, which is
             what Task Manager's "Name" column and Explorer's file Properties "Description"/"File
             description" field actually display — NOT AssemblyName (kept as DesktopOrganizer.UI; renaming
             it would move the per-user Settings.settings user.config path under
             %LocalAppData%\...\<AssemblyVersion>\ and reset every user's settings, and both the installer
             and SingleInstanceNaming reference "DesktopOrganizer.UI.exe" by name) and NOT Product (that
             only feeds the separate "Product name" field). -->
        <AssemblyTitle>DesktopOrganizer</AssemblyTitle>
        <!-- Release-polish 1.0 follow-up (2026-09-28, explicit user approval — see CLAUDE.md's frozen
             settings-contour note): this override used to pin <Company> to "DesktopOrganizer.UI",
             independent of Directory.Build.props's solution-wide <Company> ("khagendev"), because
             System.Configuration derives this exe's per-user Settings.settings user.config folder from
             AssemblyCompanyAttribute — %LocalAppData%\<Company>\<exe>_Url_<hash>\<AssemblyVersion>\
             user.config — and changing it would silently move that folder, indistinguishable from
             resetting every user's settings on upgrade (same hazard as renaming AssemblyName or moving
             AssemblyVersion — see the AssemblyTitle comment above and the pinned AssemblyVersion comment
             in Directory.Build.props). The override is removed here so this project now inherits
             Directory.Build.props's <Company>khagendev</Company> on purpose: Program.cs's
             UserConfigFolderMigration (DesktopOrganizer.UI\Lifecycle) runs once, at the very start of
             Main, before anything reads user.config. It resolves this exe's own
             %LocalAppData%\DesktopOrganizer.UI\DesktopOrganizer.UI_Url_<hash>\ evidence folder (via
             System.Configuration, without ever touching Properties.Settings.Default) and copies only that
             one folder into %LocalAppData%\khagendev\ — atomically (via a staging folder + rename),
             guarded by a named mutex against two processes starting for the first time at once, and
             resumable if interrupted — never deleting the old copy, so no installed user loses settings.
             Do not remove that migration if this <Company> value ever needs to change again — add a new
             one-time migration step instead. -->
    </PropertyGroup>

    <ItemGroup>
        <Content Include="Resources\app.ico" CopyToOutputDirectory="PreserveNewest"/>
    </ItemGroup>

    <ItemGroup>
        <!-- See the StartupObject comment above: App.xaml keeps compiling to a BAML resource and
             InitializeComponent() (via the Page build action), it just no longer gets the markup
             compiler's auto-generated Main(). -->
        <ApplicationDefinition Remove="App.xaml"/>
        <Page Include="App.xaml" SubType="Designer" Generator="MSBuild:Compile"/>
    </ItemGroup>

    <ItemGroup>
        <Compile Update="Properties\Settings.Designer.cs">
            <DesignTimeSharedInput>True</DesignTimeSharedInput>
            <AutoGen>True</AutoGen>
            <DependentUpon>Settings.settings</DependentUpon>
        </Compile>
    </ItemGroup>

    <ItemGroup>
        <None Update="Properties\Settings.settings">
            <Generator>SettingsSingleFileGenerator</Generator>
            <LastGenOutput>Settings.Designer.cs</LastGenOutput>
        </None>
    </ItemGroup>

    <ItemGroup>
        <Page Update="Views\MainWindow.xaml">
            <Generator>MSBuild:Compile</Generator>
            <XamlRuntime>Wpf</XamlRuntime>
            <SubType>Designer</SubType>
        </Page>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\DesktopOrganizer.Core\DesktopOrganizer.Core.csproj"/>
        <ProjectReference Include="..\DesktopOrganizer.Localization\DesktopOrganizer.Localization.csproj"/>
        <ProjectReference Include="..\DesktopOrganizer.Services\DesktopOrganizer.Services.csproj"/>
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
        <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions"/>
        <!-- ADR-033 part 2 (crash safety) — see Directory.Packages.props for why this standalone
             package is needed for Microsoft.Win32.SystemEvents.SessionEnding. -->
        <PackageReference Include="Microsoft.Win32.SystemEvents"/>
    </ItemGroup>

</Project>
