<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    xmlns:po="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options"
                    mc:Ignorable="po">
    <!--
        Ambient Accent Visual System — brush tokens over Colors.xaml (D-1). Every brush below is
        po:Freeze="True": an unfrozen SolidColorBrush living in a shared ResourceDictionary would
        silently undo the frozen-brush performance work already shipped for the converters
        (HexBrushConverter/ColorOpacityBrushConverter, Phase 7 hardening Block A) — a frozen brush is
        thread-safe and immutable, and every consumer of these tokens shares the exact same instance
        instead of paying for a per-element clone.
    -->
    <SolidColorBrush x:Key="Brush.Surface.Base" Color="{StaticResource Color.Surface.Base}" po:Freeze="True"/>
    <SolidColorBrush x:Key="Brush.Surface.Elevated" Color="{StaticResource Color.Surface.Elevated}" po:Freeze="True"/>

    <SolidColorBrush x:Key="Brush.Text.Primary" Color="{StaticResource Color.Text.Primary}" po:Freeze="True"/>
    <SolidColorBrush x:Key="Brush.Text.Secondary" Color="{StaticResource Color.Text.Secondary}" po:Freeze="True"/>
    <SolidColorBrush x:Key="Brush.Text.Muted" Color="{StaticResource Color.Text.Muted}" po:Freeze="True"/>
    <SolidColorBrush x:Key="Brush.Text.Disabled" Color="{StaticResource Color.Text.Disabled}" po:Freeze="True"/>

    <SolidColorBrush x:Key="Brush.Border.Default" Color="{StaticResource Color.Border.Default}" po:Freeze="True"/>
    <SolidColorBrush x:Key="Brush.Border.Subtle" Color="{StaticResource Color.Border.Subtle}" po:Freeze="True"/>
    <SolidColorBrush x:Key="Brush.Border.Hover" Color="{StaticResource Color.Border.Hover}" po:Freeze="True"/>
    <SolidColorBrush x:Key="Brush.Border.Focus" Color="{StaticResource Color.Border.Focus}" po:Freeze="True"/>

    <SolidColorBrush x:Key="Brush.Overlay.Hover" Color="{StaticResource Color.Overlay.Hover}" po:Freeze="True"/>
    <SolidColorBrush x:Key="Brush.Overlay.Pressed" Color="{StaticResource Color.Overlay.Pressed}" po:Freeze="True"/>

    <SolidColorBrush x:Key="Brush.Accent.Neutral" Color="{StaticResource Color.Accent.Neutral}" po:Freeze="True"/>
    <SolidColorBrush x:Key="Brush.Accent.Blue" Color="{StaticResource Color.Accent.Blue}" po:Freeze="True"/>
    <SolidColorBrush x:Key="Brush.Accent.Violet" Color="{StaticResource Color.Accent.Violet}" po:Freeze="True"/>
    <SolidColorBrush x:Key="Brush.Accent.Amber" Color="{StaticResource Color.Accent.Amber}" po:Freeze="True"/>
    <SolidColorBrush x:Key="Brush.Accent.Green" Color="{StaticResource Color.Accent.Green}" po:Freeze="True"/>
    <SolidColorBrush x:Key="Brush.Accent.Cyan" Color="{StaticResource Color.Accent.Cyan}" po:Freeze="True"/>
    <SolidColorBrush x:Key="Brush.Accent.Coral" Color="{StaticResource Color.Accent.Coral}" po:Freeze="True"/>

    <!--
        SelectionFillBrush/SelectionStrokeBrush (C5): relocated verbatim from Templates.xaml (D-2) —
        same key names, same colour, only the owning dictionary changed. Templates.xaml's own comment
        about these being the shared "selected/active" chrome tokens (finalization m-1) still applies;
        it stays on their remaining consumer (FileNameEditBoxStyle) there. Do not rename these keys:
        Controls.xaml's PanelHeaderToggleButtonStyle and Templates.xaml's FileNameEditBoxStyle both
        resolve them by this exact name.
    -->
    <SolidColorBrush x:Key="SelectionFillBrush" Color="{StaticResource Color.Selection.Fill}" po:Freeze="True"/>
    <SolidColorBrush x:Key="SelectionStrokeBrush" Color="{StaticResource Color.Selection.Stroke}" po:Freeze="True"/>

    <!-- Paired foreground for SelectionFillBrush (MAJOR-2 fix, review round 3) — see Colors.xaml's/
         Colors.HighContrast.xaml's Color.Selection.Text remarks for why an un-paired foreground was a
         high-contrast readability bug. -->
    <SolidColorBrush x:Key="SelectionTextBrush" Color="{StaticResource Color.Selection.Text}" po:Freeze="True"/>

    <!-- Sidebar (SystemIconsPanelWindow, C5) — see Colors.xaml's Color.Sidebar.Background remarks. -->
    <SolidColorBrush x:Key="Brush.Sidebar.Background" Color="{StaticResource Color.Sidebar.Background}" po:Freeze="True"/>

    <SolidColorBrush x:Key="Brush.Settings.ChromeBackground" Color="{StaticResource Color.Settings.ChromeBackground}" po:Freeze="True"/>
    <SolidColorBrush x:Key="Brush.Settings.ChromeBorder" Color="{StaticResource Color.Settings.ChromeBorder}" po:Freeze="True"/>
    <SolidColorBrush x:Key="Brush.Settings.TabActiveBackground" Color="{StaticResource Color.Settings.TabActiveBackground}" po:Freeze="True"/>
    <SolidColorBrush x:Key="Brush.Settings.IconMuted" Color="{StaticResource Color.Settings.IconMuted}" po:Freeze="True"/>
    <SolidColorBrush x:Key="Brush.Settings.TextMuted" Color="{StaticResource Color.Settings.TextMuted}" po:Freeze="True"/>
    <SolidColorBrush x:Key="Brush.Settings.SwatchBorder" Color="{StaticResource Color.Settings.SwatchBorder}" po:Freeze="True"/>
    <SolidColorBrush x:Key="Brush.Settings.Warning" Color="{StaticResource Color.Settings.Warning}" po:Freeze="True"/>
</ResourceDictionary>
