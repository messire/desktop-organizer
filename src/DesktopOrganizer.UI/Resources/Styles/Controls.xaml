<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:conv="clr-namespace:DesktopOrganizer.UI.Converters"
                    xmlns:models="clr-namespace:DesktopOrganizer.UI.Models"
                    xmlns:theming="clr-namespace:DesktopOrganizer.UI.Theming"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">
    <!--
        Ambient Accent Visual System — minimal control chrome over Typography.xaml/Icons.xaml (D-1).
        Deliberately thin in this commit: PanelHeaderButtonStyle/PanelHeaderToggleButtonStyle/
        FileNameEditBoxStyle etc. stay in Templates.xaml (D-2) until the commit that
        migrates their consumers (C4/C6) — moving a style here without its consumer in the same commit
        would leave two near-duplicate styles with hex literals free to drift apart, exactly the trap
        Templates.xaml's own top-of-file comment about SelectionFillBrush/SelectionStrokeBrush already
        warns against. C4-C7 extend this dictionary as ChildWindow.xaml/MainWindow.xaml migrate onto it.

        R-6: PanelTheme.Accent (Theming/PanelTheme.cs, C2) is an inherited attached DependencyProperty
        and does NOT cross into a ContextMenu/Popup's separate visual tree. Any accent-dependent chrome
        added to a menu/popup style below MUST come from a StaticResource/DynamicResource token, never
        from PanelTheme.Accent.
    -->
    <!-- MAJOR-3 fix (docs/PLANS/workspace-grid-07-visual.md fix-cycle 1): header icon buttons'
         (Sort/View/RollUp/Overflow) hover wash now picks its own lighten/darken direction from the
         panel's own composed surface luminance (Theming/HoverOverlayPolicy.cs), instead of always
         painting the same translucent WHITE — see Control.Button.Icon/PanelHeaderButtonStyle/
         PanelHeaderToggleButtonStyle's own IsMouseOver triggers below for the 3 consumers. Registered
         here (not Panels.xaml) because all 3 consumers live in THIS dictionary; Panels.xaml's own
         PanelItemContainerStyle hover ALSO uses this SAME converter (a later MAJOR-3 review-round fix
         moved it off the plain Brush.Overlay.Hover StaticResource this comment used to describe), but with
         ConverterParameter="ItemTile" so a dark surface resolves through HoverOverlayPolicy.ForItemTile
         instead of HoverOverlayPolicy.For (NEW-1 fix, docs/PLANS/release-polish-1.0.md — see that Style's
         own IsMouseOver trigger comment in Panels.xaml for why the two consumers need different washes). -->
    <conv:HoverOverlayBrushConverter x:Key="HoverOverlayBrush"/>

    <Style x:Key="Control.Button.Icon" TargetType="Button">
        <Setter Property="Width" Value="{x:Static models:PanelMetrics.HeaderButtonSize}"/>
        <Setter Property="Height" Value="{x:Static models:PanelMetrics.HeaderButtonSize}"/>
        <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Foreground">
            <Setter.Value>
                <MultiBinding Converter="{StaticResource PanelChromeForegroundBrush}" ConverterParameter="Secondary">
                    <Binding Path="(theming:PanelTheme.Accent)" RelativeSource="{RelativeSource Self}"/>
                    <Binding Path="(theming:PanelTheme.Text)" RelativeSource="{RelativeSource Self}"/>
                    <Binding Source="{x:Static theming:HighContrastState.IsActive}"/>
                    <Binding Source="{StaticResource Brush.Text.Secondary}"/>
                </MultiBinding>
            </Setter.Value>
        </Setter>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Chrome"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{StaticResource Radius.Control}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <!-- MAJOR-3 fix: direction-aware hover wash (Theming/HoverOverlayPolicy.cs) —
                             see this dictionary's own HoverOverlayBrush registration comment above. -->
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="Background">
                                <Setter.Value>
                                    <!-- MAJOR-2 fix: PanelTheme.Accent/Text (Brushes), not Model.AccentColor/
                                         TextColor directly — see this dictionary's own HoverOverlayBrush
                                         registration comment above. -->
                                    <MultiBinding Converter="{StaticResource HoverOverlayBrush}">
                                        <Binding Path="(theming:PanelTheme.Accent)" RelativeSource="{RelativeSource Self}"/>
                                        <Binding Path="(theming:PanelTheme.SurfaceStyle)" RelativeSource="{RelativeSource Self}"/>
                                        <Binding Path="(theming:PanelTheme.Text)" RelativeSource="{RelativeSource Self}"/>
                                        <Binding Source="{x:Static theming:HighContrastState.IsActive}"/>
                                        <Binding Source="{StaticResource Brush.Overlay.Hover}"/>
                                    </MultiBinding>
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ══════════════════════════════════════════════════════════════════════════════════════════════
         Focus (design-system-1x.md §2.2/§2.5, ADR-047 D-6, closes H-3): one shared double-ring
         FocusVisualStyle for every Palette T control (this file's Theme.MenuItem below,
         Resources/Styles/Theme.Controls.xaml's whole catalogue, and Settings.xaml's Settings.SegmentedItem/
         .Compact) — replacing each one's former bespoke 1px-border/no-visual focus indicator. A generic (no
         TargetType) Style targeting Control.Template — the standard WPF "custom FocusVisualStyle" shape:
         assigned to a control's OWN FocusVisualStyle property, WPF then overlays this ControlTemplate as an
         adorner automatically whenever that control has keyboard focus — no template trigger/manual
         IsKeyboardFocused wiring needed in each consumer's own template.

         Declared HERE, not in Theme.Controls.xaml (its natural home, and where every other 6.2a "library"
         style lives): Settings.xaml's Settings.SegmentedItem/.Compact ALSO reference it via
         {StaticResource}, and Settings.xaml is merged BEFORE Theme.Controls.xaml (App.xaml.cs
         LoadResourceDictionaries) — a StaticResource reference to a key that only exists in a LATER-merged
         sibling dictionary does not resolve (confirmed empirically: it throws
         "{DependencyProperty.UnsetValue}' is not a valid value" the moment the referencing Style is
         applied). This file (Controls.xaml) is merged BEFORE both Settings.xaml and Theme.Controls.xaml, so
         both can reference this key safely. -->
    <Style x:Key="Theme.FocusVisual">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Grid Margin="-3" SnapsToDevicePixels="True">
                        <Rectangle Stroke="{DynamicResource Theme.Stroke.Focus}" StrokeThickness="2" RadiusX="4" RadiusY="4"/>
                        <Rectangle Stroke="{DynamicResource Theme.Stroke.FocusInner}" StrokeThickness="1" Margin="1" RadiusX="3" RadiusY="3"/>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        Design-system-1x phase 6.2a (docs/PLANS/design-system-1x.md §2.5/§2.6, ADR-047 D-7) — the "Palette
        T" (application chrome) replacements for the pre-6.2a Control.ContextMenu/Control.MenuItem/
        Control.Popup.Chrome styles. Added here (not Theme.Controls.xaml) per the plan's own §4 zone
        table: this dictionary is already merged app-wide by App.xaml.cs, and Theme.ContextMenu/
        Theme.MenuItem/Theme.Popup.Chrome/the app-wide Theme.ToolTip style all belong next to the styles
        they replace. Phase 6.2c migrated ChildWindow.xaml's HeaderContextMenu/MoveHintPopup/
        RenameErrorPopup onto these keys and removed Control.ContextMenu/Control.MenuItem/
        Control.Popup.Chrome outright (their only consumer) — see git history for their prior shape.

        H-1 fix (docs/PLANS/design-system-1x.md §1.1 S-18, ChromeContrastAuditTests'
        KnownGap_H1_SubmenuPopupBackground_DoesNotFollowContextMenuDarkStyle_FailsTextContrast): the stock
        Aero2 MenuItem template's SubmenuHeader/TopLevelHeader role draws its own Popup->Border
        ("SubmenuBorder") with a hard-coded system-colour background that never picked up the ContextMenu's
        OWN styled Background — light text on a light popup. Theme.MenuItem.HeaderTemplate below owns its
        Popup's Border directly and binds its Background to {DynamicResource Theme.Surface.Flyout} — the
        SAME token the ContextMenu's own background/Theme.MenuItem.ItemTemplate's row hover use — so a
        submenu can never again diverge from its parent's theme. ChromeStylesStaTests (T-7) pins this by
        building a REAL ContextMenu/nested MenuItem against these exact styles, opening the submenu, and
        asserting the popup Border's Background is Theme.Surface.Flyout with ≥ 4.5:1 text contrast.

        Both TOP-LEVEL and SUBMENU roles share ONE pair of ControlTemplates (Theme.MenuItem.ItemTemplate/
        HeaderTemplate) rather than four physically distinct ones: every WPF-menu consumer in this app is a
        ContextMenu (no Menu bar), and a header MenuItem whose ItemsControl parent is a ContextMenu already
        pops its submenu to the right at EVERY nesting depth — Role only tells top-level vs. nested apart
        for MenuItem.Role's own IsChecked/keyboard-navigation semantics, not for anything this template
        needs to render differently. Theme.MenuItem's Style.Triggers below still switch on all 4 Role
        values explicitly (not e.g. a single "HasItems" check) so a future Menu-bar consumer, or a reviewer
        auditing role coverage, finds all 4 handled by name.
    -->
    <ControlTemplate x:Key="Theme.MenuItem.ItemTemplate" TargetType="MenuItem">
        <Border x:Name="Bg"
                Background="{TemplateBinding Background}"
                CornerRadius="{DynamicResource Theme.Radius.Control}"
                Padding="{TemplateBinding Padding}"
                MinHeight="{DynamicResource Theme.MenuItem.MinHeight}"
                SnapsToDevicePixels="True">
            <Grid VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="24"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="Check" Grid.Column="0"
                           Text="{StaticResource Icon.Glyph.Checkmark}"
                           FontFamily="Segoe MDL2 Assets, Segoe Fluent Icons"
                           VerticalAlignment="Center"
                           Visibility="Collapsed"/>
                <ContentPresenter Grid.Column="1" ContentSource="Header" RecognizesAccessKey="True"
                                   VerticalAlignment="Center" Margin="4,0,16,0"/>
                <TextBlock x:Name="Gesture" Grid.Column="2"
                           Text="{TemplateBinding InputGestureText}"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource Theme.Text.Secondary}"/>
            </Grid>
        </Border>
        <ControlTemplate.Triggers>
            <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Check" Property="Visibility" Value="Visible"/>
            </Trigger>
            <Trigger Property="IsHighlighted" Value="True">
                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource Theme.Control.Subtle.Hover}"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource Theme.Control.Subtle.Pressed}"/>
            </Trigger>
            <!-- D-6 "disabled ≠ Opacity": dims via Theme.Text.Disabled (inherited into Check/Header through
                 the outer Style's own IsEnabled=False Foreground Setter below) plus this one explicit
                 Setter for Gesture, which pins its OWN Foreground and would otherwise not inherit it. -->
            <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Gesture" Property="Foreground" Value="{DynamicResource Theme.Text.Disabled}"/>
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <!-- TopLevelHeader/SubmenuHeader role: the SAME row as ItemTemplate above, plus a trailing submenu
         caret instead of InputGestureText, and this MenuItem's OWN Popup/SubmenuBorder (the H-1 fix — see
         this dictionary's own remarks above the two templates). -->
    <ControlTemplate x:Key="Theme.MenuItem.HeaderTemplate" TargetType="MenuItem">
        <Grid>
            <Border x:Name="Bg"
                    Background="{TemplateBinding Background}"
                    CornerRadius="{DynamicResource Theme.Radius.Control}"
                    Padding="{TemplateBinding Padding}"
                    MinHeight="{DynamicResource Theme.MenuItem.MinHeight}"
                    SnapsToDevicePixels="True">
                <Grid VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="24"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="Check" Grid.Column="0"
                               Text="{StaticResource Icon.Glyph.Checkmark}"
                               FontFamily="Segoe MDL2 Assets, Segoe Fluent Icons"
                               VerticalAlignment="Center"
                               Visibility="Collapsed"/>
                    <ContentPresenter Grid.Column="1" ContentSource="Header" RecognizesAccessKey="True"
                                       VerticalAlignment="Center" Margin="4,0,16,0"/>
                    <TextBlock Grid.Column="2"
                               Text="{StaticResource Icon.Glyph.SubmenuArrow}"
                               FontFamily="Segoe MDL2 Assets, Segoe Fluent Icons"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource Theme.Text.Secondary}"/>
                </Grid>
            </Border>
            <Popup x:Name="PART_Popup"
                   Placement="Right"
                   HorizontalOffset="-4"
                   VerticalOffset="-6"
                   IsOpen="{Binding IsSubmenuOpen, RelativeSource={RelativeSource TemplatedParent}}"
                   AllowsTransparency="True"
                   Focusable="False"
                   PopupAnimation="{DynamicResource {x:Static SystemParameters.MenuPopupAnimationKey}}">
                <Border x:Name="SubmenuBorder"
                        Background="{DynamicResource Theme.Surface.Flyout}"
                        BorderBrush="{DynamicResource Theme.Stroke.Card}"
                        BorderThickness="1"
                        CornerRadius="{DynamicResource Theme.Radius.Popup}"
                        Padding="2"
                        SnapsToDevicePixels="True">
                    <ScrollViewer CanContentScroll="True">
                        <ItemsPresenter Grid.IsSharedSizeScope="True" SnapsToDevicePixels="True"/>
                    </ScrollViewer>
                </Border>
            </Popup>
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Check" Property="Visibility" Value="Visible"/>
            </Trigger>
            <Trigger Property="IsHighlighted" Value="True">
                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource Theme.Control.Subtle.Hover}"/>
            </Trigger>
            <Trigger Property="IsSubmenuOpen" Value="True">
                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource Theme.Control.Subtle.Hover}"/>
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <!-- The single style every Theme.* menu consumer applies to EVERY MenuItem inside its own ContextMenu
         (via an implicit, BasedOn={StaticResource Theme.MenuItem} Style keyed by typeof(MenuItem) in that
         ContextMenu's own Resources — the same pattern ChildWindow.xaml's HeaderContextMenu already uses
         for Control.MenuItem, since ItemContainerStyle has no effect on MenuItems already declared literally
         in XAML, only on data-bound, container-generated ones). -->
    <Style x:Key="Theme.MenuItem" TargetType="MenuItem">
        <Setter Property="Foreground" Value="{DynamicResource Theme.Text.Primary}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="FontSize" Value="{DynamicResource Font.Size.Caption}"/>
        <Setter Property="Padding" Value="{DynamicResource Theme.MenuItem.Padding}"/>
        <Setter Property="Template" Value="{StaticResource Theme.MenuItem.ItemTemplate}"/>
        <Style.Triggers>
            <Trigger Property="Role" Value="TopLevelHeader">
                <Setter Property="Template" Value="{StaticResource Theme.MenuItem.HeaderTemplate}"/>
            </Trigger>
            <Trigger Property="Role" Value="TopLevelItem">
                <Setter Property="Template" Value="{StaticResource Theme.MenuItem.ItemTemplate}"/>
            </Trigger>
            <Trigger Property="Role" Value="SubmenuHeader">
                <Setter Property="Template" Value="{StaticResource Theme.MenuItem.HeaderTemplate}"/>
            </Trigger>
            <Trigger Property="Role" Value="SubmenuItem">
                <Setter Property="Template" Value="{StaticResource Theme.MenuItem.ItemTemplate}"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="{DynamicResource Theme.Text.Disabled}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Group-header fallback (§2.5 catalog): a Focusable=False, IsHitTestVisible=False MenuItem used as a
         plain section label (e.g. "Содержимое"/"Упорядочить значки" in the panel header menu) — used only
         if fences-ux-parity-reviewer rejects 6.2c's radio-group-to-submenu conversion (§2.6 item 3's
         documented fallback); NOT wired into any menu by 6.2a itself. Unlike the pre-6.1
         IsEnabled=False-as-group-header anti-pattern (ChromeContrastAuditTests'
         SettingsMenuGroupHeaders_AreDisabledMenuItemsWithNoOwnForegroundOverride, ≈ 3.0:1), this stays fully
         enabled/legible (Theme.Text.Secondary ≥ 4.5:1) and is merely inert to input.
    -->
    <Style x:Key="Theme.MenuItem.GroupHeader" TargetType="MenuItem" BasedOn="{StaticResource Theme.MenuItem}">
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="IsHitTestVisible" Value="False"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource Theme.Text.Secondary}"/>
    </Style>

    <Style x:Key="Theme.Separator" TargetType="Separator">
        <Setter Property="Background" Value="{DynamicResource Theme.Stroke.Divider}"/>
        <Setter Property="Margin" Value="4"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Separator">
                    <Border Height="1" Background="{TemplateBinding Background}"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Theme.ContextMenu" TargetType="ContextMenu">
        <Setter Property="Background" Value="{DynamicResource Theme.Surface.Flyout}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Theme.Stroke.Card}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="4"/>
        <Setter Property="HasDropShadow" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContextMenu">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{DynamicResource Theme.Radius.Popup}"
                            Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <ScrollViewer CanContentScroll="True">
                            <ItemsPresenter/>
                        </ScrollViewer>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Theme.Popup.Chrome replaces Control.Popup.Chrome above for the panel header's own hint popups
         (MoveHintPopup/RenameErrorPopup, ChildWindow.xaml — migrated in 6.2c) plus any future Palette T
         non-blocking hint popup: same shape (Border, hairline stroke, popup radius), but on Theme.Surface.
         Flyout/Theme.Stroke.Card so it stays visually consistent with Theme.ContextMenu/Theme.ToolTip in
         both Light and Dark, rather than pinned to the always-dark Brush.Surface.Elevated. -->
    <Style x:Key="Theme.Popup.Chrome" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Theme.Surface.Flyout}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Theme.Stroke.Card}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="{DynamicResource Theme.Radius.Popup}"/>
        <Setter Property="Padding" Value="10,7"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
    </Style>

    <!-- Theme.ToolTip: the ONE implicit (un-keyed, TargetType-only) style in this whole design system —
         deliberately app-wide (§2.5 catalog: "единственный неявный стиль, который достаётся и панелям
         безопасно"), since a ToolTip is always its own separate Popup-hosted visual tree regardless of
         which window/panel raised it, so there is no risk of it "leaking" into a panel's OWN chrome the
         way Theme.Implicit.xaml's Button/TextBox/etc. styles would. -->
    <Style TargetType="{x:Type ToolTip}">
        <Setter Property="Background" Value="{DynamicResource Theme.Surface.Flyout}"/>
        <Setter Property="Foreground" Value="{DynamicResource Theme.Text.Primary}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Theme.Stroke.Card}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="8,4"/>
        <Setter Property="FontSize" Value="{DynamicResource Font.Size.Caption}"/>
        <Setter Property="HasDropShadow" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToolTip">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{DynamicResource Theme.Radius.Control}"
                            Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter Margin="0"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        Edit Layout resize handle (docs/PLANS/phase-6-edit-layout-ux.md §1 D-6, R-5). ChildWindow.xaml's 8
        ResizeOverlay Thumbs reference THIS style — per R-5, the Style attribute value was the ONLY
        change made to that XAML region when it was introduced (P6-4, replacing the now-removed
        ResizeThumbStyle, which every ResizeOverlay Thumb used before this style existed); the
        ResizeOverlay Grid's ColumnDefinition/RowDefinition geometry (6/*/6), and every Thumb's
        Tag/Cursor/DragStarted/DragDelta/DragCompleted wiring, stay byte-for-byte — this Style changes
        ONLY the ControlTemplate (visual), never hit-test geometry.

        Default appearance (Normal mode, or Edit Layout before the trigger below applies) is pixel-identical
        to the plain Border-filling-the-Thumb template ResizeThumbStyle used to provide: a Transparent
        (but still hit-testable) Background — same 6px-square hit region either way. A Style.Trigger on
        the inherited theming:PanelTheme.IsLayoutEditing attached property (Theming/PanelTheme.cs) then
        swaps in a visible, accent-tinted grip while editing — the property flows to these Thumbs
        directly via normal WPF inheritance (they are descendants of PanelRoot, not across a
        ContextMenu/Popup boundary — the R-6 trap documented on PanelTheme only applies there — which is
        why PanelTheme's inherited attached properties reach them). Accent colour comes from the SAME
        {Binding Path=(theming:PanelTheme.Accent), RelativeSource={RelativeSource Self}} pattern
        Panels.xaml's PanelItemContainerStyle (SelectionBorder) already uses — never a hex literal
        (DoD-10).
    -->
    <Style x:Key="ResizeHandleStyle" TargetType="Thumb">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border x:Name="HandleChrome"
                            Background="{TemplateBinding Background}"
                            CornerRadius="{StaticResource Radius.Control}"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="theming:PanelTheme.IsLayoutEditing" Value="True">
                <Setter Property="Background">
                    <Setter.Value>
                        <Binding Path="(theming:PanelTheme.Accent)" RelativeSource="{RelativeSource Self}"/>
                    </Setter.Value>
                </Setter>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!--
        Shared chrome for the three panel title-bar buttons (Sort/View/RollUp — ui-polishing-1 §4.3).
        Relocated from Templates.xaml (C5, D-2); retokenized (Foreground #AAAAAA -> Brush.Text.Secondary,
        hover wash #1AFFFFFF -> Brush.Overlay.Hover, CornerRadius 3 -> Radius.Control) with zero visual
        change — every token below carries the exact same colour/geometry the literal it replaces did.
    -->
    <Style x:Key="PanelHeaderButtonStyle" TargetType="Button">
        <Setter Property="Width" Value="{x:Static models:PanelMetrics.HeaderButtonSize}"/>
        <Setter Property="Height" Value="{x:Static models:PanelMetrics.HeaderButtonSize}"/>
        <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Foreground">
            <Setter.Value>
                <MultiBinding Converter="{StaticResource PanelChromeForegroundBrush}" ConverterParameter="Secondary">
                    <Binding Path="(theming:PanelTheme.Accent)" RelativeSource="{RelativeSource Self}"/>
                    <Binding Path="(theming:PanelTheme.Text)" RelativeSource="{RelativeSource Self}"/>
                    <Binding Source="{x:Static theming:HighContrastState.IsActive}"/>
                    <Binding Source="{StaticResource Brush.Text.Secondary}"/>
                </MultiBinding>
            </Setter.Value>
        </Setter>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="HeaderButtonBorder"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{StaticResource Radius.Control}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <!-- MAJOR-3 fix: direction-aware hover wash — see this dictionary's own
                             HoverOverlayBrush registration comment (top of file). -->
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="HeaderButtonBorder" Property="Background">
                                <Setter.Value>
                                    <!-- MAJOR-2 fix: PanelTheme.Accent/Text (Brushes), not Model.AccentColor/
                                         TextColor directly — see this dictionary's own HoverOverlayBrush
                                         registration comment (top of file). -->
                                    <MultiBinding Converter="{StaticResource HoverOverlayBrush}">
                                        <Binding Path="(theming:PanelTheme.Accent)" RelativeSource="{RelativeSource Self}"/>
                                        <Binding Path="(theming:PanelTheme.SurfaceStyle)" RelativeSource="{RelativeSource Self}"/>
                                        <Binding Path="(theming:PanelTheme.Text)" RelativeSource="{RelativeSource Self}"/>
                                        <Binding Source="{x:Static theming:HighContrastState.IsActive}"/>
                                        <Binding Source="{StaticResource Brush.Overlay.Hover}"/>
                                    </MultiBinding>
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        Sort button only (ui-polishing-1 §4.3): highlighted whenever ChildWindowViewModel.IsSortedByName
        is true, using the exact same SelectionFillBrush/SelectionStrokeBrush tokens as
        PanelItemContainerStyle's SelectionBorder used before C5 (finalization MINOR m-1's shared
        "selected/active" visual language — Panels.xaml's PanelItemContainerStyle moves to an
        accent-based selection fill in C5 per the icon-tiles spec, but this button intentionally keeps
        the fixed-blue tokens: it signals "sort is active", not the panel's own semantic accent
        identity). A plain Button (not ToggleButton) is used deliberately: ToggleButton drives its own
        IsChecked locally on click, which would fight the OneWay-in-effect binding here in the Folder
        Portal edge case (the command is disabled but the highlight must still reflect the forced Name
        mode).

        Relocated from Templates.xaml (C5, D-2); retokenized (Foreground #FFFFFF -> Brush.Text.Primary,
        hover wash #1AFFFFFF -> Brush.Overlay.Hover). Foreground #FFFFFF -> Brush.Text.Primary (#DDDDDD)
        is this style's one deliberate (not purely mechanical) colour choice in C5: it is a few percent
        darker than pure white, but it is the same "primary readable text" token every other panel
        surface in the app already uses, which is what the phase's "same appearance for Grid/List/
        Portal/SystemIcons" DoD asks for — a sidebar-only pixel-exact clone would have worked against
        that goal for no functional benefit.

        Re-declares Template (rather than just adding a Style.Triggers DataTrigger, which is all the
        Background/BorderBrush Setters below would need on their own) purely to append the
        MultiDataTrigger at the bottom of ControlTemplate.Triggers (finalization MINOR m-6): the
        inherited PanelHeaderButtonStyle's own IsMouseOver trigger sets HeaderButtonBorder.Background
        directly by TargetName, which — as a template trigger — takes precedence over anything the
        Background/BorderBrush Setters above (a plain Style trigger) can express on the Button element
        itself. Without a same-precedence-tier trigger of its own, hovering the sort button would always
        blank its active highlight back to the plain hover tint, active or not. The MultiDataTrigger is
        declared last in the same ControlTemplate.Triggers collection specifically so it wins the
        same-tier "last declared wins" tie-break against the inherited IsMouseOver trigger whenever both
        conditions hold — the plain hover-only case (unsorted button) is untouched, still handled by
        that first trigger alone.

        ⚠️ The order of ControlTemplate.Triggers below (plain hover, then IsEnabled, then the
        MultiDataTrigger last) is preserved verbatim from Templates.xaml — do not reorder it; the
        "last declared wins" tie-break this comment describes depends on it.
    -->
    <Style x:Key="PanelHeaderToggleButtonStyle" TargetType="Button" BasedOn="{StaticResource PanelHeaderButtonStyle}">
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsSortedByName}" Value="True">
                <Setter Property="Background" Value="{StaticResource SelectionFillBrush}"/>
                <Setter Property="BorderBrush" Value="{StaticResource SelectionStrokeBrush}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <!-- MAJOR-2 fix (review round 3): was Brush.Text.Primary — a foreground unpaired with
                     the SelectionFillBrush background above. In Colors.HighContrast.xaml,
                     Color.Selection.Fill maps to SystemColors.HighlightColor while Color.Text.Primary
                     maps to SystemColors.WindowTextColor, an independent (and in both shipped HC themes,
                     same-tone) pairing — SelectionTextBrush is the paired token instead (see Colors.xaml's
                     Color.Selection.Text remarks), with zero visual change in normal mode (#DDDDDD both
                     ways). -->
                <Setter Property="Foreground" Value="{StaticResource SelectionTextBrush}"/>
            </DataTrigger>
        </Style.Triggers>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="HeaderButtonBorder"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{StaticResource Radius.Control}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <!-- (a) Plain hover for a NOT currently sorted-by-name button — same
                             direction-aware hover wash as PanelHeaderButtonStyle (MAJOR-3 fix,
                             docs/PLANS/workspace-grid-07-visual.md fix-cycle 1; no longer byte-for-byte
                             "unchanged" the way this comment used to say, since that fix touches this
                             trigger too). -->
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="HeaderButtonBorder" Property="Background">
                                <Setter.Value>
                                    <!-- MAJOR-2 fix: PanelTheme.Accent/Text (Brushes), not Model.AccentColor/
                                         TextColor directly — see this dictionary's own HoverOverlayBrush
                                         registration comment (top of file). -->
                                    <MultiBinding Converter="{StaticResource HoverOverlayBrush}">
                                        <Binding Path="(theming:PanelTheme.Accent)" RelativeSource="{RelativeSource Self}"/>
                                        <Binding Path="(theming:PanelTheme.SurfaceStyle)" RelativeSource="{RelativeSource Self}"/>
                                        <Binding Path="(theming:PanelTheme.Text)" RelativeSource="{RelativeSource Self}"/>
                                        <Binding Source="{x:Static theming:HighContrastState.IsActive}"/>
                                        <Binding Source="{StaticResource Brush.Overlay.Hover}"/>
                                    </MultiBinding>
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5"/>
                        </Trigger>
                        <!-- (b) Hover OVER an already-active (sorted-by-name) button: re-assert the
                             active highlight so it survives hover instead of being blanked by (a) above
                             — see this Style's remarks (finalization MINOR m-6). -->
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=IsMouseOver}" Value="True"/>
                                <Condition Binding="{Binding IsSortedByName}" Value="True"/>
                            </MultiDataTrigger.Conditions>
                            <Setter TargetName="HeaderButtonBorder" Property="Background" Value="{StaticResource SelectionFillBrush}"/>
                            <Setter TargetName="HeaderButtonBorder" Property="BorderBrush" Value="{StaticResource SelectionStrokeBrush}"/>
                        </MultiDataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        Overlay scrollbar (docs/prompts/scrollbar-pack, spec 04): the three styles below replace ONLY the
        visual template of the stock WPF ScrollBar -> Track -> Thumb/RepeatButton chain. The scrolling
        mechanics are untouched: PART_Track is a real Track (page-scroll semantics via the two
        RepeatButtons' ScrollBar.Page*Command, drag via Thumb), the ScrollViewer <-> ScrollBar binding is
        the ScrollViewer's own default template's, and nothing here computes an offset by hand. No
        DropShadowEffect/BlurEffect/ShaderEffect, no animation, no code-behind — hover/pressed are
        ControlTemplate.Triggers over the frozen Brush.ScrollBar.* tokens (Brushes.xaml). All geometry
        comes from Spacing.xaml's ScrollBar.* tokens.

        Applied as an IMPLICIT style (x:Key = {x:Type ScrollBar}, BasedOn this one) from
        ChildWindow.xaml's PanelRoot and SystemIconsPanelWindow.xaml's root Border, which is how it reaches
        the ScrollBar the ListBox's default ControlTemplate's ScrollViewer creates for ListViewTemplate/
        GridViewTemplate (Templates.xaml) and the sidebar's IconsListBox: ScrollBar is a Control, and WPF
        looks an implicit Control style up across template boundaries, so a Window-scoped style is found
        from inside the ListBox's and ScrollViewer's own templates. Deliberately NOT declared as an
        app-wide implicit style here — MainWindow.xaml (the light, system-styled Settings window, D-9) and
        its ComboBox/ContextMenu drop-downs must keep the system scrollbar.

        Orientation: the vertical template is the deliverable; the Orientation="Horizontal" trigger swaps in
        a mirrored template so a horizontal bar can never fall through to a vertical Track (every panel
        ListBox sets HorizontalScrollBarVisibility="Disabled", so it is unreachable today, but the implicit
        style would otherwise be a latent bug for the first template that enables it).
    -->

    <!-- Track "page up/down" buttons: functional (Track needs them for page scrolling semantics), but
         no chrome at all — a Transparent-brush Border is still hit-testable, so clicking the empty track
         above/below the thumb pages exactly as the stock bar does, with no glyph/arrow anywhere. -->
    <Style x:Key="Control.ScrollBar.TrackButton" TargetType="RepeatButton">
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Border Background="{TemplateBinding Background}"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        Thumb = capsule. The Thumb element itself fills the whole track width (the Track arranges it that
        way) and stays the hit/drag target; the visible pill is the inner Border, inset by
        Thumb.Padding — the ScrollBar templates below pass ScrollBar.ThumbInset.Vertical/Horizontal so
        the pill is ScrollBar.ThumbThickness (8) wide inside the ScrollBar.Width (14) track.
        Radius.ScrollBarThumb (4) = half the pill width -> true capsule ends. Hover/dragging only lighten
        the fill (Brush.ScrollBar.ThumbHover/ThumbPressed step alpha up, same hue); IsDragging is declared
        AFTER IsMouseOver so it wins the same-tier tie-break while both hold.
    -->
    <Style x:Key="Control.ScrollBar.Thumb" TargetType="Thumb">
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <!-- WP-B "ADDITIONAL" (docs/PLANS/color-presets-and-size-step.md): luminance-adaptive, same rule
             as the header icon buttons above — see PanelChromeForegroundPolicy's own remarks. -->
        <Setter Property="Background">
            <Setter.Value>
                <MultiBinding Converter="{StaticResource PanelChromeForegroundBrush}" ConverterParameter="ScrollBarThumb">
                    <Binding Path="(theming:PanelTheme.Accent)" RelativeSource="{RelativeSource Self}"/>
                    <Binding Path="(theming:PanelTheme.Text)" RelativeSource="{RelativeSource Self}"/>
                    <Binding Source="{x:Static theming:HighContrastState.IsActive}"/>
                    <Binding Source="{StaticResource Brush.ScrollBar.Thumb}"/>
                </MultiBinding>
            </Setter.Value>
        </Setter>
        <Setter Property="BorderBrush">
            <Setter.Value>
                <MultiBinding Converter="{StaticResource PanelChromeForegroundBrush}" ConverterParameter="ScrollBarThumbBorder">
                    <Binding Path="(theming:PanelTheme.Accent)" RelativeSource="{RelativeSource Self}"/>
                    <Binding Path="(theming:PanelTheme.Text)" RelativeSource="{RelativeSource Self}"/>
                    <Binding Source="{x:Static theming:HighContrastState.IsActive}"/>
                    <Binding Source="{StaticResource Brush.ScrollBar.ThumbBorder}"/>
                </MultiBinding>
            </Setter.Value>
        </Setter>
        <Setter Property="BorderThickness" Value="{StaticResource Thickness.Hairline}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Grid Background="Transparent">
                        <Border x:Name="Pill"
                                Margin="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{StaticResource Radius.ScrollBarThumb}"
                                SnapsToDevicePixels="True"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Pill" Property="Background">
                                <Setter.Value>
                                    <MultiBinding Converter="{StaticResource PanelChromeForegroundBrush}" ConverterParameter="ScrollBarThumbHover">
                                        <Binding Path="(theming:PanelTheme.Accent)" RelativeSource="{RelativeSource TemplatedParent}"/>
                                        <Binding Path="(theming:PanelTheme.Text)" RelativeSource="{RelativeSource TemplatedParent}"/>
                                        <Binding Source="{x:Static theming:HighContrastState.IsActive}"/>
                                        <Binding Source="{StaticResource Brush.ScrollBar.ThumbHover}"/>
                                    </MultiBinding>
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                        <Trigger Property="IsDragging" Value="True">
                            <Setter TargetName="Pill" Property="Background">
                                <Setter.Value>
                                    <MultiBinding Converter="{StaticResource PanelChromeForegroundBrush}" ConverterParameter="ScrollBarThumbPressed">
                                        <Binding Path="(theming:PanelTheme.Accent)" RelativeSource="{RelativeSource TemplatedParent}"/>
                                        <Binding Path="(theming:PanelTheme.Text)" RelativeSource="{RelativeSource TemplatedParent}"/>
                                        <Binding Source="{x:Static theming:HighContrastState.IsActive}"/>
                                        <Binding Source="{StaticResource Brush.ScrollBar.ThumbPressed}"/>
                                    </MultiBinding>
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        The ScrollBar itself. Width/MinWidth = ScrollBar.Width (14) is the whole footprint the
        ScrollViewer's Auto column reserves — no arrows, no track border, no extra padding.
        Track.IsEnabled="{TemplateBinding IsMouseOver}" is copied from the stock Aero template: it stops
        the page RepeatButtons auto-repeating once the pointer leaves the bar (a disabled Track still
        renders its Thumb normally — the Thumb style above has no IsEnabled trigger, on purpose; the
        DISABLED look is the ScrollBar-level Opacity trigger at the bottom, keyed off the ScrollBar's own
        IsEnabled, which the ScrollViewer sets when there is nothing to scroll).

        ControlTemplate.Resources publishes 2 x ScrollBar.ThumbMinLength (72) under
        SystemParameters.VerticalScrollBarButtonHeightKey (HorizontalScrollBarButtonWidthKey for the
        mirrored template): WPF's Track derives its minimum thumb length as floor(0.5 x that resource)
        — see Spacing.xaml's remarks — so this is what makes the Track's arrange/drag math agree with the
        Thumb's MinHeight/MinWidth (ScrollBar.ThumbMinLength = 36) instead of arranging a shorter slot
        under a taller pill.
    -->
    <Style x:Key="Control.ScrollBar.Overlay" TargetType="ScrollBar">
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="Background" Value="{StaticResource Brush.ScrollBar.Track}"/>
        <Setter Property="BorderThickness" Value="{StaticResource Thickness.None}"/>
        <Setter Property="Width" Value="{StaticResource ScrollBar.Width}"/>
        <Setter Property="MinWidth" Value="{StaticResource ScrollBar.Width}"/>
        <Setter Property="Height" Value="Auto"/>
        <Setter Property="MinHeight" Value="0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <ControlTemplate.Resources>
                        <!-- A plain literal, not a StaticResource alias of a Spacing.xaml token: a StaticResource entry keyed by
                             x:Static is rejected inside compiled (BAML) template resources ("Missing key value on
                             StaticResourceHolder"). MUST equal 2 x ScrollBar.ThumbMinLength (Spacing.xaml) — pinned by
                             OverlayScrollBarStyleTests via the real Track arrange (thumb == ThumbMinLength AND the two
                             RepeatButtons + Thumb tile the full track), which fails the moment the two drift apart. -->
                        <sys:Double x:Key="{x:Static SystemParameters.VerticalScrollBarButtonHeightKey}">72</sys:Double>
                    </ControlTemplate.Resources>
                    <Border Background="{TemplateBinding Background}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            SnapsToDevicePixels="True">
                        <Track x:Name="PART_Track" IsDirectionReversed="True" IsEnabled="{TemplateBinding IsMouseOver}">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Style="{StaticResource Control.ScrollBar.TrackButton}" Command="{x:Static ScrollBar.PageUpCommand}"/>
                            </Track.DecreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Style="{StaticResource Control.ScrollBar.Thumb}"
                                       Padding="{StaticResource ScrollBar.ThumbInset.Vertical}"
                                       MinHeight="{StaticResource ScrollBar.ThumbMinLength}"/>
                            </Track.Thumb>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Style="{StaticResource Control.ScrollBar.TrackButton}" Command="{x:Static ScrollBar.PageDownCommand}"/>
                            </Track.IncreaseRepeatButton>
                        </Track>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Width" Value="Auto"/>
                <Setter Property="MinWidth" Value="0"/>
                <Setter Property="Height" Value="{StaticResource ScrollBar.Width}"/>
                <Setter Property="MinHeight" Value="{StaticResource ScrollBar.Width}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ScrollBar">
                            <ControlTemplate.Resources>
                                <!-- A plain literal, not a StaticResource alias of a Spacing.xaml token: a StaticResource entry keyed by
                                     x:Static is rejected inside compiled (BAML) template resources ("Missing key value on
                                     StaticResourceHolder"). MUST equal 2 x ScrollBar.ThumbMinLength (Spacing.xaml) — pinned by
                                     OverlayScrollBarStyleTests via the real Track arrange (thumb == ThumbMinLength AND the two
                                     RepeatButtons + Thumb tile the full track), which fails the moment the two drift apart. -->
                                <sys:Double x:Key="{x:Static SystemParameters.HorizontalScrollBarButtonWidthKey}">72</sys:Double>
                            </ControlTemplate.Resources>
                            <Border Background="{TemplateBinding Background}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    SnapsToDevicePixels="True">
                                <Track x:Name="PART_Track" IsDirectionReversed="False" IsEnabled="{TemplateBinding IsMouseOver}">
                                    <Track.DecreaseRepeatButton>
                                        <RepeatButton Style="{StaticResource Control.ScrollBar.TrackButton}" Command="{x:Static ScrollBar.PageLeftCommand}"/>
                                    </Track.DecreaseRepeatButton>
                                    <Track.Thumb>
                                        <Thumb Style="{StaticResource Control.ScrollBar.Thumb}"
                                               Padding="{StaticResource ScrollBar.ThumbInset.Horizontal}"
                                               MinWidth="{StaticResource ScrollBar.ThumbMinLength}"/>
                                    </Track.Thumb>
                                    <Track.IncreaseRepeatButton>
                                        <RepeatButton Style="{StaticResource Control.ScrollBar.TrackButton}" Command="{x:Static ScrollBar.PageRightCommand}"/>
                                    </Track.IncreaseRepeatButton>
                                </Track>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="{StaticResource ScrollBar.DisabledOpacity}"/>
            </Trigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>
