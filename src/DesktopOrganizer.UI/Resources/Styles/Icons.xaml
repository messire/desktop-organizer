<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">
    <!--
        Ambient Accent Visual System — Segoe MDL2 Assets glyph tokens (D-1). Every codepoint below is
        copied verbatim from an existing consumer — reused, not invented — so migrating that consumer
        onto the token later is a pure rename with zero visual change:
          - Icon.Glyph.Sort        <- ChildWindow.xaml, SortModeToggleButton Content="&#xE8CB;"
          - Icon.Glyph.ViewGrid    <- Converters/ViewModeGlyphConverter.cs GridTargetGlyph (U+E8A9)
          - Icon.Glyph.ViewList    <- Converters/ViewModeGlyphConverter.cs ListTargetGlyph (U+E8FD)
          - Icon.Glyph.ChevronDown <- Converters/BoolToGlyphConverter.cs (U+E70D)
          - Icon.Glyph.ChevronUp   <- Converters/BoolToGlyphConverter.cs (U+E70E)
          - Icon.Glyph.Overflow    <- new in C6 (U+E712, the standard Segoe MDL2 "More"/overflow glyph;
                                      no prior consumer to copy from — the header overflow button below
                                      is its first).
          - Icon.Glyph.Checkmark   <- new in WP-B (docs/PLANS/color-presets-and-size-step.md §4.2, U+E73E,
                                      the standard Segoe MDL2 "CheckMark" glyph) — PanelColorEditor's
                                      selected-preset indicator; no prior consumer.
          - Icon.Glyph.RollUp      <- release-polish-1.0 review round M4: PanelPreviewCard's own static
                                      header row needs a fourth glyph alongside Sort/View/Overflow (the
                                      real ChildWindow.xaml header has FOUR buttons — Sort, View, RollUp,
                                      Overflow — the preview was missing the third). Byte-identical to
                                      Icon.Glyph.ChevronUp (U+E70E) — the SAME codepoint
                                      Converters/BoolToGlyphConverter.cs's RollUpGlyph renders for a panel
                                      that is NOT currently rolled up (the default/preview state).
          - Icon.Glyph.SubmenuArrow <- design-system-1x.md §2.6 phase 6.2a (U+E76C, the standard Segoe
                                      MDL2 "ChevronRight"/submenu-caret glyph) — Theme.MenuItem's
                                      SubmenuHeader/TopLevelHeader templates (Resources/Styles/Controls.xaml).
          - Icon.Glyph.Close        <- design-system-1x.md §2.5 phase 6.2a (U+E711, the standard Segoe
                                      MDL2 "Cancel"/close glyph) — Controls/InfoBar.cs's dismiss button.

        The FontFamily string itself ("Segoe MDL2 Assets") stays a literal Setter in Controls.xaml /
        Templates.xaml, not here — this dictionary is <sys:String> codepoints only, per D-1.
    -->
    <sys:String x:Key="Icon.Glyph.Sort">&#xE8CB;</sys:String>
    <sys:String x:Key="Icon.Glyph.ViewGrid">&#xE8A9;</sys:String>
    <sys:String x:Key="Icon.Glyph.ViewList">&#xE8FD;</sys:String>
    <sys:String x:Key="Icon.Glyph.ChevronDown">&#xE70D;</sys:String>
    <sys:String x:Key="Icon.Glyph.ChevronUp">&#xE70E;</sys:String>
    <sys:String x:Key="Icon.Glyph.Overflow">&#xE712;</sys:String>
    <sys:String x:Key="Icon.Glyph.Checkmark">&#xE73E;</sys:String>
    <sys:String x:Key="Icon.Glyph.RollUp">&#xE70E;</sys:String>
    <sys:String x:Key="Icon.Glyph.SubmenuArrow">&#xE76C;</sys:String>
    <sys:String x:Key="Icon.Glyph.Close">&#xE711;</sys:String>

    <!-- ADR-042: PanelColorEditor's swatch grid "Custom…" cell (a dashed ring + "+" glyph) — the standard
         Segoe MDL2 "Add" glyph (U+E710), no prior consumer to copy from. -->
    <sys:String x:Key="Icon.Glyph.Add">&#xE710;</sys:String>

    <!-- Phase 6.3 (design-system-1x.md §2.8, ADR-047 D-9): AppDialogWindow's severity glyphs — the
         standard Segoe MDL2/Fluent codepoints for each MessageBoxImage this dialog can show (no prior
         consumer to copy from; MessageBoxImage.None hides the glyph entirely, see AppDialogWindow.xaml.cs). -->
    <sys:String x:Key="Icon.Glyph.Info">&#xE946;</sys:String>
    <sys:String x:Key="Icon.Glyph.Warning">&#xE7BA;</sys:String>
    <sys:String x:Key="Icon.Glyph.Error">&#xEA39;</sys:String>
    <sys:String x:Key="Icon.Glyph.Question">&#xE9CE;</sys:String>

    <!-- Design system 1.x wave-4 review (Theme.Controls.xaml's InfoBar template): the one severity
         AppDialogWindow's own set above has no counterpart for — the standard Segoe MDL2/Fluent
         "Completed" glyph (U+E930, a checkmark-in-circle), reused for InfoBarSeverity.Success. -->
    <sys:String x:Key="Icon.Glyph.Success">&#xE930;</sys:String>
</ResourceDictionary>
