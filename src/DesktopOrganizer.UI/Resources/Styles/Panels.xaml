<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="clr-namespace:DesktopOrganizer.UI.Controls"
                    xmlns:models="clr-namespace:DesktopOrganizer.UI.Models"
                    xmlns:conv="clr-namespace:DesktopOrganizer.UI.Converters"
                    xmlns:theming="clr-namespace:DesktopOrganizer.UI.Theming">
    <!--
        Ambient Accent Visual System — PanelChrome default style (D-8, docs/PLANS/phase-5-ambient-accent-ui.md
        §1 D-8, §5.3/§5.4/§5.6 of the phase spec). Controls/PanelChrome.cs's static constructor points
        DefaultStyleKeyProperty at typeof(PanelChrome), which WPF resolves against Application.Resources —
        built from every dictionary in App.xaml's MergedDictionaries — so this Style (an implicit
        TargetType style, keyed by the type itself) is found without a Themes/Generic.xaml.

        The four Ambient-Accent converters below are registered HERE, not in Templates.xaml (which — per
        D-2 — keeps registering the converters ITS OWN remaining content, FileContextMenu/ListViewTemplate/
        GridViewTemplate/FileNameTextStyle/FileNameEditBoxStyle, needs): Templates.xaml is merged AFTER
        this dictionary (Colors -> [Colors.HighContrast] -> Spacing -> Brushes -> Typography -> Icons ->
        Controls -> Panels -> Templates, built in App.xaml.cs's LoadResourceDictionaries()), so a
        StaticResource reference in THIS file's own ControlTemplate could never resolve a key defined in
        Templates.xaml (D-1's "backwards only" merge-order rule). Declaring them here, right
        next to their only consumer so far, keeps the dependency direction correct; nothing stops a later
        commit (SystemIconsPanelWindow.xaml/MainWindow.xaml, C5-C7) from referencing them too, since by the
        time any Window-level XAML resolves a StaticResource, ALL of App.xaml's MergedDictionaries —
        Panels.xaml included — are already fully merged into the flat Application.Resources.
    -->
    <conv:PanelSurfaceBrushConverter x:Key="PanelSurfaceBrush"/>
    <conv:AccentBrushConverter x:Key="AccentBrush"/>
    <conv:VisualStateToDoubleConverter x:Key="VisualStateToDouble"/>
    <conv:ItemCountToTextConverter x:Key="ItemCountToText"/>
    <conv:AccentIndicatorWidthConverter x:Key="AccentIndicatorWidth"/>

    <!-- docs/PLANS/phase-6-edit-layout-ux.md §1 D-6: edit-aware siblings of VisualStateToDouble/
         AccentIndicatorWidth above — MultiValueConverters over [VisualState, IsLayoutEditing] that
         delegate to LayoutEditVisuals (Theming/LayoutEditVisuals.cs) instead of InteractionVisualState
         directly. LayoutEditVisuals itself returns InteractionVisualState's exact values whenever
         isLayoutEditing is false, so PART_InteractionOverlay/PART_HeaderActions below render
         byte-for-byte as they did in Phase 5 outside Edit Layout mode (their own geometry/brush are
         unchanged by ADR-030); PART_AccentIndicator's underlying NUMBERS follow the identical
         Phase-5-outside-Edit-Layout rule (its opacity/thickness MULTIPLIERS are untouched), but its own
         rendered SHAPE is new — ADR-030 (D-4) replaced the rectangular strip with a curved Path, so
         "byte-for-byte" no longer describes its pixels, only its state-driven math. The original two
         single-value converters above are left untouched (still covered by their own dedicated tests).
         ADR-030 (docs/PLANS/reference-panel-chrome.md §1 D-6) extended EditAwareVisualStateToDouble with
         "glow"/"accentStroke"/"neutralStroke"/"glowFallback" parameter readings, and
         EditAwareAccentIndicatorWidth with a "marker" reading — see those converters' own remarks. -->
    <conv:EditAwareVisualStateToDoubleConverter x:Key="EditAwareVisualStateToDouble"/>
    <conv:EditAwareAccentIndicatorWidthConverter x:Key="EditAwareAccentIndicatorWidth"/>

    <!-- docs/PLANS/workspace-grid-07-visual.md "Border radius": clips content to the exact rounded
         rectangle the chrome's own surface paints — see the converter's own remarks. ADR-030
         (docs/PLANS/reference-panel-chrome.md §1 D-2/D-12) relocated the ONE consumer of this converter
         from PART_Chrome to PART_SurfaceLayer (the layered template's own single clip owner — every
         decorative layer inside it, including PART_Chrome itself, shares this one clip instead of each
         layer clipping itself independently) — see PART_SurfaceLayer's own remarks below for why. -->
    <conv:RoundedRectClipConverter x:Key="RoundedRectClip"/>

    <!-- ADR-030 (docs/PLANS/reference-panel-chrome.md §1 D-4): builds PART_AccentIndicator's curved
         Path.Data from {StaticResource Radius.Panel} — see the converter's own remarks. -->
    <conv:AccentMarkerGeometryConverter x:Key="AccentMarkerGeometry"/>

    <Style TargetType="{x:Type controls:PanelChrome}">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:PanelChrome}">
                    <!--
                        ADR-030 "Reference-Style Layered Panel Chrome" (docs/PLANS/reference-panel-chrome.md
                        §3) — layered template, bottom to top:
                          0. PART_HitCatcher     — spans the WHOLE window rect (plan D-5).
                          1. PART_Glow           — shader-based accent glow ring, inset by ChromeOuterInset,
                                                    UNDER PART_SurfaceLayer (plan D-2/D-9/D-10).
                          1'. PART_GlowFallback  — shader-free substitute for PART_Glow, same inset ring
                                                    (minus GlowFallbackRingOffset), Collapsed by default.
                          2. PART_SurfaceLayer   — inset by ChromeOuterInset (2 DIP), single rounded-rect
                             Clip owner, containing (in z-order):
                             a. PART_Chrome            — the panel's actual visible surface; its own inner
                                                         Grid's FIRST row-spanning child is
                                                         PART_SurfaceHighlight, a very weak non-semantic
                                                         top-to-bottom gradient UNDER PART_Header/
                                                         PART_ContentHost (plan D-11).
                             b. PART_NeutralStroke     — 1-DIP neutral rounded-rect ring, OVER PART_Chrome
                                                         (D-1's "budget" table: there is no room for a
                                                         stroke painted UNDER an opaque Solid surface within
                                                         the 2-DIP inset).
                             c. PART_AccentStroke      — thin accent-colored inner ring, same reason.
                             d. PART_AccentIndicator   — the curved accent identity marker, hosted in
                                                         PART_AccentIndicatorHost (a fixed-size overlay,
                                                         plan D-4/D-7).
                             e. PART_InteractionOverlay — unchanged behavior, PART_SurfaceLayer's own
                                                         top-most child (covers the whole surface, including
                                                         while rolled up) instead of the pre-ADR-030 two-row
                                                         Grid's.
                    -->
                    <Grid>
                        <!--
                            PART_HitCatcher (plan D-5). AllowsTransparency="True" (ChildWindow.xaml) is a
                            LAYERED window: the OS routes a mouse-down by the FINAL COMPOSITED PIXEL ALPHA
                            at each screen location, entirely independent of WPF's own hit-test tree. Once
                            the chrome inset makes the outer 2 DIP ring nearly transparent (only a faint
                            glow tail paints there), a click there would be routed straight through to the
                            desktop, bypassing the resize Thumbs (ChildWindow.xaml's ResizeOverlay, a
                            SIBLING of this control) entirely — the very risk ADR-025 MAJOR-1 already
                            documented for the panel's rounded corners. This Border spans the WHOLE window
                            rect (no Margin) with a near-invisible (alpha=1/255) but OPAQUE fill, so the OS
                            always routes the click to this window; IsHitTestVisible="False" keeps it out of
                            WPF's OWN hit-test tree, so routing within this window still falls through to
                            whichever WPF element (a Thumb, a header button) actually sits at that point.
                        -->
                        <Border x:Name="PART_HitCatcher"
                                Background="{StaticResource Brush.HitTest.Catcher}"
                                IsHitTestVisible="False"/>

                        <!--
                            PART_Glow (plan D-2/D-9/D-10) — the shader-based accent glow. An empty ring
                            (Border, BorderThickness = hairline, no children/Background — the
                            DropShadowEffect below is what actually paints the visible glow, not this
                            Border's own stroke) inset by the SAME ChromeOuterInsetThickness
                            PART_SurfaceLayer uses, so the glow's own un-blurred edge sits exactly at the
                            surface's outer boundary. Exactly ONE Effect on the whole control (T-R6/G-3):
                              - ShadowDepth="0" (a semantic constant — "no offset", not a magic number; the
                                sole literal permitted by G-2b) keeps the shadow centered on the ring rather
                                than cast to one side;
                              - BlurRadius/Opacity are tokens (PanelMetrics.GlowBlurRadius/GlowEffectOpacity,
                                D-10's own residual-alpha-at-the-window-edge model, pinned by
                                PanelMetricsTests);
                              - RenderingBias="Performance" trades a little visual fidelity for the effect's
                                own render cost (plan D-9's performance budget);
                              - Color binds to AccentBrush.Color (TemplatedParent) — AccentBrush is always a
                                real SolidColorBrush from the caching AccentBrushConverter (D-9's own note),
                                so this Freezable-inside-a-Style binding always resolves; T-R6 catches a
                                silent resolution failure by asserting the REAL rendered Color after
                                assigning a known AccentBrush.
                            State-driven expressiveness lives entirely in THIS Border's own
                            UIElement.Opacity (LayeredChromeVisuals.GlowOpacityFor via the "glow" parameter)
                            — the DropShadowEffect's own parameters never change per state, so the effect is
                            never recreated.
                        -->
                        <Border x:Name="PART_Glow"
                                Margin="{x:Static models:PanelMetrics.ChromeOuterInsetThickness}"
                                BorderBrush="{TemplateBinding AccentBrush}"
                                BorderThickness="{StaticResource Thickness.Hairline}"
                                CornerRadius="{StaticResource Radius.Panel}"
                                IsHitTestVisible="False">
                            <Border.Effect>
                                <DropShadowEffect ShadowDepth="0"
                                                   BlurRadius="{x:Static models:PanelMetrics.GlowBlurRadius}"
                                                   Opacity="{x:Static models:PanelMetrics.GlowEffectOpacity}"
                                                   RenderingBias="Performance"
                                                   Color="{Binding AccentBrush.Color, RelativeSource={RelativeSource TemplatedParent}}"/>
                            </Border.Effect>
                            <!-- D-6: MultiBinding over [VisualState, IsLayoutEditing] — see
                                 EditAwareVisualStateToDoubleConverter's remarks above; "glow" reads
                                 LayeredChromeVisuals.GlowOpacityFor. -->
                            <Border.Opacity>
                                <MultiBinding Converter="{StaticResource EditAwareVisualStateToDouble}" ConverterParameter="glow">
                                    <Binding Path="VisualState" RelativeSource="{RelativeSource TemplatedParent}"/>
                                    <Binding Path="IsLayoutEditing" RelativeSource="{RelativeSource TemplatedParent}"/>
                                </MultiBinding>
                            </Border.Opacity>
                        </Border>

                        <!--
                            PART_GlowFallback (plan D-9) — a pre-computed soft stroke with NO Effect at
                            all, shown instead of PART_Glow when Theming.ChromeEffectsPolicy.IsGlowEffectEnabled
                            is false (software/RDP render tier). In Windows High Contrast this part stays
                            Collapsed too — the separate HC DataTrigger below collapses it outright, so it
                            never actually becomes visible there. Margin = GlowFallbackMarginThickness
                            (ChromeOuterInset - GlowFallbackRingOffset, 1 DIP outside PART_Chrome's own
                            surface). Opacity reads the SAME "glow" channel scaled by
                            PanelMetrics.GlowFallbackOpacityFactor (the "glowFallback" parameter — see
                            EditAwareVisualStateToDoubleConverter's remarks). Collapsed by default; the
                            fallback DataTrigger below is what reveals it.
                        -->
                        <Border x:Name="PART_GlowFallback"
                                SnapsToDevicePixels="True"
                                Margin="{x:Static models:PanelMetrics.GlowFallbackMarginThickness}"
                                BorderBrush="{TemplateBinding AccentBrush}"
                                BorderThickness="{StaticResource Thickness.Hairline}"
                                CornerRadius="{StaticResource Radius.Panel}"
                                IsHitTestVisible="False"
                                Visibility="Collapsed">
                            <Border.Opacity>
                                <MultiBinding Converter="{StaticResource EditAwareVisualStateToDouble}" ConverterParameter="glowFallback">
                                    <Binding Path="VisualState" RelativeSource="{RelativeSource TemplatedParent}"/>
                                    <Binding Path="IsLayoutEditing" RelativeSource="{RelativeSource TemplatedParent}"/>
                                </MultiBinding>
                            </Border.Opacity>
                        </Border>

                        <!--
                            PART_SurfaceLayer (plan D-1/D-2/D-5/D-12). Margin = ChromeOuterInsetThickness
                            (2 DIP uniform) is the entire chrome-inset budget (D-1's exhaustive constraint
                            table — bounded above by the rolled-up header-button fit, the existing
                            ContentLeftInset horizontal chrome, the resize hit-test strip width, and
                            GridMetrics.FileListVPadding's own reserve; see PanelMetricsTests). Everything
                            INSIDE this Grid renders in "inset content" coordinates; PART_HitCatcher/
                            PART_Glow/PART_GlowFallback above render in full window-rect coordinates.

                            Single Clip owner (D-12): a Grid has no CornerRadius of its own to bind
                            RelativeSource Self against (unlike the old PART_Chrome-owned Clip this
                            replaces), so this MultiBinding's third input is the SAME {StaticResource
                            Radius.Panel} PART_Chrome/PART_NeutralStroke/PART_InteractionOverlay below all
                            already read directly — one shared radius value, one shared Clip, instead of
                            each decorative ring clipping itself independently (which would have to
                            individually re-derive its own inset-adjusted radius/size).
                        -->
                        <Grid x:Name="PART_SurfaceLayer" Margin="{x:Static models:PanelMetrics.ChromeOuterInsetThickness}">
                            <Grid.Clip>
                                <MultiBinding Converter="{StaticResource RoundedRectClip}">
                                    <Binding Path="ActualWidth" RelativeSource="{RelativeSource Self}"/>
                                    <Binding Path="ActualHeight" RelativeSource="{RelativeSource Self}"/>
                                    <Binding Source="{StaticResource Radius.Panel}"/>
                                </MultiBinding>
                            </Grid.Clip>

                            <!--
                                PART_Chrome — the panel's actual visible surface (unchanged role from
                                Phase 5; its own Clip moved to PART_SurfaceLayer above, D-12). Fills
                                PART_SurfaceLayer entirely (no Margin/explicit size — default Grid child
                                Stretch alignment).
                            -->
                            <Border x:Name="PART_Chrome"
                                    Background="{TemplateBinding SurfaceBrush}"
                                    CornerRadius="{StaticResource Radius.Panel}"
                                    SnapsToDevicePixels="True">
                                <!--
                                    Inner content grid — three columns (pad | * | pad, D-3) replacing the
                                    old fixed 8-DIP LEFT-only accent-indicator column: the accent identity
                                    now lives in the overlaid PART_AccentIndicator marker below, not a
                                    layout column, so the same 8-DIP total horizontal chrome
                                    (ContentLeftInset, unchanged — GridMetrics.FileListHPadding/every
                                    analytical snap-time formula reads the SAME constant, see
                                    PanelMetrics.ContentLeftInset's own remarks) splits symmetrically
                                    instead. Three rows (header-inner | gap | *) replacing the old
                                    HeaderRowHeight | * split — ChromeOuterInset + HeaderInnerHeight +
                                    HeaderContentGap reconstructs the exact same HeaderHeight (32 DIP)
                                    screen offset the pre-ADR-030 template used (PanelMetricsTests T-M1),
                                    so ChildWindow.xaml's RollUpBehavior/content-row math need no changes.
                                -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="{x:Static models:PanelMetrics.ContentSidePaddingLength}"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="{x:Static models:PanelMetrics.ContentSidePaddingLength}"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="{x:Static models:PanelMetrics.HeaderInnerRowHeight}"/>
                                        <RowDefinition Height="{x:Static models:PanelMetrics.HeaderContentGapLength}"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>

                                    <!--
                                        PART_SurfaceHighlight (plan D-11) — a very weak, non-semantic
                                        top-to-bottom gradient over PART_Chrome's own SurfaceBrush fill,
                                        FIRST child of this Grid (lowest z-order — under PART_Header/
                                        PART_ContentHost, matching §3's diagram: over the surface fill,
                                        under the header/content). Spans every row/column so it covers the
                                        whole surface, rolled-up included. Brush.Chrome.SurfaceHighlight
                                        (Brushes.xaml) is a single frozen LinearGradientBrush shared by
                                        every panel — no per-panel allocation. Not accent-tinted, not a
                                        PanelSurfaceStyle, not persisted (plan D-11's own "non-semantic"
                                        framing) — purely a static highlight token.
                                    -->
                                    <Border x:Name="PART_SurfaceHighlight"
                                            Grid.Row="0" Grid.RowSpan="3" Grid.Column="0" Grid.ColumnSpan="3"
                                            Background="{StaticResource Brush.Chrome.SurfaceHighlight}"
                                            IsHitTestVisible="False"/>

                                    <!--
                                        Header (§5.4): icon (optional) | title/rename editor (star) |
                                        rolled-up item count (optional) | header actions. PART_Header is
                                        layout-only — it never attaches its own interaction handlers (see
                                        this control's class remarks and R-5/R-6/R-7): the ContextMenu and
                                        title-bar drag handlers live on the actual element ChildWindow.xaml
                                        supplies via PanelChrome.TitleEditor, which THAT file declares (and
                                        can therefore wire to its own code-behind), not on anything declared
                                        in this ResourceDictionary.
                                    -->
                                    <Grid x:Name="PART_Header" Grid.Row="0" Grid.Column="1" ToolTip="{TemplateBinding Title}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- §5.4 "optional semantic icon" — reserved, no current consumer sets SemanticIcon (see the DP's doc comment). -->
                                        <TextBlock x:Name="PART_SemanticIcon"
                                                   Grid.Column="0"
                                                   Text="{TemplateBinding SemanticIcon}"
                                                   FontFamily="Segoe MDL2 Assets"
                                                   FontSize="12"
                                                   Foreground="{StaticResource Brush.Text.Secondary}"
                                                   VerticalAlignment="Center"
                                                   Margin="8,0,0,0"/>

                                        <ContentPresenter Grid.Column="1"
                                                           Content="{TemplateBinding TitleEditor}"
                                                           VerticalAlignment="Stretch"/>

                                        <!-- §5.6 rolled-up state: "Accent | Title | optional item count | expand control" — visible only while IsRolledUp (trigger below). -->
                                        <TextBlock x:Name="PART_ItemCount"
                                                   Grid.Column="2"
                                                   Text="{Binding ItemCount, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource ItemCountToText}}"
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,6,0"
                                                   Style="{StaticResource Typography.Caption}"
                                                   Visibility="Collapsed"/>

                                        <!--
                                            "Actions muted in idle" (§5.4 DoD): opacity driven by VisualState via
                                            VisualStateToDoubleConverter (parameter="chrome" -> InteractionVisualState.ChromeOpacityFor),
                                            not a hardcoded number here, so it can never drift out of sync with
                                            InteractionVisualStateTests' own asserted values (C2).
                                        -->
                                        <ContentPresenter x:Name="PART_HeaderActions"
                                                           Grid.Column="3"
                                                           Content="{TemplateBinding HeaderActions}"
                                                           VerticalAlignment="Center">
                                            <!-- D-6: MultiBinding over [VisualState, IsLayoutEditing] — see
                                                 EditAwareVisualStateToDoubleConverter's remarks above; "chrome"
                                                 forces full opacity for Idle while editing (LayoutEditVisuals.ChromeOpacityFor). -->
                                            <ContentPresenter.Opacity>
                                                <MultiBinding Converter="{StaticResource EditAwareVisualStateToDouble}" ConverterParameter="chrome">
                                                    <Binding Path="VisualState" RelativeSource="{RelativeSource TemplatedParent}"/>
                                                    <Binding Path="IsLayoutEditing" RelativeSource="{RelativeSource TemplatedParent}"/>
                                                </MultiBinding>
                                            </ContentPresenter.Opacity>
                                        </ContentPresenter>
                                    </Grid>

                                    <!-- Content host (§5.3) — hosts ChildWindow.xaml's existing FileListHost, supplied as this control's Content. -->
                                    <ContentPresenter x:Name="PART_ContentHost" Grid.Row="2" Grid.Column="1"/>
                                </Grid>
                            </Border>

                            <!--
                                PART_NeutralStroke (plan D-2/D-6/§3): a 1-DIP neutral (non-accent) rounded
                                rectangle OVER PART_Chrome's own surface — painted under an opaque Solid
                                surface, a stroke on the outer edge would be entirely invisible, and there
                                is no room left OUTSIDE PART_Chrome within the 2-DIP inset for a separate
                                ring (D-1's budget). Reuses Brush.Border.Default (already overridden for
                                High Contrast, Colors.HighContrast.xaml) so the base border stays a system
                                color there without a separate HC brush.

                                PART_InteractionOverlay below paints the SAME Brush.Border.Default hairline,
                                on the SAME pixels, for the Solid/Ambient SurfaceStyles — identical
                                BorderThickness/CornerRadius, both direct children of PART_SurfaceLayer.
                                (Under the Glass SurfaceStyle trigger below, PART_InteractionOverlay's own
                                BorderThickness widens to 1.5 DIP, so only the outer 1 DIP of its ring still
                                coincides with THIS ring's own 1-DIP stroke — the combined-opacity math
                                referenced below is therefore an approximation, not an exact pixel match,
                                under Glass.) This is deliberate duplication, not an oversight: the two rings
                                answer different questions and each is independently load-bearing. THIS ring
                                is ADR-030 §3's own "always-readable neutral panel outline" — the chrome's
                                base identity, present (at some opacity) in every VisualState, never fully
                                absent. The ring below is the PRE-EXISTING ADR-025/026 interaction-state
                                feedback channel (D-6's "border" reading) — unchanged by ADR-030, still
                                doing the job it always did. Their effective combined opacity, as actually
                                seen on screen (both draw the identical brush at the identical location, for
                                Solid/Ambient), is <c>1 - (1 - overlayOpacity) * (1 - neutralOpacity)</c> —
                                see Theming/LayeredChromeVisuals.cs's CombinedNeutralBorderOpacityFor
                                (test-only: nothing in this template reads it; each ring below keeps
                                computing its OWN Opacity independently).
                            -->
                            <Border x:Name="PART_NeutralStroke"
                                    SnapsToDevicePixels="True"
                                    BorderBrush="{StaticResource Brush.Border.Default}"
                                    BorderThickness="{StaticResource Thickness.Hairline}"
                                    CornerRadius="{StaticResource Radius.Panel}"
                                    IsHitTestVisible="False">
                                <Border.Opacity>
                                    <MultiBinding Converter="{StaticResource EditAwareVisualStateToDouble}" ConverterParameter="neutralStroke">
                                        <Binding Path="VisualState" RelativeSource="{RelativeSource TemplatedParent}"/>
                                        <Binding Path="IsLayoutEditing" RelativeSource="{RelativeSource TemplatedParent}"/>
                                    </MultiBinding>
                                </Border.Opacity>
                            </Border>

                            <!--
                                PART_AccentStroke (plan D-2/D-6/§3): a thin, ACCENT-colored ring drawn
                                CONCENTRICALLY just inside PART_NeutralStroke's own ring — Margin =
                                Thickness.Hairline (1 DIP, the same width PART_NeutralStroke's own stroke
                                occupies) and CornerRadius = Radius.Panel.Inner (Radius.Panel - 1, so the
                                two hairline rings read as concentric rounded rectangles, not one slightly
                                overhanging the other's corner — Spacing.xaml's own remarks). Deliberately
                                MUCH weaker than PART_AccentIndicator's own marker (T-P4:
                                AccentStrokeOpacityMax * hairline &lt; AccentMarkerStrokeThickness / 2) —
                                ADR-030 §3's own "accent stroke must not compete with the marker" rule.
                            -->
                            <Border x:Name="PART_AccentStroke"
                                    SnapsToDevicePixels="True"
                                    Margin="{StaticResource Thickness.Hairline}"
                                    BorderBrush="{TemplateBinding AccentBrush}"
                                    BorderThickness="{StaticResource Thickness.Hairline}"
                                    CornerRadius="{StaticResource Radius.Panel.Inner}"
                                    IsHitTestVisible="False">
                                <Border.Opacity>
                                    <MultiBinding Converter="{StaticResource EditAwareVisualStateToDouble}" ConverterParameter="accentStroke">
                                        <Binding Path="VisualState" RelativeSource="{RelativeSource TemplatedParent}"/>
                                        <Binding Path="IsLayoutEditing" RelativeSource="{RelativeSource TemplatedParent}"/>
                                    </MultiBinding>
                                </Border.Opacity>
                            </Border>

                            <!--
                                PART_AccentIndicator (plan D-4/D-7 item 2): the accent identity marker, a
                                curved Path tracing the panel's own top-left rounded corner — vertical stem
                                down the left edge, quarter-circle arc around the corner, short horizontal
                                tail along the top edge (AccentMarkerGeometryConverter, keyed off the SAME
                                {StaticResource Radius.Panel} PART_Chrome/PART_SurfaceLayer's own Clip
                                already read, so the marker always traces the exact corner the surface
                                itself paints). Hosted in a FIXED-size Grid (Width/Height from
                                PanelMetrics.AccentMarkerHostWidth/Height — computed, not Auto, from the
                                geometry's own bounds inflated by half the marker's maximum combined
                                StrokeThickness — plan D-7's "no layout jitter": a state-driven
                                StrokeThickness change never resizes this host, so it can never perturb
                                PanelChrome's own DesiredSize or nudge any sibling). Anchored top-left within
                                PART_SurfaceLayer (no Margin) — the same corner the marker's own curved
                                geometry traces (AccentMarkerGeometryConverter's remarks).

                                Stretch="None" — the Path's own Data coordinates are already in DIP (the
                                converter bakes AccentMarkerStemLength/AccentMarkerTailLength directly into
                                the geometry), so no additional scale/fit transform is wanted. Round
                                line caps/join (plan D-4) give the stroke's start/end and its one corner a
                                soft, rounded finish rather than a hard-edged rectangular cut.
                            -->
                            <Grid x:Name="PART_AccentIndicatorHost"
                                  HorizontalAlignment="Left" VerticalAlignment="Top"
                                  Width="{x:Static models:PanelMetrics.AccentMarkerHostWidth}"
                                  Height="{x:Static models:PanelMetrics.AccentMarkerHostHeight}"
                                  IsHitTestVisible="False">
                                <Path x:Name="PART_AccentIndicator"
                                      Stretch="None"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      StrokeLineJoin="Round"
                                      Stroke="{TemplateBinding AccentBrush}"
                                      IsHitTestVisible="False">
                                    <Path.Data>
                                        <Binding Source="{StaticResource Radius.Panel}" Converter="{StaticResource AccentMarkerGeometry}"/>
                                    </Path.Data>
                                    <!-- D-6/D-4: MultiBinding over [VisualState, IsLayoutEditing], "marker"
                                         parameter — see EditAwareAccentIndicatorWidthConverter's remarks above. -->
                                    <Path.StrokeThickness>
                                        <MultiBinding Converter="{StaticResource EditAwareAccentIndicatorWidth}" ConverterParameter="marker">
                                            <Binding Path="VisualState" RelativeSource="{RelativeSource TemplatedParent}"/>
                                            <Binding Path="IsLayoutEditing" RelativeSource="{RelativeSource TemplatedParent}"/>
                                        </MultiBinding>
                                    </Path.StrokeThickness>
                                </Path>
                            </Grid>

                            <!--
                                Interaction overlay (D-6): purely visual border feedback for the resolved
                                VisualState. IsHitTestVisible="False" is load-bearing (R-5) — this element
                                sits on top of the whole chrome (last child = highest z-order within
                                PART_SurfaceLayer) and must never intercept a mouse event ChildWindow.xaml's
                                own ResizeOverlay/drag/drop siblings, or this template's own header
                                buttons/title editor, need to receive. Relocated (ADR-030) from the old
                                two-row Grid (Grid.RowSpan="2") to PART_SurfaceLayer directly (its parent's
                                own single cell already spans the whole inset area, rolled-up included) —
                                same coverage, one fewer indirection.
                            -->
                            <Border x:Name="PART_InteractionOverlay"
                                    SnapsToDevicePixels="True"
                                    IsHitTestVisible="False"
                                    BorderBrush="{StaticResource Brush.Border.Default}"
                                    BorderThickness="{StaticResource Thickness.Hairline}"
                                    CornerRadius="{StaticResource Radius.Panel}">
                                <!-- D-6: MultiBinding over [VisualState, IsLayoutEditing] — see
                                     EditAwareVisualStateToDoubleConverter's remarks above; "border" applies
                                     LayoutEditVisuals' EditBorderFloor (0.60) while editing. -->
                                <Border.Opacity>
                                    <MultiBinding Converter="{StaticResource EditAwareVisualStateToDouble}" ConverterParameter="border">
                                        <Binding Path="VisualState" RelativeSource="{RelativeSource TemplatedParent}"/>
                                        <Binding Path="IsLayoutEditing" RelativeSource="{RelativeSource TemplatedParent}"/>
                                    </MultiBinding>
                                </Border.Opacity>
                            </Border>
                        </Grid>
                    </Grid>

                    <ControlTemplate.Triggers>
                        <Trigger Property="SemanticIcon" Value="">
                            <Setter TargetName="PART_SemanticIcon" Property="Visibility" Value="Collapsed"/>
                        </Trigger>

                        <Trigger Property="IsRolledUp" Value="True">
                            <Setter TargetName="PART_ItemCount" Property="Visibility" Value="Visible"/>
                        </Trigger>

                        <!-- R-8: Glass is "lower opacity + a stronger border", never a real backdrop-blur — the only extra visual this template gives it beyond what SurfaceComposer.ComposeSurface already lowers. -->
                        <Trigger Property="SurfaceStyle" Value="Glass">
                            <Setter TargetName="PART_InteractionOverlay" Property="BorderThickness" Value="1.5"/>
                        </Trigger>

                        <!--
                            ADR-030 shader-free fallback (plan D-9): this DataTrigger binds
                            ChromeEffectsPolicy.IsGlowEffectEnabled via a Binding with Mode=OneTime — which
                            defers evaluation from XAML-parse time to whenever the binding is actually
                            attached (here, whenever a panel's own ControlTemplate is first applied), the
                            same "resolve per-instance, at template-application time" idiom the High
                            Contrast trigger just below uses for HighContrastState.IsActive. When the real
                            render tier is below 2 (software/RDP rendering) — or this policy's own future
                            kill-switch is flipped — PART_Glow's shader-based DropShadowEffect never
                            executes at all (Effect={x:Null}, not just Opacity=0 — an unused Effect object
                            still costs a composited intermediate surface even at Opacity 0) and
                            PART_GlowFallback's plain, effect-free ring takes over. Declared BEFORE the High
                            Contrast trigger below: HC's own Setters for these same two parts must win when
                            BOTH conditions are true (HC panels never show a fallback ring either) — later
                            Setters win ties in WPF's ControlTemplate.Triggers, so ordering here is
                            load-bearing, not stylistic.
                        -->
                        <DataTrigger Binding="{Binding Path=(theming:ChromeEffectsPolicy.IsGlowEffectEnabled), Mode=OneTime}" Value="False">
                            <Setter TargetName="PART_Glow" Property="Visibility" Value="Collapsed"/>
                            <Setter TargetName="PART_Glow" Property="Effect" Value="{x:Null}"/>
                            <Setter TargetName="PART_GlowFallback" Property="Visibility" Value="Visible"/>
                        </DataTrigger>

                        <!--
                            ADR-030 High Contrast strategy (plan D-8): a Binding with Mode=OneTime against
                            HighContrastState.IsActive — resolved once, when a panel's template is first
                            applied, NOT at XAML-parse time (unlike the "{x:Static
                            theming:HighContrastState.IsActive}"-as-Binding.Source idiom
                            HighContrastState's own remarks document for its OTHER consumer,
                            ChildWindow.xaml's PanelSurfaceBrush MultiBinding — that idiom resolves once,
                            at parse time, for the whole process; THIS trigger's Mode=OneTime Binding
                            resolves once PER PanelChrome instance, at template-application time), so a
                            test can flip the flag before constructing a PanelChrome without reloading any
                            resource dictionary. Decorative-only parts collapse; PART_NeutralStroke's own opacity is forced to 1
                            (its brush is already a system color via Colors.HighContrast.xaml). Declared
                            AFTER the fallback trigger above so ITS Setters for PART_Glow/PART_GlowFallback
                            win when both are true (see that trigger's own remarks). PART_SurfaceHighlight
                            (plan D-11) is collapsed here too — Colors.HighContrast.xaml ALSO overrides its
                            own gradient endpoint colors to Transparent (MAJOR-A "every chrome color gets an
                            HC override"), so this Setter is a belt-and-suspenders redundancy for a consumer
                            that only checks Visibility.
                        -->
                        <DataTrigger Binding="{Binding Path=(theming:HighContrastState.IsActive), Mode=OneTime}" Value="True">
                            <Setter TargetName="PART_Glow" Property="Visibility" Value="Collapsed"/>
                            <Setter TargetName="PART_Glow" Property="Effect" Value="{x:Null}"/>
                            <Setter TargetName="PART_GlowFallback" Property="Visibility" Value="Collapsed"/>
                            <Setter TargetName="PART_AccentStroke" Property="Visibility" Value="Collapsed"/>
                            <Setter TargetName="PART_NeutralStroke" Property="Opacity" Value="1"/>
                            <Setter TargetName="PART_SurfaceHighlight" Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        Shared selection/hover chrome for both panel item containers (wrap and list) AND
        SystemIconsPanelWindow's sidebar list — relocated from Templates.xaml (C5, D-2; the "item
        container" entry D-1 names for this dictionary). Deliberately reacts to IsSelected only —
        never IsSelectionActive — because the panel window carries WS_EX_NOACTIVATE and is never the
        active/focused window, so the default ListBoxItem theme's IsSelectionActive-gated highlight
        would be permanently invisible.

        Background/Padding Setters used to be declared here too, but neither is read by the
        ControlTemplate below (it draws its own Border(s) and never TemplateBinds Background, and
        ContentPresenter never consults ListBoxItem.Padding) — they were dead weight that misleadingly
        implied the container's own chrome mattered. Foreground *is* live: nothing in either item
        DataTemplate overrides it, so it flows down via WPF's Foreground property-value inheritance to
        any descendant that doesn't set its own (e.g. TextBox's default style).

        SelectionBorder used to be declared with BorderThickness="1" and a compensating Margin="-1":
        a Border with no Padding adds its BorderThickness to its own measured (desired) size, which
        would otherwise inflate every ListBoxItem in grid mode by 2px beyond its DataTemplate content
        — desynchronising the WrapPanel's actual per-item footprint from GridMetrics.CellSize/BoxSize
        (grid-snap math, see Resize_DragDelta/SnapWidthToGrid in ChildWindow.xaml.cs). The negative
        Margin cancelled that out in measurement, but it also pushed the 1px border stroke *outside*
        the ListBoxItem's own arrange box — for the first row/column, that stroke fell outside the
        ScrollViewer's clip region and was silently cut off (ADR-015, ui-polishing-1 §3.3).

        Fix (B-F1): the border no longer has a compensating negative Margin (Margin="0"), so its
        stroke always stays inside the arrange box and is never clipped. To keep GridMetrics.CellSize
        exactly byte-for-byte unchanged, the compensation moved into the *content* instead: the item
        StackPanel's own Margin in GridViewTemplate was reduced from 6 to 5. The per-side footprint is
        now split as "5px template margin + 1px selection border" = 6px per side (same total as
        before, hence GridMetrics.ItemMargin — read as "Gutter" in the ui-polishing-1 plan — is still
        6 and CellSize's formula is unchanged), but the border itself now lives fully inside that 6px,
        instead of poking 1px past it.

        Icon tiles (§5.5, C5): "neutral hover surface" is unchanged (Brush.Overlay.Hover — the same
        non-accent hover wash every other hover trigger in the app uses). "Selected uses accent at low
        alpha" is new in C5: SelectionFillBrush/SelectionStrokeBrush's fixed blue is retired for THIS
        style only — PanelHeaderToggleButtonStyle/FileNameEditBoxStyle keep using those tokens
        unchanged (Controls.xaml/Templates.xaml), since a Sort-button "active" indicator is not the
        same concept as a panel's own semantic accent identity. Selection now reads
        PanelTheme.Accent (D-7's inherited attached DP, Theming/PanelTheme.cs) — never a DataContext
        binding, because this style is shared by ChildWindow (DataContext = ChildWindowViewModel,
        which owns an accent via PanelTheme.Accent on PanelRoot) and SystemIconsPanelWindow
        (DataContext = SystemIconsPanelViewModel, which has no AccentColor at all and never sets
        PanelTheme.Accent — it gets the attached property's own neutral default for free).

        SelectionFill is a Border SIBLING of SelectionBorder in the Grid below, not a parent of
        ContentPresenter: this style's "accent at low alpha" needs to dim only the fill colour, never
        the item's icon/label. Setting Opacity on a Border that has ContentPresenter as an actual
        child (the pre-C5 structure had one Border wrapping ContentPresenter directly) would visibly
        fade the icon/label too, since Border.Opacity applies to its whole subtree — the same reason
        PART_HeaderActions/PART_InteractionOverlay above use Opacity only on elements with no unrelated
        content of their own. SelectionFill.Opacity's value is
        <c>{x:Static conv:AccentBrushConverter.SelectionAlpha}</c> (a real reference, not a hand-mirrored
        literal — MAJOR-2 fix) — the same "accent tinted to a low, fixed alpha" algorithm
        SurfaceComposer.AccentTint implements — because AccentBrushConverter's own Convert(value, ...)
        expects a hex <see cref="string"/> (it feeds Model.AccentColor, ChildWindow's OWN DataContext
        binding, in Panels.xaml's PanelChrome AccentBrush/SurfaceBrush wiring), not a Brush — and
        PanelTheme.Accent is already a Brush by the time it reaches here (D-7's whole point) — so the
        converter itself can't be called directly for this Setter; x:Static against SelectionAlpha
        (now public — was internal, which was itself CRITICAL-1 from review round 2: x:Static resolves
        via public-only reflection on .NET (Core), even within the same assembly) keeps the two values
        impossible to desync instead.

        Selected+hovered (MAJOR-3 fix): IsMouseOver and IsSelected write to DIFFERENT elements
        (SelectionBorder.Background vs. SelectionFill.Opacity/SelectionBorder.BorderBrush), so both
        triggers apply simultaneously when both facts are true — without the MultiTrigger below, the
        hover wash (SelectionBorder.Background) would paint OVER the accent fill (SelectionFill sits
        underneath in z-order), which does not match "selected wins" pre-C5 behaviour. The MultiTrigger
        resets SelectionBorder.Background to Transparent when IsSelected is ALSO true, restoring a clean
        accent-only look for that combination.
    -->
    <Style x:Key="PanelItemContainerStyle" TargetType="ListBoxItem">
        <Setter Property="Foreground" Value="{StaticResource Brush.Text.Primary}"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Grid SnapsToDevicePixels="True">
                        <!-- Accent fill layer (selection only) — see this Style's remarks above for why
                             it is a separate element from SelectionBorder/ContentPresenter. -->
                        <Border x:Name="SelectionFill"
                                Margin="0"
                                Background="{Binding Path=(theming:PanelTheme.Accent), RelativeSource={RelativeSource Self}}"
                                CornerRadius="{StaticResource Radius.Control}"
                                Opacity="0"/>
                        <Border x:Name="SelectionBorder"
                                Margin="0"
                                Background="Transparent"
                                BorderBrush="Transparent"
                                BorderThickness="1"
                                CornerRadius="{StaticResource Radius.Control}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <!-- Declared before IsSelected so IsSelected's own Setters (below) win when both
                             are active for the properties they BOTH touch; where they touch DIFFERENT
                             properties (this is exactly that case), the MultiTrigger further below
                             reconciles the combination explicitly. -->
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="SelectionBorder" Property="Background" Value="{StaticResource Brush.Overlay.Hover}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="SelectionFill" Property="Opacity" Value="{x:Static conv:AccentBrushConverter.SelectionAlpha}"/>
                            <Setter TargetName="SelectionBorder" Property="BorderBrush" Value="{Binding Path=(theming:PanelTheme.Accent), RelativeSource={RelativeSource Self}}"/>
                        </Trigger>
                        <!-- MAJOR-3 fix: selected+hovered must render as clean accent, not hover-wash
                             layered on top of it — see this Style's remarks above. -->
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsMouseOver" Value="True"/>
                                <Condition Property="IsSelected" Value="True"/>
                            </MultiTrigger.Conditions>
                            <Setter TargetName="SelectionBorder" Property="Background" Value="Transparent"/>
                        </MultiTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
