<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:conv="clr-namespace:DesktopOrganizer.UI.Converters"
                    xmlns:models="clr-namespace:DesktopOrganizer.UI.Models"
                    xmlns:loc="clr-namespace:DesktopOrganizer.UI.Localization">
    <!--
        Settings-window redesign (docs/prompts/settings-window-redesign.md, D-2/D-9). Merged app-wide by
        App.xaml.cs LoadResourceDictionaries() (after Controls.xaml): the section UserControls are created
        through DataTemplates and parsed BEFORE they join MainWindow's visual tree, so a Window-local merge
        is invisible to their StaticResource lookups (see SettingsSectionsInitializeTests).
        Palette: everything here uses Theme.* — Palette T, "application chrome" (docs/PLANS/design-system-1x.md
        §2.1/§2.2, ADR-047 D-2), resolved live by DesktopOrganizer.UI.Theming.AppThemeService and consumed
        exclusively through {DynamicResource} (a theme switch replaces the whole dictionary — StaticResource
        would freeze whatever theme was active the moment this file first parsed). The pre-6.1 fixed-light
        The fixed-light brush/colour tokens this file used to reference no longer exist (removed from
        Colors.xaml/Brushes.xaml/Colors.HighContrast.xaml once every consumer here migrated). The dark
        Ambient Accent tokens (Brush.Surface.*/Brush.Text.*/Brush.Border.*/Brush.Overlay.*, Palette P) still
        belong to desktop panels only — never referenced here.

        "Settings card" pattern (D-9): a Settings.CardBorder wrapping a two-column Grid — a left
        StackPanel with a Settings.CardHeader + Settings.CardDescription (the description replaces what
        used to be a ToolTip), and the actual control docked to the right column. Not every card fits a
        strict two-column shape (e.g. a slider-with-readout, a RadioButton group, or a list+toolbar) —
        those stack the description above the control instead, inside the same Settings.CardBorder.
    -->
    <conv:EnumToBooleanConverter x:Key="EnumToBoolean"/>
    <conv:EnumDisplayNameConverter x:Key="EnumDisplayName"/>
    <conv:NotBooleanConverter x:Key="NotBoolean"/>
    <BooleanToVisibilityConverter x:Key="BooleanToVisibility"/>
    <!-- Localization (docs/PLANS/localization.md §2.4/§4.5): declared here — the ONE place every
         Views/Settings/*.xaml UserControl already reaches through StaticResource — rather than once
         per section, per the "consumer declares its own converter instances" rule. -->
    <loc:LocKeyConverter x:Key="LocKey"/>
    <loc:PageDisplayNameConverter x:Key="PageDisplayName"/>

    <!-- ── Sidebar navigation ─────────────────────────────────────────────────────────────────── -->

    <!-- H-4 fix (6.1 review round, docs/PLANS/design-system-1x.md §1.1 H-4): a Grid (Auto glyph column +
         "*" text column), not the pre-6.2b horizontal StackPanel — a StackPanel gives every child
         UNLIMITED width along its own orientation during Measure, so the label TextBlock's own
         TextTrimming/natural width is never actually constrained by the 220 DIP sidebar column, it just
         silently draws past it. The "*" column instead hands the label exactly "column width minus the
         glyph slot", which is what makes TextTrimming genuinely ellipsize a still-too-long ru-RU label
         (e.g. "Расположение и привязка") instead of visually overflowing — the ToolTip carries the
         un-truncated text either way. -->
    <DataTemplate x:Key="Settings.SidebarItemTemplate" DataType="{x:Type models:SettingsSectionInfo}">
        <Grid Margin="2,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <!-- Fallback font list (fix-cycle finding 12): "Segoe Fluent Icons" ships the same PUA glyph
                 codepoints on Windows 11 and is used if "Segoe MDL2 Assets" isn't installed, so a system
                 missing one of the two never renders these as an empty box.
                 M-2 fix (6.5 review round): unlike the label TextBlock below, this glyph's base Foreground
                 is deliberately Theme.Text.Secondary — a step dimmer than the container's own
                 Theme.Text.Primary — so it cannot simply mirror the container's Foreground the way the
                 label does. The DataTemplate.Triggers below instead swap ONLY the selected/hovered states
                 to Theme.Selection.Text, matching Settings.SidebarListBoxItem/Settings.SidebarAboutToggle's
                 own Foreground triggers — without them, in High Contrast a selected/hovered item drew this
                 glyph in WindowText on the Highlight fill (≈1.4:1, WCAG 1.4.11). -->
            <TextBlock x:Name="Glyph"
                       Grid.Column="0"
                       Text="{Binding Glyph}"
                       FontFamily="Segoe MDL2 Assets, Segoe Fluent Icons"
                       FontSize="{DynamicResource Font.Size.Body}"
                       Width="20"
                       Margin="0,0,10,0"
                       VerticalAlignment="Center"
                       Foreground="{DynamicResource Theme.Text.Secondary}"/>
            <!-- L-8 fix (6.1 review round): mirrors the hosting ListBoxItem/ToggleButton's OWN Foreground
                 (set explicitly by Settings.SidebarListBoxItem/Settings.SidebarAboutToggle below, including
                 their hover/selected triggers) rather than an unset, non-theme-aware ambient default — this
                 is also what lets a hover/selected state swap this text to Theme.Selection.Text (HC
                 contrast against the Highlight fill those states use there) without this DataTemplate
                 needing to know which container type hosts it. -->
            <TextBlock Grid.Column="1"
                       Text="{loc:LocBinding TitleKey, Converter={StaticResource LocKey}}"
                       ToolTip="{loc:LocBinding TitleKey, Converter={StaticResource LocKey}}"
                       TextTrimming="CharacterEllipsis"
                       FontSize="{DynamicResource Font.Size.Body}"
                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Control}}"
                       VerticalAlignment="Center"/>
        </Grid>
        <DataTemplate.Triggers>
            <!-- M-2 fix (6.5 review round): three independent triggers — this template hosts under BOTH a
                 ListBoxItem (IsSelected) and the standalone "About" ToggleButton (IsChecked), and either can
                 also be IsMouseOver; an ancestor binding that finds no matching type resolves to
                 UnsetValue/false and simply never fires, so all three coexist safely regardless of which
                 container is actually hosting this template instance. -->
            <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Control}}" Value="True">
                <Setter TargetName="Glyph" Property="Foreground" Value="{DynamicResource Theme.Selection.Text}"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                <Setter TargetName="Glyph" Property="Foreground" Value="{DynamicResource Theme.Selection.Text}"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding IsChecked, RelativeSource={RelativeSource AncestorType=ToggleButton}}" Value="True">
                <Setter TargetName="Glyph" Property="Foreground" Value="{DynamicResource Theme.Selection.Text}"/>
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>

    <!-- Shared chrome (hover/selected wash) for both the sidebar ListBoxItems and the standalone
         "About" ToggleButton pinned below them, so the two read as one continuous nav list.
         Phase 6.1 (design-system-1x.md §1.1 S-1/§2.2, ADR-047 D-2/D-6): the selected item's fill alone
         (Theme.Selection.Fill, white-on-white in Light) is not itself a ≥3:1 WCAG 1.4.11 state
         indicator — a 3 DIP accent "Indicator" bar carries that job instead; the fill stays for the
         larger, softer highlight area Win11's own selected nav items use. -->
    <Style x:Key="Settings.SidebarListBoxItem" TargetType="ListBoxItem">
        <Setter Property="Padding" Value="12,8"/>
        <Setter Property="Margin" Value="6,2"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <!-- L-8/H-1 fix (6.1 review round): an explicit base Foreground (rather than an unset ambient
             default) — Settings.SidebarItemTemplate's own label mirrors THIS property, so it follows every
             state below automatically. -->
        <Setter Property="Foreground" Value="{DynamicResource Theme.Text.Primary}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Grid>
                        <Border x:Name="Chrome"
                                Background="Transparent"
                                CornerRadius="{StaticResource Radius.Control}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <Border x:Name="Indicator"
                                Width="3"
                                Margin="0,4"
                                HorizontalAlignment="Left"
                                CornerRadius="2"
                                Background="Transparent"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <!-- H-1 HC fix (6.1 review round): in High Contrast, Theme.Control.Subtle.Hover
                             resolves to SystemColors.Highlight — the SAME fill Theme.Selection.Fill/
                             Indicator use for the SELECTED item below, so without an accompanying Foreground
                             swap a hovered (not selected) item's text would sit on a Highlight background
                             using ordinary WindowText, an unreliable-contrast combination. Theme.Selection.Text
                             is Theme.Text.Primary in Light/Dark (no visible change there) and
                             SystemColors.HighlightText in HC (the correct pairing for a Highlight fill). -->
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource Theme.Control.Subtle.Hover}"/>
                            <Setter Property="Foreground" Value="{DynamicResource Theme.Selection.Text}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource Theme.Selection.Fill}"/>
                            <Setter TargetName="Indicator" Property="Background" Value="{DynamicResource Theme.Selection.Indicator}"/>
                            <Setter Property="Foreground" Value="{DynamicResource Theme.Selection.Text}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Settings.SidebarListBox" TargetType="ListBox">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Disabled"/>
        <Setter Property="ItemContainerStyle" Value="{StaticResource Settings.SidebarListBoxItem}"/>
        <Setter Property="ItemTemplate" Value="{StaticResource Settings.SidebarItemTemplate}"/>
    </Style>

    <!-- The pinned "About" entry is a standalone ToggleButton (not a ListBox item): its IsChecked is a
         one-way reflection of SelectedSection == About, and clicking it always re-issues
         SelectSectionCommand — see MainWindow.xaml's remarks on why this is more robust here than a
         second one-item ListBox sharing SelectedValue with the first. -->
    <Style x:Key="Settings.SidebarAboutToggle" TargetType="ToggleButton">
        <Setter Property="Padding" Value="12,8"/>
        <Setter Property="Margin" Value="6,6"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <!-- L-8/H-1 fix (6.1 review round) — see Settings.SidebarListBoxItem's identical remarks above. -->
        <Setter Property="Foreground" Value="{DynamicResource Theme.Text.Primary}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Grid>
                        <Border x:Name="Chrome"
                                Background="{TemplateBinding Background}"
                                CornerRadius="{StaticResource Radius.Control}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <Border x:Name="Indicator"
                                Width="3"
                                Margin="0,4"
                                HorizontalAlignment="Left"
                                CornerRadius="2"
                                Background="Transparent"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource Theme.Control.Subtle.Hover}"/>
                            <Setter Property="Foreground" Value="{DynamicResource Theme.Selection.Text}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource Theme.Selection.Fill}"/>
                            <Setter TargetName="Indicator" Property="Background" Value="{DynamicResource Theme.Selection.Indicator}"/>
                            <Setter Property="Foreground" Value="{DynamicResource Theme.Selection.Text}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ── Section content ────────────────────────────────────────────────────────────────────── -->

    <Style x:Key="Settings.PageHeader" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{DynamicResource Font.Size.Title}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource Theme.Text.Primary}"/>
        <Setter Property="Margin" Value="0,0,0,12"/>
        <Setter Property="AutomationProperties.HeadingLevel" Value="Level1"/>
    </Style>

    <!-- Phase 6.2a (design-system-1x.md §2.3/§2.5, ADR-047 D-4): group headers sit between PageHeader (L1)
         and CardHeader in the visual hierarchy (§2.12: "PageHeader (L1) → GroupHeader (L2) → CardHeader →
         Description"). No consumer yet in this commit (Views/Settings/** is 6.2b's own zone) — the style
         exists here so 6.2b's screens have it ready. -->
    <Style x:Key="Settings.GroupHeader" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{DynamicResource Font.Size.BodyStrong}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource Theme.Text.Primary}"/>
        <Setter Property="Margin" Value="0,24,0,8"/>
        <Setter Property="AutomationProperties.HeadingLevel" Value="Level2"/>
    </Style>

    <!-- Phase 6.2a: geometry now Theme.Card.Padding/Theme.Radius.Card (ADR-047 D-5) instead of the
         pre-6.2a 14,12 literal and Palette P's own Radius.Control (3 DIP — a value meant for panel chrome,
         not this window; Theme.Radius.Card is 6). Margin stays a literal Thickness (0,0,0,Theme.Card.Gap):
         Theme.Card.Gap is a bare sys:Double in Theming/ThemeResourceBuilder.cs (shared with any future
         non-Margin consumer, e.g. a StackPanel gap converter), and a Margin/Thickness property cannot bind
         a DynamicResource double directly (WPF does not run a TypeConverter over a resolved
         DynamicResource value the way it does over a literal string) — so the 4 DIP value is duplicated
         here as a plain literal, matching Theme.Card.Gap's own value. -->
    <Style x:Key="Settings.CardBorder" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Theme.Surface.Card}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Theme.Stroke.Card}"/>
        <Setter Property="BorderThickness" Value="{StaticResource Thickness.Hairline}"/>
        <Setter Property="CornerRadius" Value="{DynamicResource Theme.Radius.Card}"/>
        <Setter Property="Padding" Value="{DynamicResource Theme.Card.Padding}"/>
        <Setter Property="Margin" Value="0,0,0,4"/>
    </Style>

    <Style x:Key="Settings.CardHeader" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{DynamicResource Font.Size.Body}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource Theme.Text.Primary}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>

    <!-- Phase 6.1 (design-system-1x.md §2.3/§2.12, ADR-047 D-4): FontSize now DynamicResource
         Font.Size.Caption (M, recomputed from SystemFonts.MessageFontSize) instead of the fixed 11 DIP
         literal — closes the "no Palette T text below M" violation this was the last remaining instance
         of in this style catalogue (11 < the Windows default M = 12). -->
    <Style x:Key="Settings.CardDescription" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{DynamicResource Font.Size.Caption}"/>
        <Setter Property="Foreground" Value="{DynamicResource Theme.Text.Secondary}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="Margin" Value="0,4,0,0"/>
    </Style>

    <Style x:Key="Settings.RadioOption" TargetType="RadioButton">
        <Setter Property="Margin" Value="0,6,0,0"/>
        <Setter Property="Cursor" Value="Hand"/>
    </Style>

    <!-- Renders an enum value passed as a RadioButton/ComboBoxItem's Content through
         EnumDisplayNameConverter, so every enum-backed control in this window shows the same
         human-readable label instead of the raw C# member name. -->
    <DataTemplate x:Key="Settings.EnumRadioLabel">
        <TextBlock Text="{loc:LocBinding Converter={StaticResource EnumDisplayName}}" TextWrapping="Wrap"/>
    </DataTemplate>

    <!--
        ADR-042 "Segmented control" — a pill-shaped group of 2-3 mutually-exclusive RadioButtons (Mode
        Light/Dark, Surface Style Solid/Ambient/Glass, View List/Grid, Sort Manual/Name), replacing a plain
        RadioButton row/ComboBox wherever there are only 2-3 options. Container: a Settings.CardBorder-style
        hairline Border around a UniformGrid of Settings.SegmentedItem RadioButtons, sharing one GroupName
        per group (except the Mode group, which is VM-driven — see PanelColorEditor.xaml's own remarks).
        Keyboard (release-polish-1.0 review round, corrected): WPF's <c>RadioButton</c> does NOT check the
        newly-focused sibling on an arrow key by itself — arrow keys among same-<c>GroupName</c> siblings
        only move KEYBOARD FOCUS; the focused segment is only actually SELECTED once Space/Enter (or a
        click) fires it. Each segmented group's own <c>UniformGrid</c> sets
        <c>KeyboardNavigation.TabNavigation="Once"</c> (one Tab stop for the whole group) and
        <c>KeyboardNavigation.DirectionalNavigation="Contained"</c> (arrow keys cycle focus within the
        group, never escaping it to a sibling control) — no custom KeyDown handling needed for either.
    -->
    <Style x:Key="Settings.SegmentedGroup" TargetType="Border">
        <!-- H-1 HC fix (6.1 review round): the track used to be Theme.Control.Subtle.Hover, which in High
             Contrast resolves to SystemColors.Highlight — the EXACT SAME fill Settings.SegmentedItem's own
             IsChecked trigger below uses for the selected segment, making the track and the selected
             segment indistinguishable (≈1:1 contrast) in HC. Theme.Control.Fill is a distinct HC token
             (SystemColors.ControlBrush) while still reading as a plain, unobtrusive fill in Light/Dark —
             see Settings.SegmentedItem's own IsChecked trigger for the M-4 "selected pops off Light's
             otherwise-identical white track" half of this fix (an outline, since Control.Fill and
             Selection.Fill are both pure white in Light). -->
        <Setter Property="Background" Value="{DynamicResource Theme.Control.Fill}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Theme.Stroke.Card}"/>
        <Setter Property="BorderThickness" Value="{StaticResource Thickness.Hairline}"/>
        <Setter Property="CornerRadius" Value="{DynamicResource Theme.Radius.Control}"/>
        <Setter Property="Padding" Value="2"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
    </Style>

    <!--
        Release-polish-1.0 visual review item 4: a Settings.CardBorder-styled Expander whose HEADER lives
        INSIDE the card (chevron + title + description), replacing the old shape of a bare Expander.Header
        floating above a separately-carded Content — that left the header with no card of its own and no
        consistent bottom margin against the next card. Retemplates Expander entirely: the outer Border IS
        the card (same Background/BorderBrush/BorderThickness/CornerRadius/Padding/Margin token values as
        Settings.CardBorder, copied rather than reused via BasedOn since Border and Expander share no common
        Style base), a borderless ToggleButton bound to IsExpanded hosts the header content (its own
        ContentPresenter's ContentSource="Header", so callers set Expander.Header to any title/description
        layout), and a chevron (Icon.Glyph.ChevronDown/Up, already declared in Icons.xaml) flips on
        IsChecked. The body ContentPresenter defaults to ContentSource="Content" (WPF's own
        HeaderedContentControl convention) and is only Visible while IsExpanded.
    -->
    <Style x:Key="Settings.CardExpander" TargetType="Expander">
        <!-- m3 (release-polish-1.0 review round): the Expander itself is not a tab stop — only its own
             HeaderToggle (below) is; this keeps Tab from landing on both the Expander AND its header
             ToggleButton as two separate stops for what a user perceives as ONE clickable header. -->
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Expander">
                    <Border Background="{DynamicResource Theme.Surface.Card}"
                            BorderBrush="{DynamicResource Theme.Stroke.Card}"
                            BorderThickness="{StaticResource Thickness.Hairline}"
                            CornerRadius="{DynamicResource Theme.Radius.Card}"
                            Padding="{DynamicResource Theme.Card.Padding}"
                            Margin="0,0,0,4">
                        <StackPanel>
                            <ToggleButton x:Name="HeaderToggle"
                                          IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                          AutomationProperties.Name="{Binding Path=(AutomationProperties.Name), RelativeSource={RelativeSource TemplatedParent}}"
                                          Cursor="Hand"
                                          Background="Transparent"
                                          BorderThickness="0"
                                          Padding="0"
                                          HorizontalContentAlignment="Stretch">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="ToggleChrome" Background="Transparent" CornerRadius="{DynamicResource Theme.Radius.Control}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock x:Name="Chevron" Grid.Column="0" Margin="0,2,10,0"
                                                           FontFamily="Segoe MDL2 Assets, Segoe Fluent Icons" FontSize="{DynamicResource Font.Size.Caption}"
                                                           VerticalAlignment="Top"
                                                           Foreground="{DynamicResource Theme.Text.Secondary}"
                                                           Text="{StaticResource Icon.Glyph.ChevronDown}"/>
                                                <ContentPresenter Grid.Column="1" ContentSource="Content" VerticalAlignment="Top"/>
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="Chevron" Property="Text" Value="{StaticResource Icon.Glyph.ChevronUp}"/>
                                            </Trigger>
                                            <!-- m3: a hover state — this header was previously entirely
                                                 unresponsive to IsMouseOver, unlike every other clickable
                                                 Settings-card affordance (SegmentedItem, sidebar items). -->
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="ToggleChrome" Property="Background" Value="{DynamicResource Theme.Control.Subtle.Hover}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                                <ContentPresenter ContentSource="Header"/>
                            </ToggleButton>
                            <ContentPresenter x:Name="ExpanderContent" Margin="0,10,0,0" Visibility="Collapsed"/>
                        </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsExpanded" Value="True">
                            <Setter TargetName="ExpanderContent" Property="Visibility" Value="Visible"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        Backlog 1.x item 5 (§5.2/§5.3 "компактный вариант SegmentedGroup"): a smaller-footprint variant of
        Settings.SegmentedGroup/SegmentedItem for a SECONDARY control that shouldn't compete visually with
        a card's own primary content — e.g. PanelColorEditor.xaml's Light/Dark toggle, now placed directly
        under the preset swatch grid instead of inside its own stand-alone "Mode" card. Same chrome/states
        (BasedOn), just tighter padding and a smaller font.
    -->
    <Style x:Key="Settings.SegmentedGroup.Compact" TargetType="Border" BasedOn="{StaticResource Settings.SegmentedGroup}">
        <Setter Property="Padding" Value="1"/>
    </Style>

    <!-- Phase 6.2a (H-3, ADR-047 D-6): FocusVisualStyle now the shared Theme.FocusVisual double-ring
         (Resources/Styles/Theme.Controls.xaml) instead of a bespoke 1px BorderBrush/BorderThickness
         template trigger — the plan's own H-3 finding ("сегменты — 1 px рамка фокуса"). Disabled no longer
         uses a blanket Opacity (D-6 "disabled ≠ Opacity"): Foreground dims to Theme.Text.Disabled instead —
         SegmentedItemStyleTests (adapted this phase) pins both changes. -->
    <Style x:Key="Settings.SegmentedItem" TargetType="RadioButton">
        <Setter Property="Padding" Value="10,5"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="Focusable" Value="True"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource Theme.FocusVisual}"/>
        <!-- H-1/L-8 fix (6.1 review round) — base, theme-aware Foreground (was an unset ambient default). -->
        <Setter Property="Foreground" Value="{DynamicResource Theme.Text.Primary}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Segment"
                            Background="Transparent"
                            BorderBrush="Transparent"
                            BorderThickness="1"
                            CornerRadius="{DynamicResource Theme.Radius.Control}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <!-- H-1 HC fix — see Settings.SegmentedGroup's own remarks: Foreground swaps to
                             Theme.Selection.Text so hover (Highlight in HC, from the fill trigger below)
                             keeps readable text. -->
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Segment" Property="Background" Value="{DynamicResource Theme.Control.Subtle.Hover}"/>
                            <Setter Property="Foreground" Value="{DynamicResource Theme.Selection.Text}"/>
                        </Trigger>
                        <!-- M-4 fix (6.1 review round): Theme.Selection.Fill and the track's own
                             Theme.Control.Fill (Settings.SegmentedGroup) are both pure white in Light, so the
                             fill alone no longer visually separates a selected segment from the track —
                             an outline (the plan's own documented "или обводка" fallback) restores that
                             separation in every theme, not just where the two fills happen to differ. -->
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Segment" Property="Background" Value="{DynamicResource Theme.Selection.Fill}"/>
                            <Setter TargetName="Segment" Property="BorderBrush" Value="{DynamicResource Theme.Stroke.Control}"/>
                            <Setter Property="Foreground" Value="{DynamicResource Theme.Selection.Text}"/>
                        </Trigger>
                        <!-- M6 (release-polish-1.0 review round), retargeted in 6.2a: a disabled segment
                             (e.g. the Sort group while the panel is a Folder Portal, PanelCustomizeWindow.xaml)
                             must still render visibly dimmed. -->
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource Theme.Text.Disabled}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Backlog 1.x item 5 — see Settings.SegmentedGroup.Compact's own remarks above. Phase 6.2a: FontSize
         now Font.Size.Caption (M) instead of the fixed 11 DIP literal (§2.3's own allowlist: "подписи
         сегментов compact" is one of Font.Size.Caption's named consumers) — closes a T-3/T-4 finding. -->
    <Style x:Key="Settings.SegmentedItem.Compact" TargetType="RadioButton" BasedOn="{StaticResource Settings.SegmentedItem}">
        <Setter Property="Padding" Value="8,3"/>
        <Setter Property="FontSize" Value="{DynamicResource Font.Size.Caption}"/>
    </Style>
</ResourceDictionary>
