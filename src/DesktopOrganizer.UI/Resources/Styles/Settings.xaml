<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:conv="clr-namespace:DesktopOrganizer.UI.Converters"
                    xmlns:models="clr-namespace:DesktopOrganizer.UI.Models"
                    xmlns:loc="clr-namespace:DesktopOrganizer.UI.Localization">
    <!--
        Settings-window redesign (docs/prompts/settings-window-redesign.md, D-2/D-9). Merged app-wide by
        App.xaml.cs LoadResourceDictionaries() (after Controls.xaml): the section UserControls are created
        through DataTemplates and parsed BEFORE they join MainWindow's visual tree, so a Window-local merge
        is invisible to their StaticResource lookups (see SettingsSectionsInitializeTests).
        Palette: everything here uses Brush.Settings.* (light, system-styled window) — the dark Ambient
        Accent tokens (Brush.Surface.*/Brush.Text.*/Brush.Border.*/Brush.Overlay.*) belong to desktop panels.

        "Settings card" pattern (D-9): a Settings.CardBorder wrapping a two-column Grid — a left
        StackPanel with a Settings.CardHeader + Settings.CardDescription (the description replaces what
        used to be a ToolTip), and the actual control docked to the right column. Not every card fits a
        strict two-column shape (e.g. a slider-with-readout, a RadioButton group, or a list+toolbar) —
        those stack the description above the control instead, inside the same Settings.CardBorder.
    -->
    <conv:EnumToBooleanConverter x:Key="EnumToBoolean"/>
    <conv:EnumDisplayNameConverter x:Key="EnumDisplayName"/>
    <conv:NotBooleanConverter x:Key="NotBoolean"/>
    <BooleanToVisibilityConverter x:Key="BooleanToVisibility"/>
    <!-- Localization (docs/PLANS/localization.md §2.4/§4.5): declared here — the ONE place every
         Views/Settings/*.xaml UserControl already reaches through StaticResource — rather than once
         per section, per the "consumer declares its own converter instances" rule. -->
    <loc:LocKeyConverter x:Key="LocKey"/>
    <loc:PageDisplayNameConverter x:Key="PageDisplayName"/>

    <!-- ── Sidebar navigation ─────────────────────────────────────────────────────────────────── -->

    <DataTemplate x:Key="Settings.SidebarItemTemplate" DataType="{x:Type models:SettingsSectionInfo}">
        <StackPanel Orientation="Horizontal" Margin="2,0">
            <!-- Fallback font list (fix-cycle finding 12): "Segoe Fluent Icons" ships the same PUA glyph
                 codepoints on Windows 11 and is used if "Segoe MDL2 Assets" isn't installed, so a system
                 missing one of the two never renders these as an empty box. -->
            <TextBlock Text="{Binding Glyph}"
                       FontFamily="Segoe MDL2 Assets, Segoe Fluent Icons"
                       FontSize="14"
                       Width="20"
                       Margin="0,0,10,0"
                       VerticalAlignment="Center"
                       Foreground="{StaticResource Brush.Settings.IconMuted}"/>
            <TextBlock Text="{loc:LocBinding TitleKey, Converter={StaticResource LocKey}}" FontSize="12" VerticalAlignment="Center"/>
        </StackPanel>
    </DataTemplate>

    <!-- Shared chrome (hover/selected wash) for both the sidebar ListBoxItems and the standalone
         "About" ToggleButton pinned below them, so the two read as one continuous nav list. -->
    <Style x:Key="Settings.SidebarListBoxItem" TargetType="ListBoxItem">
        <Setter Property="Padding" Value="12,8"/>
        <Setter Property="Margin" Value="6,2"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="Chrome"
                            Background="Transparent"
                            CornerRadius="{StaticResource Radius.Control}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{StaticResource Brush.Settings.HoverOverlay}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{StaticResource Brush.Settings.TabActiveBackground}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Settings.SidebarListBox" TargetType="ListBox">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Disabled"/>
        <Setter Property="ItemContainerStyle" Value="{StaticResource Settings.SidebarListBoxItem}"/>
        <Setter Property="ItemTemplate" Value="{StaticResource Settings.SidebarItemTemplate}"/>
    </Style>

    <!-- The pinned "About" entry is a standalone ToggleButton (not a ListBox item): its IsChecked is a
         one-way reflection of SelectedSection == About, and clicking it always re-issues
         SelectSectionCommand — see MainWindow.xaml's remarks on why this is more robust here than a
         second one-item ListBox sharing SelectedValue with the first. -->
    <Style x:Key="Settings.SidebarAboutToggle" TargetType="ToggleButton">
        <Setter Property="Padding" Value="12,8"/>
        <Setter Property="Margin" Value="6,6"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="Chrome"
                            Background="{TemplateBinding Background}"
                            CornerRadius="{StaticResource Radius.Control}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{StaticResource Brush.Settings.HoverOverlay}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{StaticResource Brush.Settings.TabActiveBackground}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ── Section content ────────────────────────────────────────────────────────────────────── -->

    <Style x:Key="Settings.PageHeader" TargetType="TextBlock">
        <Setter Property="FontSize" Value="18"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource Brush.Settings.TextPrimary}"/>
        <Setter Property="Margin" Value="0,0,0,12"/>
    </Style>

    <Style x:Key="Settings.CardBorder" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource Brush.Settings.CardBackground}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Brush.Settings.CardBorder}"/>
        <Setter Property="BorderThickness" Value="{StaticResource Thickness.Hairline}"/>
        <Setter Property="CornerRadius" Value="{StaticResource Radius.Control}"/>
        <Setter Property="Padding" Value="14,12"/>
        <Setter Property="Margin" Value="0,0,0,10"/>
    </Style>

    <Style x:Key="Settings.CardHeader" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource Brush.Settings.TextPrimary}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>

    <Style x:Key="Settings.CardDescription" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="Foreground" Value="{StaticResource Brush.Settings.TextMuted}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="Margin" Value="0,4,0,0"/>
    </Style>

    <!-- Toggle-style CheckBox (D-9: "toggle для on/off"). Track/thumb colours come from the LIGHT
         Color.Settings.* tokens (Brushes.xaml) — never from the dark panel palette. -->
    <Style x:Key="Settings.ToggleCheckBox" TargetType="CheckBox">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Grid VerticalAlignment="Center" Width="36" Height="20">
                        <Border x:Name="Track"
                                CornerRadius="10"
                                Background="{StaticResource Brush.Settings.ToggleTrackOff}"/>
                        <Ellipse x:Name="Thumb"
                                 Width="14" Height="14"
                                 Fill="{StaticResource Brush.Settings.ToggleThumb}"
                                 HorizontalAlignment="Left"
                                 VerticalAlignment="Center"
                                 Margin="3,0,0,0"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Track" Property="Background" Value="{StaticResource Brush.Accent.Blue}"/>
                            <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right"/>
                            <Setter TargetName="Thumb" Property="Margin" Value="0,0,3,0"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Settings.RadioOption" TargetType="RadioButton">
        <Setter Property="Margin" Value="0,6,0,0"/>
        <Setter Property="Cursor" Value="Hand"/>
    </Style>

    <!-- Renders an enum value passed as a RadioButton/ComboBoxItem's Content through
         EnumDisplayNameConverter, so every enum-backed control in this window shows the same
         human-readable label instead of the raw C# member name. -->
    <DataTemplate x:Key="Settings.EnumRadioLabel">
        <TextBlock Text="{loc:LocBinding Converter={StaticResource EnumDisplayName}}" TextWrapping="Wrap"/>
    </DataTemplate>

    <!--
        ADR-042 "Segmented control" — a pill-shaped group of 2-3 mutually-exclusive RadioButtons (Mode
        Light/Dark, Surface Style Solid/Ambient/Glass, View List/Grid, Sort Manual/Name), replacing a plain
        RadioButton row/ComboBox wherever there are only 2-3 options. Container: a Settings.CardBorder-style
        hairline Border around a UniformGrid of Settings.SegmentedItem RadioButtons, sharing one GroupName
        per group (except the Mode group, which is VM-driven — see PanelColorEditor.xaml's own remarks).
        Keyboard (release-polish-1.0 review round, corrected): WPF's <c>RadioButton</c> does NOT check the
        newly-focused sibling on an arrow key by itself — arrow keys among same-<c>GroupName</c> siblings
        only move KEYBOARD FOCUS; the focused segment is only actually SELECTED once Space/Enter (or a
        click) fires it. Each segmented group's own <c>UniformGrid</c> sets
        <c>KeyboardNavigation.TabNavigation="Once"</c> (one Tab stop for the whole group) and
        <c>KeyboardNavigation.DirectionalNavigation="Contained"</c> (arrow keys cycle focus within the
        group, never escaping it to a sibling control) — no custom KeyDown handling needed for either.
    -->
    <Style x:Key="Settings.SegmentedGroup" TargetType="Border">
        <!-- A visible gray "track" (same translucent-black overlay token the sidebar/card hover states
             already use) is required so the SELECTED segment's white fill (Brush.Settings.TabActiveBackground,
             the same token the sidebar's own selected item uses) actually pops — without it, a white segment
             on a white Settings.CardBorder card would be invisible. -->
        <Setter Property="Background" Value="{StaticResource Brush.Settings.HoverOverlay}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Brush.Settings.CardBorder}"/>
        <Setter Property="BorderThickness" Value="{StaticResource Thickness.Hairline}"/>
        <Setter Property="CornerRadius" Value="{StaticResource Radius.Control}"/>
        <Setter Property="Padding" Value="2"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
    </Style>

    <!--
        Release-polish-1.0 visual review item 4: a Settings.CardBorder-styled Expander whose HEADER lives
        INSIDE the card (chevron + title + description), replacing the old shape of a bare Expander.Header
        floating above a separately-carded Content — that left the header with no card of its own and no
        consistent bottom margin against the next card. Retemplates Expander entirely: the outer Border IS
        the card (same Background/BorderBrush/BorderThickness/CornerRadius/Padding/Margin token values as
        Settings.CardBorder, copied rather than reused via BasedOn since Border and Expander share no common
        Style base), a borderless ToggleButton bound to IsExpanded hosts the header content (its own
        ContentPresenter's ContentSource="Header", so callers set Expander.Header to any title/description
        layout), and a chevron (Icon.Glyph.ChevronDown/Up, already declared in Icons.xaml) flips on
        IsChecked. The body ContentPresenter defaults to ContentSource="Content" (WPF's own
        HeaderedContentControl convention) and is only Visible while IsExpanded.
    -->
    <Style x:Key="Settings.CardExpander" TargetType="Expander">
        <!-- m3 (release-polish-1.0 review round): the Expander itself is not a tab stop — only its own
             HeaderToggle (below) is; this keeps Tab from landing on both the Expander AND its header
             ToggleButton as two separate stops for what a user perceives as ONE clickable header. -->
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Expander">
                    <Border Background="{StaticResource Brush.Settings.CardBackground}"
                            BorderBrush="{StaticResource Brush.Settings.CardBorder}"
                            BorderThickness="{StaticResource Thickness.Hairline}"
                            CornerRadius="{StaticResource Radius.Control}"
                            Padding="14,12"
                            Margin="0,0,0,10">
                        <StackPanel>
                            <ToggleButton x:Name="HeaderToggle"
                                          IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                          AutomationProperties.Name="{Binding Path=(AutomationProperties.Name), RelativeSource={RelativeSource TemplatedParent}}"
                                          Cursor="Hand"
                                          Background="Transparent"
                                          BorderThickness="0"
                                          Padding="0"
                                          HorizontalContentAlignment="Stretch">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="ToggleChrome" Background="Transparent" CornerRadius="{StaticResource Radius.Control}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock x:Name="Chevron" Grid.Column="0" Margin="0,2,10,0"
                                                           FontFamily="Segoe MDL2 Assets, Segoe Fluent Icons" FontSize="10"
                                                           VerticalAlignment="Top"
                                                           Foreground="{StaticResource Brush.Settings.IconMuted}"
                                                           Text="{StaticResource Icon.Glyph.ChevronDown}"/>
                                                <ContentPresenter Grid.Column="1" ContentSource="Content" VerticalAlignment="Top"/>
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="Chevron" Property="Text" Value="{StaticResource Icon.Glyph.ChevronUp}"/>
                                            </Trigger>
                                            <!-- m3: a hover state — this header was previously entirely
                                                 unresponsive to IsMouseOver, unlike every other clickable
                                                 Settings-card affordance (SegmentedItem, sidebar items). -->
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="ToggleChrome" Property="Background" Value="{StaticResource Brush.Settings.HoverOverlay}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                                <ContentPresenter ContentSource="Header"/>
                            </ToggleButton>
                            <ContentPresenter x:Name="ExpanderContent" Margin="0,10,0,0" Visibility="Collapsed"/>
                        </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsExpanded" Value="True">
                            <Setter TargetName="ExpanderContent" Property="Visibility" Value="Visible"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Settings.SegmentedItem" TargetType="RadioButton">
        <Setter Property="Padding" Value="10,5"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="Focusable" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Segment"
                            Background="Transparent"
                            CornerRadius="{StaticResource Radius.Control}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Segment" Property="Background" Value="{StaticResource Brush.Settings.HoverOverlay}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Segment" Property="Background" Value="{StaticResource Brush.Settings.TabActiveBackground}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Segment" Property="BorderBrush" Value="{StaticResource Brush.Border.Focus}"/>
                            <Setter TargetName="Segment" Property="BorderThickness" Value="1"/>
                        </Trigger>
                        <!-- M6 (release-polish-1.0 review round): a disabled segment (e.g. the Sort group
                             while the panel is a Folder Portal, PanelCustomizeWindow.xaml) previously had NO
                             visual cue at all — this template never referenced IsEnabled, so a disabled
                             RadioButton looked identical to an enabled one. -->
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
