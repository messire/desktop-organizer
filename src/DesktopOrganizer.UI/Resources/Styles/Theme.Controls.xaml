<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="clr-namespace:DesktopOrganizer.UI.Controls"
                    xmlns:loc="clr-namespace:DesktopOrganizer.UI.Localization">
    <!--
        Design-system-1x phase 6.2a (docs/PLANS/design-system-1x.md §2.5, ADR-047 D-1..D-8) — the "Palette
        T" (application chrome) control/style catalogue: everything the Settings window, Customize window,
        the app's WPF menus/tooltips, and the future dialog/InfoBar surfaces (6.3) share. Merged app-wide by
        App.xaml.cs LoadResourceDictionaries(), immediately after Settings.xaml (same relative position
        WpfApplicationHost/PanelCustomizeWindowClosingTests' own test merge lists now mirror) — every
        EXPLICIT (x:Key) style below is opt-in per consumer (Style="{StaticResource Theme.…}"), same
        convention Resources/Styles/Controls.xaml's own Control.* styles already use; nothing here is an
        implicit (TargetType-only) style, so merging this app-wide never touches a panel's own stock/Aero2
        controls (Theme.Implicit.xaml, 6.2a's sibling file, is what maps Theme.* onto implicit TargetType
        styles — and it is scoped to chrome Window.Resources, never Application.Resources — see that file's
        own remarks for why the split exists).

        Colours/typography/geometry all come from Theming/ThemeKeys.cs's Theme.*/Font.Size.*/Theme.Card.*/
        Theme.Radius.* keys (ADR-047 D-2..D-5) via {DynamicResource} — never a literal hex/FontSize (T-3).
        Palette P (panel) tokens/brushes are never referenced here (§0.2 boundary).
    -->

    <!-- Theme.FocusVisual itself lives in Resources/Styles/Controls.xaml, not here — see that file's own
         remarks (it is merged BEFORE this dictionary, and BEFORE Settings.xaml, whose Settings.SegmentedItem/
         .Compact also reference it via StaticResource; a StaticResource reference to a key that only exists
         in a LATER-merged sibling dictionary fails to resolve — this is why Theme.FocusVisual could not live
         here). Every Setter below still references it the same way. -->

    <!-- ══════════════════════════════════════════════════════════════════════════════════════════════
         Buttons (§2.5/§2.7, ADR-047 D-8): secondary (Theme.Button, the base every command-row button not
         otherwise called out uses), primary (Theme.Button.Primary — Accent fill, at most one per
         view/group per D-8), subtle (Theme.Button.Subtle — row actions, sidebar-adjacent commands), link
         (Theme.Button.Link — About's external links). All three variants replace Opacity-on-disable with
         Theme.Text.Disabled/Theme.Control.Disabled/Theme.Accent.Disabled tokens (D-6).
         ═══════════════════════════════════════════════════════════════════════════════════════════════ -->
    <Style x:Key="Theme.Button" TargetType="Button">
        <Setter Property="MinHeight" Value="{DynamicResource Theme.Control.MinHeight}"/>
        <Setter Property="Padding" Value="12,5"/>
        <Setter Property="FontSize" Value="{DynamicResource Font.Size.Body}"/>
        <Setter Property="Background" Value="{DynamicResource Theme.Control.Fill}"/>
        <Setter Property="Foreground" Value="{DynamicResource Theme.Text.Primary}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Theme.Stroke.Control}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource Theme.FocusVisual}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bg"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{DynamicResource Theme.Radius.Control}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                           VerticalAlignment="Center"
                                           Margin="{TemplateBinding Padding}"
                                           RecognizesAccessKey="True"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{DynamicResource Theme.Control.Hover}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{DynamicResource Theme.Control.Pressed}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bg" Property="Background" Value="{DynamicResource Theme.Control.Disabled}"/>
                            <Setter Property="Foreground" Value="{DynamicResource Theme.Text.Disabled}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Theme.Button.Primary" TargetType="Button" BasedOn="{StaticResource Theme.Button}">
        <Setter Property="Background" Value="{DynamicResource Theme.Accent.Fill}"/>
        <Setter Property="Foreground" Value="{DynamicResource Theme.Text.OnAccent}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bg" Background="{TemplateBinding Background}"
                            CornerRadius="{DynamicResource Theme.Radius.Control}" SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Margin="{TemplateBinding Padding}" RecognizesAccessKey="True"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{DynamicResource Theme.Accent.Hover}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{DynamicResource Theme.Accent.Pressed}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bg" Property="Background" Value="{DynamicResource Theme.Accent.Disabled}"/>
                            <Setter Property="Foreground" Value="{DynamicResource Theme.Text.Disabled}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Theme.Button.Subtle" TargetType="Button" BasedOn="{StaticResource Theme.Button}">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bg" Background="{TemplateBinding Background}"
                            CornerRadius="{DynamicResource Theme.Radius.Control}" SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Margin="{TemplateBinding Padding}" RecognizesAccessKey="True"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{DynamicResource Theme.Control.Subtle.Hover}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{DynamicResource Theme.Control.Subtle.Pressed}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource Theme.Text.Disabled}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- About's external links. Hover feedback is a Foreground colour shift (Accent.Fill -> Accent.Hover)
         rather than an underline: TextBlock.TextDecorations is not an inherited attached property, so a
         Trigger on this Style could not reach a nested implicit TextBlock's TextDecorations the way it can
         reach TextElement.Foreground (which IS inherited) — a real underline is left to whichever 6.2b
         consumer wants one on its own named TextBlock. -->
    <Style x:Key="Theme.Button.Link" TargetType="Button" BasedOn="{StaticResource Theme.Button.Subtle}">
        <Setter Property="Foreground" Value="{DynamicResource Theme.Accent.Fill}"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="Transparent">
                        <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource Theme.Accent.Hover}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource Theme.Text.Disabled}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ══════════════════════════════════════════════════════════════════════════════════════════════
         DropDownButton (§2.5/§2.7): Controls/DropDownButton.cs's default style — the "[Ещё ▾]" control.
         ═══════════════════════════════════════════════════════════════════════════════════════════════ -->
    <!-- Not BasedOn="{StaticResource Theme.Button}": Theme.Button's TargetType is Button, which is a
         SIBLING of ToggleButton (both derive ButtonBase directly) — WPF's Style.Seal() rejects a BasedOn
         style whose own TargetType is not a base type of the derived style's TargetType, so every Setter
         Theme.Button declares is duplicated here instead. -->
    <Style TargetType="{x:Type controls:DropDownButton}">
        <Setter Property="MinHeight" Value="{DynamicResource Theme.Control.MinHeight}"/>
        <Setter Property="Padding" Value="12,5"/>
        <Setter Property="FontSize" Value="{DynamicResource Font.Size.Body}"/>
        <Setter Property="Background" Value="{DynamicResource Theme.Control.Fill}"/>
        <Setter Property="Foreground" Value="{DynamicResource Theme.Text.Primary}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Theme.Stroke.Control}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource Theme.FocusVisual}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:DropDownButton}">
                    <Border x:Name="Bg"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{DynamicResource Theme.Radius.Control}"
                            SnapsToDevicePixels="True">
                        <StackPanel Orientation="Horizontal" Margin="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center" RecognizesAccessKey="True"/>
                            <!-- UX-MEDIUM fix (6.5 review round): x:Name="Chevron" + the IsEnabled/ShowChevron
                                 triggers below let Theme.Button.Overflow collapse this glyph entirely for
                                 consumers whose own Content is already an overflow ("⋯") glyph — see
                                 DropDownButton.ShowChevron's own remarks. -->
                            <TextBlock x:Name="Chevron"
                                       Text="{StaticResource Icon.Glyph.ChevronDown}"
                                       FontFamily="Segoe MDL2 Assets, Segoe Fluent Icons"
                                       FontSize="10"
                                       Margin="8,0,0,0"
                                       VerticalAlignment="Center"
                                       Foreground="{TemplateBinding Foreground}"/>
                        </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{DynamicResource Theme.Control.Hover}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{DynamicResource Theme.Control.Pressed}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bg" Property="Background" Value="{DynamicResource Theme.Control.Disabled}"/>
                            <Setter Property="Foreground" Value="{DynamicResource Theme.Text.Disabled}"/>
                        </Trigger>
                        <Trigger Property="ShowChevron" Value="False">
                            <Setter TargetName="Chevron" Property="Visibility" Value="Collapsed"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- UX-MEDIUM fix (6.5 review round): derived style for the per-row "⋯" overflow buttons
         (PagesSection.Pages.RowMoreButton, BackupSection.Backup.RowMoreButton) — their own Content IS
         already the conventional Win11 "more actions" glyph, so the base style's trailing chevron next to
         it read as a redundant, confusing second "this opens something" affordance instead of the single
         already-established "⋯ opens a menu" convention. BasedOn the DropDownButton style itself (not
         Theme.Button — see that style's own remarks on why it can't be) — ShowChevron="False" is the only
         difference. -->
    <Style x:Key="Theme.Button.Overflow" TargetType="{x:Type controls:DropDownButton}" BasedOn="{StaticResource {x:Type controls:DropDownButton}}">
        <Setter Property="ShowChevron" Value="False"/>
    </Style>

    <!-- ══════════════════════════════════════════════════════════════════════════════════════════════
         SettingsCard (§2.5): Controls/SettingsCard.cs's default style — the Header/Description/
         ActionContent/Content templated-control replacement for the ~35 hand-rolled Border+Grid+
         StackPanel card blocks (follow-up DO-026). Geometry from Theme.Card.Padding/Theme.Radius.Card
         (ADR-047 D-5) rather than Settings.CardBorder's pre-6.2a 14,12/Radius.Control (Palette P) literals.
         ═══════════════════════════════════════════════════════════════════════════════════════════════ -->
    <Style TargetType="{x:Type controls:SettingsCard}">
        <Setter Property="Background" Value="{DynamicResource Theme.Surface.Card}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Theme.Stroke.Card}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="{DynamicResource Theme.Card.Padding}"/>
        <Setter Property="Margin" Value="0,0,0,4"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:SettingsCard}">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{DynamicResource Theme.Radius.Card}"
                            Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <!-- Header/Description force a TextBlock-shaped ContentTemplate (rather
                                         than TextBlock.* attached-property Setters on the ContentPresenter
                                         itself) for two reasons: (1) TextWrapping is a plain instance DP on
                                         TextBlock, not one TextElement/TextBlock exposes as an inheritable
                                         attached property the way FontSize/FontWeight/Foreground are, so it
                                         cannot be set this way at all; (2) folding all four properties into
                                         one explicit DataTemplate keeps Header/Description's visual shape
                                         identical to the pre-6.2a Settings.CardHeader/CardDescription
                                         TextBlock styles they replace — both are documented (SettingsCard.cs)
                                         to hold a plain string. -->
                                    <ContentPresenter x:Name="HeaderHost" ContentSource="Header">
                                        <ContentPresenter.ContentTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding}"
                                                           TextWrapping="Wrap"
                                                           FontSize="{DynamicResource Font.Size.Body}"
                                                           FontWeight="SemiBold"
                                                           Foreground="{DynamicResource Theme.Text.Primary}"/>
                                            </DataTemplate>
                                        </ContentPresenter.ContentTemplate>
                                    </ContentPresenter>
                                    <ContentPresenter ContentSource="Description" Margin="0,4,0,0">
                                        <ContentPresenter.ContentTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding}"
                                                           TextWrapping="Wrap"
                                                           FontSize="{DynamicResource Font.Size.Caption}"
                                                           Foreground="{DynamicResource Theme.Text.Secondary}"/>
                                            </DataTemplate>
                                        </ContentPresenter.ContentTemplate>
                                    </ContentPresenter>
                                </StackPanel>
                                <!-- AutomationProperties.LabeledBy points at HeaderHost (§2.5: "ActionContent
                                     получает AutomationProperties.LabeledBy на заголовок") so a screen reader
                                     announces the card's own title before its action control. -->
                                <ContentPresenter Grid.Column="1"
                                                   ContentSource="ActionContent"
                                                   Margin="12,0,0,0"
                                                   VerticalAlignment="Center"
                                                   AutomationProperties.LabeledBy="{Binding ElementName=HeaderHost}"/>
                            </Grid>
                            <ContentPresenter x:Name="BodyHost" Margin="0,10,0,0"/>
                        </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <!-- Not every card has a body (list+toolbar, slider-with-readout, etc.) — collapse
                             the row entirely rather than reserve a permanent 10 DIP gap for nothing. -->
                        <Trigger Property="Content" Value="{x:Null}">
                            <Setter TargetName="BodyHost" Property="Visibility" Value="Collapsed"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ══════════════════════════════════════════════════════════════════════════════════════════════
         InfoBar (§2.5/§2.8): Controls/InfoBar.cs's default style. Hosted in MainWindow.xaml above its
         content ScrollViewer, bound to MainWindowViewModel.Status (IStatusNotifier/SettingsStatusNotifier,
         phase 6.3).

         Wave-4 review round (UX MINOR): adds a leading severity glyph (the same Icon.Glyph.* set
         AppDialogWindow's own severity glyph already uses, plus Icon.Glyph.Success — InfoBar has no
         Question-equivalent severity, but does have one AppDialogWindow doesn't) and colours the TITLE
         line — never the body Message, which stays Theme.Text.Primary regardless of severity, matching
         AppDialogWindow's own MessageText — Theme.Text.{Success,Caution,Critical} to match; Informational
         keeps Theme.Text.Primary (the TemplateBinding default below, no trigger needed). Critical also
         raises AutomationProperties.LiveSetting to Assertive (from the base Polite Setter above): a
         failure the user must notice should interrupt Narrator's current speech instead of politely
         queuing behind it.
         ═══════════════════════════════════════════════════════════════════════════════════════════════ -->
    <Style TargetType="{x:Type controls:InfoBar}">
        <Setter Property="Background" Value="{DynamicResource Theme.InfoBar.Info.Background}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Theme.Stroke.Card}"/>
        <Setter Property="Foreground" Value="{DynamicResource Theme.Text.Primary}"/>
        <Setter Property="Padding" Value="{DynamicResource Theme.Card.Padding}"/>
        <Setter Property="FontSize" Value="{DynamicResource Font.Size.Body}"/>
        <Setter Property="AutomationProperties.LiveSetting" Value="Polite"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:InfoBar}">
                    <Border x:Name="Bg"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="{DynamicResource Theme.Radius.Card}"
                            Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="GlyphText"
                                       Grid.Column="0"
                                       Text="{StaticResource Icon.Glyph.Info}"
                                       FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                       FontSize="{DynamicResource Font.Size.Title}"
                                       Foreground="{DynamicResource Theme.Text.Primary}"
                                       VerticalAlignment="Top"
                                       Margin="0,0,10,0"/>
                            <StackPanel Grid.Column="1">
                                <TextBlock x:Name="TitleText"
                                           Text="{TemplateBinding Title}"
                                           FontSize="{DynamicResource Font.Size.BodyStrong}"
                                           FontWeight="SemiBold"
                                           Foreground="{TemplateBinding Foreground}"
                                           TextWrapping="Wrap"/>
                                <TextBlock Text="{TemplateBinding Message}"
                                           FontSize="{DynamicResource Font.Size.Body}"
                                           Foreground="{TemplateBinding Foreground}"
                                           Margin="0,2,0,0"
                                           TextWrapping="Wrap"/>
                            </StackPanel>
                            <Button Grid.Column="2"
                                    Style="{StaticResource Theme.Button.Subtle}"
                                    Command="{TemplateBinding CloseCommand}"
                                    Content="{StaticResource Icon.Glyph.Close}"
                                    AutomationProperties.Name="{loc:Loc Common_Close_A11y}"
                                    FontFamily="Segoe MDL2 Assets, Segoe Fluent Icons"
                                    Padding="4"
                                    MinHeight="0"
                                    VerticalAlignment="Top"
                                    Margin="8,0,0,0"/>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Severity" Value="Success">
                            <Setter TargetName="Bg" Property="Background" Value="{DynamicResource Theme.InfoBar.Success.Background}"/>
                            <Setter TargetName="TitleText" Property="Foreground" Value="{DynamicResource Theme.Text.Success}"/>
                            <Setter TargetName="GlyphText" Property="Text" Value="{StaticResource Icon.Glyph.Success}"/>
                        </Trigger>
                        <Trigger Property="Severity" Value="Caution">
                            <Setter TargetName="Bg" Property="Background" Value="{DynamicResource Theme.InfoBar.Caution.Background}"/>
                            <Setter TargetName="TitleText" Property="Foreground" Value="{DynamicResource Theme.Text.Caution}"/>
                            <Setter TargetName="GlyphText" Property="Text" Value="{StaticResource Icon.Glyph.Warning}"/>
                        </Trigger>
                        <Trigger Property="Severity" Value="Critical">
                            <Setter TargetName="Bg" Property="Background" Value="{DynamicResource Theme.InfoBar.Critical.Background}"/>
                            <Setter TargetName="TitleText" Property="Foreground" Value="{DynamicResource Theme.Text.Critical}"/>
                            <Setter TargetName="GlyphText" Property="Text" Value="{StaticResource Icon.Glyph.Error}"/>
                            <Setter Property="AutomationProperties.LiveSetting" Value="Assertive"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ══════════════════════════════════════════════════════════════════════════════════════════════
         Toggle switch (H-3 fix): replaces Resources/Styles/Settings.xaml's pre-6.2a Settings.ToggleCheckBox
         (removed in the same commit, consumers renamed to this key) — own FocusVisualStyle, disabled via
         Theme.Control.Disabled/Theme.Text.Disabled tokens (not Opacity), checked track now
         Theme.Accent.Fill (DynamicResource) instead of the theme-independent Brush.Accent.Blue the old
         style used (a Palette-P-adjacent fixed brush that never should have painted Palette T chrome).
         ═══════════════════════════════════════════════════════════════════════════════════════════════ -->
    <Style x:Key="Theme.ToggleSwitch" TargetType="CheckBox">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource Theme.FocusVisual}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Grid VerticalAlignment="Center" Width="36" Height="20">
                        <Border x:Name="Track"
                                CornerRadius="10"
                                Background="{DynamicResource Theme.Stroke.Input}"/>
                        <Ellipse x:Name="Thumb"
                                 Width="14" Height="14"
                                 Fill="{DynamicResource Theme.Control.Fill}"
                                 HorizontalAlignment="Left"
                                 VerticalAlignment="Center"
                                 Margin="3,0,0,0"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Track" Property="Background" Value="{DynamicResource Theme.Accent.Fill}"/>
                            <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right"/>
                            <Setter TargetName="Thumb" Property="Margin" Value="0,0,3,0"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Track" Property="Background" Value="{DynamicResource Theme.Control.Disabled}"/>
                            <Setter TargetName="Thumb" Property="Fill" Value="{DynamicResource Theme.Text.Disabled}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ══════════════════════════════════════════════════════════════════════════════════════════════
         CheckBox / RadioButton — explicit Theme.* keys for chrome-window consumers (e.g. the System icons
         section's visibility list). Theme.Implicit.xaml (sibling file) is what makes these the app-wide
         default for CheckBox/RadioButton inside a chrome Window's own Window.Resources.
         ═══════════════════════════════════════════════════════════════════════════════════════════════ -->
    <Style x:Key="Theme.CheckBox" TargetType="CheckBox">
        <Setter Property="Foreground" Value="{DynamicResource Theme.Text.Primary}"/>
        <Setter Property="FontSize" Value="{DynamicResource Font.Size.Body}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource Theme.FocusVisual}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border x:Name="Box" Grid.Column="0" Width="16" Height="16" VerticalAlignment="Center"
                                CornerRadius="3" BorderThickness="1"
                                BorderBrush="{DynamicResource Theme.Stroke.Input}"
                                Background="{DynamicResource Theme.Control.Fill}">
                            <TextBlock x:Name="Glyph"
                                       Text="{StaticResource Icon.Glyph.Checkmark}"
                                       FontFamily="Segoe MDL2 Assets, Segoe Fluent Icons"
                                       FontSize="10"
                                       Foreground="{DynamicResource Theme.Text.OnAccent}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Visibility="Collapsed"/>
                        </Border>
                        <ContentPresenter Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Box" Property="Background" Value="{DynamicResource Theme.Accent.Fill}"/>
                            <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource Theme.Accent.Fill}"/>
                            <Setter TargetName="Glyph" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource Theme.Text.Disabled}"/>
                            <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource Theme.Text.Disabled}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Theme.RadioButton" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{DynamicResource Theme.Text.Primary}"/>
        <Setter Property="FontSize" Value="{DynamicResource Font.Size.Body}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource Theme.FocusVisual}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border x:Name="Circle" Grid.Column="0" Width="16" Height="16" VerticalAlignment="Center"
                                CornerRadius="8" BorderThickness="1"
                                BorderBrush="{DynamicResource Theme.Stroke.Input}"
                                Background="{DynamicResource Theme.Control.Fill}">
                            <Ellipse x:Name="Dot" Width="8" Height="8" Fill="{DynamicResource Theme.Text.OnAccent}" Visibility="Collapsed"/>
                        </Border>
                        <ContentPresenter Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Circle" Property="Background" Value="{DynamicResource Theme.Accent.Fill}"/>
                            <Setter TargetName="Circle" Property="BorderBrush" Value="{DynamicResource Theme.Accent.Fill}"/>
                            <Setter TargetName="Dot" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource Theme.Text.Disabled}"/>
                            <Setter TargetName="Circle" Property="BorderBrush" Value="{DynamicResource Theme.Text.Disabled}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ══════════════════════════════════════════════════════════════════════════════════════════════
         ComboBox — standard "ToggleButton + Popup + ItemsPresenter" custom-template recipe, restyled onto
         Theme.* tokens (Aero2's own ComboBox chrome never followed a dark theme).
         ═══════════════════════════════════════════════════════════════════════════════════════════════ -->
    <Style x:Key="Theme.ComboBoxItem" TargetType="ComboBoxItem">
        <Setter Property="Padding" Value="8,6"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border x:Name="Bg" Background="Transparent" CornerRadius="{DynamicResource Theme.Radius.Control}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{DynamicResource Theme.Control.Subtle.Hover}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{DynamicResource Theme.Selection.Fill}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Theme.ComboBox" TargetType="ComboBox">
        <Setter Property="MinHeight" Value="{DynamicResource Theme.Control.MinHeight}"/>
        <Setter Property="Padding" Value="10,5"/>
        <Setter Property="FontSize" Value="{DynamicResource Font.Size.Body}"/>
        <Setter Property="Foreground" Value="{DynamicResource Theme.Text.Primary}"/>
        <Setter Property="Background" Value="{DynamicResource Theme.Control.Fill}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Theme.Stroke.Input}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource Theme.FocusVisual}"/>
        <Setter Property="ItemContainerStyle" Value="{StaticResource Theme.ComboBoxItem}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <ToggleButton x:Name="Toggle"
                                      IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                      Focusable="False" ClickMode="Press">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border Background="{Binding Background, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                            BorderBrush="{Binding BorderBrush, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                            BorderThickness="{Binding BorderThickness, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                            CornerRadius="{DynamicResource Theme.Radius.Control}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="1" Margin="0,0,10,0"
                                                       Text="{StaticResource Icon.Glyph.ChevronDown}"
                                                       FontFamily="Segoe MDL2 Assets, Segoe Fluent Icons"
                                                       FontSize="10"
                                                       Foreground="{DynamicResource Theme.Text.Secondary}"
                                                       VerticalAlignment="Center"/>
                                        </Grid>
                                    </Border>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>
                        <!-- Template, selector AND string format, the way the stock Aero2 template does: a
                             ComboBox using DisplayMemberPath (GeneralSection's language picker) delivers it
                             through ItemTemplateSelector (an internal DisplayMemberTemplateSelector), not
                             through SelectionBoxItemTemplate — without the selector binding the closed box
                             fell back to ToString() and showed "DesktopOrganizer.UI.Models.LanguageOption".
                             ComboBox has no SelectionBoxItemTemplateSelector (only RibbonComboBox does), so
                             ItemTemplateSelector is the one to bind. -->
                        <ContentPresenter x:Name="ContentSite" IsHitTestVisible="False"
                                           Content="{TemplateBinding SelectionBoxItem}"
                                           ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                           ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                           ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"
                                           Margin="{TemplateBinding Padding}"
                                           HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        <Popup x:Name="PART_Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}"
                               AllowsTransparency="True" Focusable="False" PopupAnimation="Slide">
                            <Border Background="{DynamicResource Theme.Surface.Flyout}"
                                    BorderBrush="{DynamicResource Theme.Stroke.Card}" BorderThickness="1"
                                    CornerRadius="{DynamicResource Theme.Radius.Popup}" Padding="4"
                                    MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                    SnapsToDevicePixels="True">
                                <ScrollViewer CanContentScroll="True" MaxHeight="300">
                                    <ItemsPresenter/>
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource Theme.Text.Disabled}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ══════════════════════════════════════════════════════════════════════════════════════════════
         TextBox — Win11-style underline field (focus thickens the underline to Theme.Accent.Fill, no
         separate ring): FocusVisualStyle is intentionally null here, the one deliberate Theme.FocusVisual
         exception, since the underline IS this control's own focus indicator.

         Wave-4 review round (UX MINOR): SelectionBrush/SelectionTextBrush were previously unset, so a
         selected run of text fell back to the OS accent-colour highlight — never verified against
         Theme.Control.Fill in Dark, and with no contrast guarantee at all. Theme.Selection.Fill/Text is
         the same pairing ThemePaletteContrastTests' own SelectionText_MeetsTextContrast_OnSelectionFill
         already holds to the 4.5:1 text floor in both themes.
         ═══════════════════════════════════════════════════════════════════════════════════════════════ -->
    <Style x:Key="Theme.TextBox" TargetType="TextBox">
        <Setter Property="MinHeight" Value="{DynamicResource Theme.Control.MinHeight}"/>
        <Setter Property="Padding" Value="8,5"/>
        <Setter Property="FontSize" Value="{DynamicResource Font.Size.Body}"/>
        <Setter Property="Foreground" Value="{DynamicResource Theme.Text.Primary}"/>
        <Setter Property="Background" Value="{DynamicResource Theme.Control.Fill}"/>
        <Setter Property="CaretBrush" Value="{DynamicResource Theme.Text.Primary}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Theme.Stroke.Input}"/>
        <Setter Property="BorderThickness" Value="0,0,0,1"/>
        <Setter Property="SelectionBrush" Value="{DynamicResource Theme.Selection.Fill}"/>
        <Setter Property="SelectionTextBrush" Value="{DynamicResource Theme.Selection.Text}"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="Bg" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{DynamicResource Theme.Radius.Control}" SnapsToDevicePixels="True">
                        <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bg" Property="BorderBrush" Value="{DynamicResource Theme.Accent.Fill}"/>
                            <Setter TargetName="Bg" Property="BorderThickness" Value="0,0,0,2"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bg" Property="Background" Value="{DynamicResource Theme.Control.Disabled}"/>
                            <Setter Property="Foreground" Value="{DynamicResource Theme.Text.Disabled}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ══════════════════════════════════════════════════════════════════════════════════════════════
         Slider — track/fill/thumb on Theme.Stroke.Input/Theme.Accent.Fill.
         ═══════════════════════════════════════════════════════════════════════════════════════════════ -->
    <Style x:Key="Theme.Slider" TargetType="Slider">
        <Setter Property="FocusVisualStyle" Value="{StaticResource Theme.FocusVisual}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Slider">
                    <Grid VerticalAlignment="Center">
                        <Border Height="4" Background="{DynamicResource Theme.Stroke.Input}" CornerRadius="2" VerticalAlignment="Center"/>
                        <Track x:Name="PART_Track">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="Slider.DecreaseLarge">
                                    <RepeatButton.Template>
                                        <ControlTemplate TargetType="RepeatButton">
                                            <Border Height="4" Background="{DynamicResource Theme.Accent.Fill}" CornerRadius="2" VerticalAlignment="Center"/>
                                        </ControlTemplate>
                                    </RepeatButton.Template>
                                </RepeatButton>
                            </Track.DecreaseRepeatButton>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="Slider.IncreaseLarge">
                                    <RepeatButton.Template>
                                        <ControlTemplate TargetType="RepeatButton">
                                            <Border Background="Transparent"/>
                                        </ControlTemplate>
                                    </RepeatButton.Template>
                                </RepeatButton>
                            </Track.IncreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb>
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Ellipse Width="16" Height="16" Fill="{DynamicResource Theme.Accent.Fill}"
                                                     Stroke="{DynamicResource Theme.Control.Fill}" StrokeThickness="2"/>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ══════════════════════════════════════════════════════════════════════════════════════════════
         ScrollBar — a thin Win11-style bar for chrome windows, DISTINCT from Resources/Styles/Controls.xaml's
         Control.ScrollBar.Overlay (Palette P, panels only — never touched here).
         ═══════════════════════════════════════════════════════════════════════════════════════════════ -->
    <Style x:Key="Theme.ScrollBar.Thumb" TargetType="Thumb">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border Background="{DynamicResource Theme.Stroke.Input}" CornerRadius="4" Margin="4,0"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Theme.ScrollBar" TargetType="ScrollBar">
        <Setter Property="Width" Value="14"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Track x:Name="PART_Track" IsDirectionReversed="True">
                        <Track.DecreaseRepeatButton>
                            <RepeatButton Command="ScrollBar.PageUpCommand" IsTabStop="False" Focusable="False">
                                <RepeatButton.Template>
                                    <ControlTemplate TargetType="RepeatButton">
                                        <Border Background="Transparent"/>
                                    </ControlTemplate>
                                </RepeatButton.Template>
                            </RepeatButton>
                        </Track.DecreaseRepeatButton>
                        <Track.IncreaseRepeatButton>
                            <RepeatButton Command="ScrollBar.PageDownCommand" IsTabStop="False" Focusable="False">
                                <RepeatButton.Template>
                                    <ControlTemplate TargetType="RepeatButton">
                                        <Border Background="Transparent"/>
                                    </ControlTemplate>
                                </RepeatButton.Template>
                            </RepeatButton>
                        </Track.IncreaseRepeatButton>
                        <Track.Thumb>
                            <Thumb Style="{StaticResource Theme.ScrollBar.Thumb}" MinHeight="24"/>
                        </Track.Thumb>
                    </Track>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ══════════════════════════════════════════════════════════════════════════════════════════════
         ListBox / ListView — BackupSection's ListView+GridView (S-8), the System icons visibility list.
         ═══════════════════════════════════════════════════════════════════════════════════════════════ -->
    <!-- Selected state = fill + a 3 DIP accent "Indicator" bar, the same shape Settings.SidebarListBoxItem
         uses and for the same reason (6.1 S-1, ADR-047 D-2/D-6): Theme.Selection.Fill alone is white-on-
         white in Light, so the Panels list's selected row was indistinguishable from its neighbours. The
         Foreground swap to Theme.Selection.Text is the High Contrast pairing for a Highlight fill. -->
    <Style x:Key="Theme.ListBoxItem" TargetType="ListBoxItem">
        <Setter Property="Padding" Value="8,6"/>
        <Setter Property="Foreground" Value="{DynamicResource Theme.Text.Primary}"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource Theme.FocusVisual}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Grid>
                        <Border x:Name="Bg" Background="Transparent" CornerRadius="{DynamicResource Theme.Radius.Control}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <Border x:Name="Indicator" Width="3" Margin="0,4" HorizontalAlignment="Left"
                                CornerRadius="2" Background="Transparent"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{DynamicResource Theme.Control.Subtle.Hover}"/>
                            <Setter Property="Foreground" Value="{DynamicResource Theme.Selection.Text}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{DynamicResource Theme.Selection.Fill}"/>
                            <Setter TargetName="Indicator" Property="Background" Value="{DynamicResource Theme.Selection.Indicator}"/>
                            <Setter Property="Foreground" Value="{DynamicResource Theme.Selection.Text}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ListView + GridView rows need a GridViewRowPresenter, not a ContentPresenter: the latter ignores the
         GridView's column CellTemplates and renders the row item's ToString() — BackupSection's snapshot
         list showed "DesktopOrganizer.Core.LayoutSnapshot" in every row while Theme.ListView reused
         Theme.ListBoxItem. Same selection chrome as Theme.ListBoxItem above. -->
    <Style x:Key="Theme.ListViewItem" TargetType="ListViewItem">
        <Setter Property="Padding" Value="8,6"/>
        <Setter Property="Foreground" Value="{DynamicResource Theme.Text.Primary}"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource Theme.FocusVisual}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListViewItem">
                    <Grid>
                        <Border x:Name="Bg" Background="Transparent" CornerRadius="{DynamicResource Theme.Radius.Control}"
                                Padding="{TemplateBinding Padding}">
                            <GridViewRowPresenter Content="{TemplateBinding Content}"
                                                  Columns="{TemplateBinding GridView.ColumnCollection}"
                                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Border>
                        <Border x:Name="Indicator" Width="3" Margin="0,4" HorizontalAlignment="Left"
                                CornerRadius="2" Background="Transparent"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{DynamicResource Theme.Control.Subtle.Hover}"/>
                            <Setter Property="Foreground" Value="{DynamicResource Theme.Selection.Text}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{DynamicResource Theme.Selection.Fill}"/>
                            <Setter TargetName="Indicator" Property="Background" Value="{DynamicResource Theme.Selection.Indicator}"/>
                            <Setter Property="Foreground" Value="{DynamicResource Theme.Selection.Text}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Theme.ListBox" TargetType="ListBox">
        <Setter Property="Background" Value="{DynamicResource Theme.Surface.Card}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Theme.Stroke.Card}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="ItemContainerStyle" Value="{StaticResource Theme.ListBoxItem}"/>
    </Style>

    <Style x:Key="Theme.GridViewColumnHeader" TargetType="GridViewColumnHeader">
        <Setter Property="Background" Value="{DynamicResource Theme.Surface.Card}"/>
        <Setter Property="Foreground" Value="{DynamicResource Theme.Text.Secondary}"/>
        <Setter Property="FontSize" Value="{DynamicResource Font.Size.Caption}"/>
        <Setter Property="Padding" Value="8,6"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="GridViewColumnHeader">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{DynamicResource Theme.Stroke.Divider}" BorderThickness="0,0,0,1"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Theme.ListView" TargetType="ListView">
        <Setter Property="Background" Value="{DynamicResource Theme.Surface.Card}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Theme.Stroke.Card}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="ItemContainerStyle" Value="{StaticResource Theme.ListViewItem}"/>
    </Style>
</ResourceDictionary>
