<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:uimodels="clr-namespace:DesktopOrganizer.UI.Models"
                    xmlns:conv="clr-namespace:DesktopOrganizer.UI.Converters"
                    xmlns:behaviors="clr-namespace:DesktopOrganizer.UI.Behaviors"
                    xmlns:controls="clr-namespace:DesktopOrganizer.UI.Controls"
                    xmlns:models="clr-namespace:DesktopOrganizer.Core;assembly=DesktopOrganizer.Core">

    <conv:HexBrushConverter x:Key="HexBrush"/>
    <conv:ColorOpacityBrushConverter x:Key="ColorOpacityBrush"/>
    <conv:EqualityToBoolConverter x:Key="EqualityToBool"/>
    <conv:EnumEqualsConverter x:Key="EnumEquals"/>
    <conv:BoolToGlyphConverter x:Key="RollUpGlyph"/>
    <conv:BoolToGlyphConverter x:Key="RollUpTooltip"/>
    <conv:SortModeTooltipConverter x:Key="SortModeTooltip"/>
    <conv:ViewModeGlyphConverter x:Key="ViewModeGlyph"/>
    <conv:IconBoxWidthConverter x:Key="IconBoxWidth"/>

    <!--
        Shared "selected/active" chrome tokens (finalization MINOR m-1) moved to
        Resources/Styles/Brushes.xaml as of C5 (D-2) — same key names (SelectionFillBrush/
        SelectionStrokeBrush), still consumed here by FileNameEditBoxStyle below and by
        Resources/Styles/Controls.xaml's PanelHeaderToggleButtonStyle (moved there in the same
        commit). The move was forced by merge order (D-1): PanelHeaderToggleButtonStyle now lives in
        a dictionary merged BEFORE this one, and StaticResource only resolves backwards along the
        merge order, so the brushes could no longer stay declared here.
    -->

    <!--
        A file item has no WPF context menu of its own: right-click shows the native Windows shell menu
        for the file (ChildWindow.FileListHost_PreviewMouseRightButtonUp -> ChildWindowViewModel.
        ShowShellContextMenu -> IFileLauncher.ShowContextMenu), the same menu Explorer shows. Removing an
        item from a panel is a drag-out (ADR-036); F2 starts the inline rename.
    -->

    <!-- Greys out items whose file/folder no longer exists on disk. TargetType="Panel" (not
         "StackPanel") since UX-P2 fix (docs/PLANS/workspace-grid-07-visual.md fix-cycle 1): List mode's
         item root switched from StackPanel to Grid so its label can actually truncate with an ellipsis
         (see ListViewTemplate below) — a Style's TargetType must be the element's own type or a base of
         it, and Panel is the common base both StackPanel (GridViewTemplate's own item root, unchanged)
         and Grid (ListViewTemplate's new item root) share; none of this Style's Setters
         (Background/Opacity) are StackPanel-specific. -->
    <Style x:Key="FileItemRootStyle" TargetType="Panel">
        <Setter Property="Background" Value="Transparent"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding Exists}" Value="False">
                <Setter Property="Opacity" Value="0.45"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!--
        PanelHeaderButtonStyle/PanelHeaderToggleButtonStyle/PanelItemContainerStyle moved out of this
        file as of C5 (D-2): the first two to Resources/Styles/Controls.xaml, the last (the "item
        container" D-1 names for it) to Resources/Styles/Panels.xaml. All three keep their exact
        original key names — nothing below or in ChildWindow.xaml/SystemIconsPanelWindow.xaml needed to
        change its own StaticResource reference for the move, since StaticResource resolves against the
        fully-merged Application.Resources regardless of which dictionary declares a key. (A fourth
        style, ResizeThumbStyle, moved here alongside them in C5 but was later deleted as dead code in
        d16aab6 — MINOR fix, fix-cycle round 2: this comment previously still counted it among the four.)
    -->

    <!--
        Inline-rename editor visibility (ADR-013 Decision 6): the display TextBlock and the edit
        TextBox for a given item toggle in lockstep with whether that item is
        ChildWindowViewModel.EditingItem. Reuses the same MultiBinding + EqualityToBoolConverter
        pattern already used for the active-page tab in MainWindow.xaml — a plain DataTrigger Setter
        writes Visibility directly, so no separate bool->Visibility converter is needed.
    -->
    <Style x:Key="FileNameTextStyle" TargetType="TextBlock">
        <Style.Triggers>
            <DataTrigger Value="True">
                <DataTrigger.Binding>
                    <MultiBinding Converter="{StaticResource EqualityToBool}">
                        <Binding/>
                        <Binding Path="DataContext.EditingItem" RelativeSource="{RelativeSource AncestorType=Window}"/>
                    </MultiBinding>
                </DataTrigger.Binding>
                <Setter Property="Visibility" Value="Collapsed"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!--
        Dark, semi-transparent chrome for the inline-rename editor so it reads as part of the panel
        instead of a stock white system TextBox. Foreground/CaretBrush reuse the same
        DataContext.Model.TextColor + HexBrush pattern as the sibling display TextBlock (see
        FileNameTextStyle above and the ListView/GridView DataTemplates below); Border/SelectionBrush
        reuse the shared SelectionFillBrush/SelectionStrokeBrush resources (finalization MINOR m-1,
        Resources/Styles/Brushes.xaml as of C5) also used by Controls.xaml's
        PanelHeaderToggleButtonStyle, so the editor's chrome stays visually consistent with that same
        fixed-blue "selected/active" language elsewhere in the app. As of C5, Panels.xaml's
        PanelItemContainerStyle no longer uses these two brushes for its own selected-item chrome — it
        reads the panel's PanelTheme.Accent instead (see that Style's remarks) — so this editor's
        border/selection colour and the container behind it are no longer the exact same pixels, only
        the same visual family.
    -->
    <Style x:Key="FileNameEditBoxStyle" TargetType="TextBox">
        <Setter Property="Visibility" Value="Collapsed"/>
        <Setter Property="Foreground" Value="{Binding DataContext.Model.TextColor, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource HexBrush}}"/>
        <Setter Property="CaretBrush" Value="{Binding DataContext.Model.TextColor, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource HexBrush}}"/>
        <Setter Property="Background" Value="#4D000000"/>
        <Setter Property="BorderBrush" Value="{StaticResource SelectionStrokeBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="SelectionBrush" Value="{StaticResource SelectionFillBrush}"/>
        <!-- MAJOR-2 fix (review round 3): TextBox.SelectionTextBrush was left unset, so the inline-rename
             editor's selected-text run fell back to the TextBox's own default foreground handling instead
             of the paired token for SelectionBrush above — same unpaired-foreground risk as
             PanelHeaderToggleButtonStyle's Foreground fix in Controls.xaml (see Colors.xaml's
             Color.Selection.Text remarks). -->
        <Setter Property="SelectionTextBrush" Value="{StaticResource SelectionTextBrush}"/>
        <Setter Property="Padding" Value="1,0"/>
        <Style.Triggers>
            <DataTrigger Value="True">
                <DataTrigger.Binding>
                    <MultiBinding Converter="{StaticResource EqualityToBool}">
                        <Binding/>
                        <Binding Path="DataContext.EditingItem" RelativeSource="{RelativeSource AncestorType=Window}"/>
                    </MultiBinding>
                </DataTrigger.Binding>
                <Setter Property="Visibility" Value="Visible"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <DataTemplate x:Key="ListViewTemplate">
        <!--
            Padding="0": the default ListBox theme applies Padding="1" (visible via its default
            style), which — like Resources/Styles/Panels.xaml's PanelItemContainerStyle's
            SelectionBorder BorderThickness — adds unaccounted chrome inside FileListHost that
            GridMetrics.FileListHPadding doesn't know about. NOT because both view modes resize with
            the same icon-grid quantisation — they
            don't: Resize_DragStarted in ChildWindow.xaml.cs zeroes BOTH _snapCellWidth/_snapCellHeight
            for List mode, which is free-form/pixel-accurate on both axes, unlike Grid mode (finalization
            m-9 — corrects a prior version of this comment that claimed otherwise). Rather, both view
            modes' Resize_DragDelta subtracts GridMetrics.FileListHPadding from the raw drag width to get
            content width before comparing against the MinPanelSize/MinPanelWidth floor, whether or not
            that width ends up snapped — so this override matters here just as much as on
            GridViewTemplate below, independent of quantisation.

            MAJOR-B fix (docs/PLANS/workspace-grid-07-visual.md fix-cycle 2): ScrollViewer.
            HorizontalScrollBarVisibility="Disabled" — GridViewTemplate below has always set this (it is
            a hard precondition of AdaptiveIconGridPanel.MeasureOverride there), but this ListBox never
            did, so its default ("Auto") left CanHorizontallyScroll=true on the ListBox's internal
            ScrollContentPresenter. That measures the ItemsPresenter/its panel with an INFINITE available
            width, which the fix-cycle 1 Grid-column item root (see the ItemTemplate below) still needs a
            FINITE available width from its ANCESTOR to constrain its star column against — a StackPanel-
            hosted item (vertical orientation) is measured with the SAME width its own parent panel was
            measured with, so an infinite width here propagates all the way down and TextTrimming=
            "CharacterEllipsis" never had anything finite to trim against; a horizontal scrollbar appeared
            instead of the label being clipped. The fix-cycle 1 STA regression test below this DataTemplate
            (ResourceDictionaryMergeTests.ListViewTemplate_LongDisplayName_LabelTextBlockStaysWithinAvailableWidth)
            measured the item root's DataTemplate content directly, bypassing the real ListBox/ScrollViewer
            entirely, so it stayed green through this bug — see
            ResourceDictionaryMergeTests.ListViewTemplate_NarrowWidth_RealListBoxClampsLabelAndHasNoHorizontalOverflow
            for the honest, ListBox-level regression pin added alongside this fix.
        -->
        <ListBox ItemsSource="{Binding}"
                 Background="Transparent"
                 BorderThickness="0"
                 Padding="0"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 SelectionMode="Single"
                 SelectedItem="{Binding DataContext.SelectedFile, RelativeSource={RelativeSource AncestorType=Window}, Mode=TwoWay}"
                 ItemContainerStyle="{StaticResource PanelItemContainerStyle}"
                 HorizontalAlignment="Stretch"
                 VerticalAlignment="Stretch">
            <ListBox.ItemTemplate>
                <DataTemplate DataType="{x:Type models:FileItem}">
                    <!--
                        UX-P2 fix (docs/PLANS/workspace-grid-07-visual.md fix-cycle 1): Grid, not
                        StackPanel — a horizontal StackPanel always measures its children with an
                        INFINITE available width along its own orientation axis, so a long DisplayName's
                        TextBlock never actually gets constrained and TextTrimming has nothing to trim
                        against (verified: adding TextTrimming alone, without this structural change, has
                        no effect). A Grid's star column, by contrast, is given the item's real
                        (finite) arranged width during Arrange even though Measure saw the same infinite
                        constraint — this is what lets TextTrimming="CharacterEllipsis" below actually
                        truncate. The icon column stays Auto-sized to the Image's own fixed 16+margin
                        footprint, so a missing icon still reserves the same slot width as before
                        (Image's explicit Width/Height are unaffected by a null Source). Verified this
                        does not change ListReorderGeometry's hit-testing/selection math — that operates
                        on the ListBoxItem CONTAINER's own bounds (Behaviors/ListReorderGeometry.cs),
                        never on this DataTemplate's internal element type.
                    -->
                    <Grid Margin="2" Style="{StaticResource FileItemRootStyle}"
                          ToolTip="{Binding Path}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Image Grid.Column="0" Source="{Binding Icon}" Width="16" Height="16" Margin="0,0,6,0"
                               RenderOptions.BitmapScalingMode="HighQuality"/>
                        <TextBlock x:Name="DisplayNameText"
                                   Grid.Column="1"
                                   Text="{Binding DisplayName}"
                                   Foreground="{Binding DataContext.Model.TextColor, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource HexBrush}}"
                                   VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis"
                                   Style="{StaticResource FileNameTextStyle}"/>
                        <TextBox Grid.Column="1"
                                 Text="{Binding DataContext.EditingName, RelativeSource={RelativeSource AncestorType=Window}, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 VerticalAlignment="Center"
                                 VerticalContentAlignment="Center"
                                 MinWidth="120"
                                 Style="{StaticResource FileNameEditBoxStyle}"
                                 behaviors:RenameEditBehavior.IsRenameEditor="True"/>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </DataTemplate>

    <DataTemplate x:Key="GridViewTemplate">
        <!-- Padding="0": see the matching comment on ListViewTemplate's ListBox above — this is the
             template where the unaccounted Padding chrome matters for GridMetrics grid-snap AND
             icon-grid quantisation (Grid mode is the only view mode that quantises resize to the icon
             grid — List mode is free-form on both axes; see the corrected comment above). -->
        <!--
            HorizontalScrollBarVisibility="Disabled" is a hard precondition of
            AdaptiveIconGridPanel.MeasureOverride (docs/PLANS/adaptive-icon-grid.md §6, "D-4"/"R7"): it
            is what guarantees the ScrollViewer always measures the panel with a finite width, so k_max
            (the column count) is well-defined. Do not enable horizontal scrolling for this template
            without also revisiting AdaptiveIconGridPanel's infinite-width fallback.
        -->
        <ListBox ItemsSource="{Binding}"
                 Background="Transparent"
                 BorderThickness="0"
                 Padding="0"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                 SelectionMode="Single"
                 SelectedItem="{Binding DataContext.SelectedFile, RelativeSource={RelativeSource AncestorType=Window}, Mode=TwoWay}"
                 ItemContainerStyle="{StaticResource PanelItemContainerStyle}"
                 HorizontalAlignment="Stretch"
                 VerticalAlignment="Stretch">
            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <!--
                        LayoutPolicy (ADR-029 P05): bound to the owning panel's model, same
                        "RelativeSource AncestorType=Window, then DataContext.Model.*" idiom as
                        Model.IconSize below in the item DataTemplate — this ItemsPanelTemplate's own
                        DataContext is the ListBox's (FileItems, the ContentPresenter's content), not the
                        window, so escaping to the Window ancestor is required here too.
                        ChildWindowModel.IconLayoutPolicy landed with P02b (schema v5) — this binding now
                        resolves at runtime for every panel; a panel whose persisted/default value is
                        IconLayoutPolicy.LegacyStretch (existing panels post-migration, or a new panel
                        while IAppSettings.DefaultIconLayoutPolicy is set to it) simply renders
                        byte-for-byte the same as before this DP existed — that is the DP's own default
                        and LegacyStretch's whole point, not a sign the binding failed.

                        CapacityWidth (ADR-029 P05 fix-cycle 2, CRITICAL-1): bound to the ScrollViewer
                        generated by THIS ListBox's own (unmodified, default) ControlTemplate —
                        RelativeSource AncestorType=ScrollViewer walks the VISUAL tree, so it finds that
                        internal ScrollViewer the same way every "AncestorType=Window" binding above finds
                        the panel's own Window across the same kind of template boundary. This
                        ScrollViewer's own ActualWidth is set by ITS parent's layout (the Window's content
                        column), NOT by whether ITS OWN VerticalScrollBarVisibility="Auto" scrollbar is
                        currently showing — unlike the availableSize/finalSize this panel's
                        Measure/ArrangeOverride receive, which DOES shrink once that scrollbar appears.
                        AdaptiveIconGridPanel.ResolveAvailableForCapacity subtracts FixedGap's M-2
                        scrollbar reservation from THIS stable value instead of the fluctuating one,
                        fixing the double-subtraction CRITICAL-1 found in fix-cycle 1's amendment (see
                        AdaptiveIconGridPanel.CapacityWidthProperty's doc comment for the full mechanism).
                    -->
                    <controls:AdaptiveIconGridPanel UseLayoutRounding="True"
                        LayoutPolicy="{Binding DataContext.Model.IconLayoutPolicy, RelativeSource={RelativeSource AncestorType=Window}}"
                        CapacityWidth="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=ScrollViewer}}"/>
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
            <ListBox.ItemTemplate>
                <DataTemplate DataType="{x:Type models:FileItem}">
                    <!--
                        Margin="5": see the doc comment on Resources/Styles/Panels.xaml's
                        PanelItemContainerStyle/SelectionBorder (relocated there in C5, D-2) — this 5px
                        template margin plus the 1px selection border chrome adds up to the 6px-per-side
                        footprint GridMetrics.CellSize expects (B-F1, ui-polishing-1 §3.3). Do not change
                        this back to 6 without also restoring SelectionBorder's negative Margin
                        compensation, or the first row/column's selection stroke will be clipped again.
                    -->
                    <StackPanel Orientation="Vertical" Margin="5"
                                Width="{Binding DataContext.Model.IconSize, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource IconBoxWidth}}"
                                Style="{StaticResource FileItemRootStyle}"
                                ToolTip="{Binding Path}">
                        <!--
                            Fixed-height Grid slot (ui-polishing-1 §3.6, task 6): the Image below has no
                            explicit Height (only MaxHeight) and VerticalAlignment="Top", so a
                            non-square source icon letterboxes to the top of the slot instead of being
                            centered — the leftover gap goes to the bottom, next to the label. The Grid
                            wrapper keeps the slot height constant even when Icon == null (a broken
                            path): without it, an Image with no explicit Height and no source would
                            collapse to 0 height and the label below would jump up, breaking the "every
                            item's label sits on the same Y" requirement (DoD §3.8.5/§3.8.7).
                        -->
                        <Grid Height="{Binding DataContext.Model.IconSize, RelativeSource={RelativeSource AncestorType=Window}}">
                            <Image Source="{Binding Icon}"
                                   Width="{Binding DataContext.Model.IconSize, RelativeSource={RelativeSource AncestorType=Window}}"
                                   MaxHeight="{Binding DataContext.Model.IconSize, RelativeSource={RelativeSource AncestorType=Window}}"
                                   Stretch="Uniform"
                                   VerticalAlignment="Top"
                                   HorizontalAlignment="Center"
                                   RenderOptions.BitmapScalingMode="HighQuality"/>
                        </Grid>
                        <TextBlock Text="{Binding DisplayName}"
                                   Foreground="{Binding DataContext.Model.TextColor, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource HexBrush}}"
                                   FontSize="11"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap"
                                   Height="32"
                                   TextTrimming="CharacterEllipsis"
                                   Style="{StaticResource FileNameTextStyle}"/>
                        <!--
                            Height="32" matches the sibling TextBlock above (FileNameTextStyle): the two
                            toggle Visibility in lockstep (never both visible), so giving them the same
                            fixed height keeps the item's total footprint constant across that toggle —
                            entering/leaving rename must not resize or reposition the item (ui-polishing-1
                            §3.6 edge case: "active inline-rename TextBox does not jump").
                        -->
                        <TextBox Text="{Binding DataContext.EditingName, RelativeSource={RelativeSource AncestorType=Window}, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 FontSize="11"
                                 TextAlignment="Center"
                                 HorizontalContentAlignment="Center"
                                 VerticalContentAlignment="Center"
                                 Height="32"
                                 Style="{StaticResource FileNameEditBoxStyle}"
                                 behaviors:RenameEditBehavior.IsRenameEditor="True"/>
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </DataTemplate>

</ResourceDictionary>
