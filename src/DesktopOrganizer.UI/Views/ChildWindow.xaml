<Window x:Class="DesktopOrganizer.UI.Views.ChildWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:DesktopOrganizer.UI"
        xmlns:models="clr-namespace:DesktopOrganizer.Core.Models;assembly=DesktopOrganizer.Core"
        mc:Ignorable="d"
        Title="{Binding Title}"
        WindowStartupLocation="Manual"
        Left="{Binding Position.X}"
        Top="{Binding Position.Y}"
        Width="{Binding Size.Width}"
        Height="{Binding Size.Height}"
        WindowState="{Binding WindowState}"
        Visibility="{Binding IsVisible, Converter={StaticResource BooleanToVisibilityConverter}}"
        AllowDrop="True">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Grid.Row="0" Margin="5">
            <Button Content="Сменить вид" Command="{Binding SwitchViewCommand}" Margin="0,0,5,0"/>
            <TextBlock Text="{Binding FileCountText}" VerticalAlignment="Center" HorizontalAlignment="Right"/>
        </StackPanel>

        <ContentControl Content="{Binding FileItems}"
                        ContentTemplate="{Binding CurrentViewTemplate}"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch"
                        Margin="10"
                        Grid.Row="1"/>
    </Grid>
</Window>
