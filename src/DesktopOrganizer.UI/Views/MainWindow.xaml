<Window x:Class="DesktopOrganizer.UI.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:models="clr-namespace:DesktopOrganizer.UI.Models"
        xmlns:settings="clr-namespace:DesktopOrganizer.UI.Views.Settings"
        xmlns:loc="clr-namespace:DesktopOrganizer.UI.Localization"
        mc:Ignorable="d"
        Title="{loc:Loc Settings_Window_Title}"
        Icon="/Resources/app.ico"
        Height="560" Width="720"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanMinimize">
    <!--
        Settings-window redesign (docs/prompts/settings-window-redesign.md, D-2): two-column shell —
        a sidebar ListBox of SettingsSectionInfo entries (Models/SettingsSection.cs) on the left, and a
        ContentControl on the right that switches which Views/Settings/*.xaml UserControl is shown based
        on MainWindowViewModel.SelectedSection. Every section UserControl inherits this Window's own
        DataContext (MainWindowViewModel) — Content="{Binding}" below passes it straight through.
    -->
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="190"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <DockPanel Grid.Column="0" Background="{StaticResource Brush.Settings.ChromeBackground}">
            <!-- "About" is pinned to the bottom as a standalone ToggleButton, not a second ListBox item
                 (see Settings.xaml's remarks on Settings.SidebarAboutToggle for why). -->
            <Border DockPanel.Dock="Bottom"
                    BorderBrush="{StaticResource Brush.Settings.ChromeBorder}"
                    BorderThickness="0,1,0,0">
                <ToggleButton Style="{StaticResource Settings.SidebarAboutToggle}"
                              Content="{Binding AboutSectionInfo}"
                              ContentTemplate="{StaticResource Settings.SidebarItemTemplate}"
                              Command="{Binding SelectSectionCommand}"
                              CommandParameter="{x:Static models:SettingsSection.About}"
                              IsHitTestVisible="True">
                    <ToggleButton.IsChecked>
                        <Binding Path="SelectedSection" Mode="OneWay"
                                 Converter="{StaticResource EnumToBoolean}"
                                 ConverterParameter="{x:Static models:SettingsSection.About}"/>
                    </ToggleButton.IsChecked>
                </ToggleButton>
            </Border>

            <ListBox ItemsSource="{Binding Sections}"
                     Style="{StaticResource Settings.SidebarListBox}"
                     SelectedValuePath="Section"
                     SelectedValue="{Binding SelectedSection, Mode=TwoWay}"
                     Margin="0,8,0,0"/>
        </DockPanel>

        <!-- Content — switches by SelectedSection via DataTriggers (D-2). Content="{Binding}" hands the
             same MainWindowViewModel down to whichever section UserControl is shown. -->
        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
            <ContentControl Content="{Binding}" Margin="20" Focusable="False">
                <ContentControl.Style>
                    <Style TargetType="ContentControl">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding SelectedSection}" Value="{x:Static models:SettingsSection.General}">
                                <Setter Property="ContentTemplate">
                                    <Setter.Value>
                                        <DataTemplate><settings:GeneralSection/></DataTemplate>
                                    </Setter.Value>
                                </Setter>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding SelectedSection}" Value="{x:Static models:SettingsSection.LayoutSnapping}">
                                <Setter Property="ContentTemplate">
                                    <Setter.Value>
                                        <DataTemplate><settings:LayoutSnappingSection/></DataTemplate>
                                    </Setter.Value>
                                </Setter>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding SelectedSection}" Value="{x:Static models:SettingsSection.Panels}">
                                <Setter Property="ContentTemplate">
                                    <Setter.Value>
                                        <DataTemplate><settings:PanelsSection/></DataTemplate>
                                    </Setter.Value>
                                </Setter>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding SelectedSection}" Value="{x:Static models:SettingsSection.NewPanelDefaults}">
                                <Setter Property="ContentTemplate">
                                    <Setter.Value>
                                        <DataTemplate><settings:NewPanelDefaultsSection/></DataTemplate>
                                    </Setter.Value>
                                </Setter>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding SelectedSection}" Value="{x:Static models:SettingsSection.Pages}">
                                <Setter Property="ContentTemplate">
                                    <Setter.Value>
                                        <DataTemplate><settings:PagesSection/></DataTemplate>
                                    </Setter.Value>
                                </Setter>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding SelectedSection}" Value="{x:Static models:SettingsSection.SystemIcons}">
                                <Setter Property="ContentTemplate">
                                    <Setter.Value>
                                        <DataTemplate><settings:SystemIconsSection/></DataTemplate>
                                    </Setter.Value>
                                </Setter>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding SelectedSection}" Value="{x:Static models:SettingsSection.Backup}">
                                <Setter Property="ContentTemplate">
                                    <Setter.Value>
                                        <DataTemplate><settings:BackupSection/></DataTemplate>
                                    </Setter.Value>
                                </Setter>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding SelectedSection}" Value="{x:Static models:SettingsSection.About}">
                                <Setter Property="ContentTemplate">
                                    <Setter.Value>
                                        <DataTemplate><settings:AboutSection/></DataTemplate>
                                    </Setter.Value>
                                </Setter>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ContentControl.Style>
            </ContentControl>
        </ScrollViewer>
    </Grid>
</Window>
