<Window x:Class="DesktopOrganizer.UI.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="DesktopOrganizer — Настройки"
        Height="720" Width="600"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanMinimize">
    <DockPanel>

        <!-- Полоска страниц -->
        <Border DockPanel.Dock="Top" Background="#F0F0F0" BorderBrush="#CCCCCC" BorderThickness="0,0,0,1">
            <DockPanel>
                <Button DockPanel.Dock="Right"
                        Content="+"
                        ToolTip="Добавить страницу"
                        Command="{Binding AddPageCommand}"
                        Padding="10,4" Margin="4,4"
                        FontSize="14" FontWeight="Bold"/>
                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{Binding Pages}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Margin="2,4,2,0">
                                    <!-- Page tab button -->
                                    <Button CommandParameter="{Binding}"
                                            Command="{Binding DataContext.SwitchPageCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            Padding="12,6"
                                            BorderThickness="0"
                                            Cursor="Hand">
                                        <Button.Content>
                                            <TextBlock Text="{Binding}">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="FontWeight" Value="Normal"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Value="True">
                                                                <DataTrigger.Binding>
                                                                    <MultiBinding Converter="{StaticResource EqualityToBool}">
                                                                        <Binding/>
                                                                        <Binding Path="DataContext.CurrentPage" RelativeSource="{RelativeSource AncestorType=Window}"/>
                                                                    </MultiBinding>
                                                                </DataTrigger.Binding>
                                                                <Setter Property="FontWeight" Value="SemiBold"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Button.Content>
                                        <Button.Style>
                                            <Style TargetType="Button">
                                                <Setter Property="Background" Value="Transparent"/>
                                                <Setter Property="BorderThickness" Value="0"/>
                                                <Style.Triggers>
                                                    <DataTrigger Value="True">
                                                        <DataTrigger.Binding>
                                                            <MultiBinding Converter="{StaticResource EqualityToBool}">
                                                                <Binding/>
                                                                <Binding Path="DataContext.CurrentPage" RelativeSource="{RelativeSource AncestorType=Window}"/>
                                                            </MultiBinding>
                                                        </DataTrigger.Binding>
                                                        <Setter Property="Background" Value="White"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                    <!-- Remove button — hidden for the "default" page -->
                                    <Button Content="×"
                                            Command="{Binding DataContext.RemovePageCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}"
                                            Padding="4,6"
                                            BorderThickness="0"
                                            FontSize="11"
                                            ToolTip="Удалить страницу"
                                            Cursor="Hand">
                                        <Button.Style>
                                            <Style TargetType="Button">
                                                <Setter Property="Background" Value="Transparent"/>
                                                <Setter Property="Foreground" Value="#888888"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding}" Value="default">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="16">

            <!-- Панели -->
            <TextBlock Text="Панели на рабочем столе" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,8"/>

            <Border BorderBrush="#CCCCCC" BorderThickness="1" CornerRadius="4" Height="150">
                <ListBox ItemsSource="{Binding Panels}"
                         SelectedItem="{Binding SelectedPanel}"
                         BorderThickness="0">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Title}" Padding="4,2"/>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                <Button Content="Добавить панель" Command="{Binding AddPanelCommand}" Padding="12,6" Margin="0,0,8,0"/>
                <Button Content="Удалить" Command="{Binding RemovePanelCommand}" Padding="12,6"/>
            </StackPanel>

            <Separator Margin="0,16,0,12"/>

            <!-- Настройки выбранной панели -->
            <TextBlock Text="Настройки выбранной панели" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,10"/>

            <Grid IsEnabled="{Binding HasSelectedPanel}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="Заголовок" VerticalAlignment="Center" Margin="0,4"/>
                <TextBox   Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,4"
                           Text="{Binding SelectedPanelTitle, UpdateSourceTrigger=PropertyChanged}"/>

                <TextBlock Grid.Row="1" Grid.Column="0" Text="Цвет фона (hex)" VerticalAlignment="Center" Margin="0,4"/>
                <TextBox   Grid.Row="1" Grid.Column="1" Margin="0,4"
                           Text="{Binding SelectedPanelBackgroundColor, UpdateSourceTrigger=LostFocus}"/>
                <Border    Grid.Row="1" Grid.Column="2" Width="24" Height="24" Margin="8,4,0,4" CornerRadius="3"
                           BorderBrush="#888" BorderThickness="1"
                           Background="{Binding SelectedPanelBackgroundColor, Converter={StaticResource HexBrush}}"/>

                <TextBlock Grid.Row="2" Grid.Column="0" Text="Цвет текста (hex)" VerticalAlignment="Center" Margin="0,4"/>
                <TextBox   Grid.Row="2" Grid.Column="1" Margin="0,4"
                           Text="{Binding SelectedPanelTextColor, UpdateSourceTrigger=LostFocus}"/>
                <Border    Grid.Row="2" Grid.Column="2" Width="24" Height="24" Margin="8,4,0,4" CornerRadius="3"
                           BorderBrush="#888" BorderThickness="1"
                           Background="{Binding SelectedPanelTextColor, Converter={StaticResource HexBrush}}"/>

                <TextBlock Grid.Row="3" Grid.Column="0" Text="Прозрачность" VerticalAlignment="Center" Margin="0,4"/>
                <Slider    Grid.Row="3" Grid.Column="1" VerticalAlignment="Center" Margin="0,4"
                           Minimum="0" Maximum="1" Value="{Binding SelectedPanelOpacity, Mode=TwoWay}"/>
                <TextBlock Grid.Row="3" Grid.Column="2" Margin="8,4,0,4" VerticalAlignment="Center"
                           Text="{Binding SelectedPanelOpacity, StringFormat={}{0:P0}}"/>

                <TextBlock Grid.Row="4" Grid.Column="0" Text="Размер иконок" VerticalAlignment="Center" Margin="0,4"/>
                <Slider    Grid.Row="4" Grid.Column="1" VerticalAlignment="Center" Margin="0,4"
                           Minimum="16" Maximum="96" Value="{Binding SelectedPanelIconSize, Mode=TwoWay}"/>
                <TextBlock Grid.Row="4" Grid.Column="2" Margin="8,4,0,4" VerticalAlignment="Center"
                           Text="{Binding SelectedPanelIconSize, StringFormat={}{0:F0} px}"/>

                <TextBlock Grid.Row="5" Grid.Column="0" Text="Вид" VerticalAlignment="Center" Margin="0,4"/>
                <ComboBox  Grid.Row="5" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,4"
                           ItemsSource="{Binding ViewModes}"
                           SelectedItem="{Binding SelectedPanelViewMode, Mode=TwoWay}"/>
            </Grid>

            <Separator Margin="0,16,0,12"/>

            <!-- Привязка к сетке -->
            <TextBlock Text="Привязка к сетке" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,10"/>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="60"/>
                </Grid.ColumnDefinitions>
                <Slider Grid.Column="0" Minimum="1" Maximum="128" Value="{Binding GridSize, Mode=TwoWay}"
                        TickFrequency="4" IsSnapToTickEnabled="False" VerticalAlignment="Center" Margin="0,0,12,0"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding GridSize}" FontWeight="SemiBold" MinWidth="28" TextAlignment="Right"/>
                    <TextBlock Text=" px" Foreground="#666666"/>
                </StackPanel>
            </Grid>

            <Separator Margin="0,16,0,12"/>

            <!-- Глобальные дефолты -->
            <TextBlock Text="Дефолты для новых панелей" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,10"/>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="Цвет фона (hex)" VerticalAlignment="Center" Margin="0,4"/>
                <TextBox   Grid.Row="0" Grid.Column="1" Margin="0,4"
                           Text="{Binding DefaultBackgroundColor, UpdateSourceTrigger=LostFocus}"/>
                <Border    Grid.Row="0" Grid.Column="2" Width="24" Height="24" Margin="8,4,0,4" CornerRadius="3"
                           BorderBrush="#888" BorderThickness="1"
                           Background="{Binding DefaultBackgroundColor, Converter={StaticResource HexBrush}}"/>

                <TextBlock Grid.Row="1" Grid.Column="0" Text="Цвет текста (hex)" VerticalAlignment="Center" Margin="0,4"/>
                <TextBox   Grid.Row="1" Grid.Column="1" Margin="0,4"
                           Text="{Binding DefaultTextColor, UpdateSourceTrigger=LostFocus}"/>
                <Border    Grid.Row="1" Grid.Column="2" Width="24" Height="24" Margin="8,4,0,4" CornerRadius="3"
                           BorderBrush="#888" BorderThickness="1"
                           Background="{Binding DefaultTextColor, Converter={StaticResource HexBrush}}"/>

                <TextBlock Grid.Row="2" Grid.Column="0" Text="Прозрачность" VerticalAlignment="Center" Margin="0,4"/>
                <Slider    Grid.Row="2" Grid.Column="1" VerticalAlignment="Center" Margin="0,4"
                           Minimum="0" Maximum="1" Value="{Binding DefaultOpacity, Mode=TwoWay}"/>
                <TextBlock Grid.Row="2" Grid.Column="2" Margin="8,4,0,4" VerticalAlignment="Center"
                           Text="{Binding DefaultOpacity, StringFormat={}{0:P0}}"/>

                <TextBlock Grid.Row="3" Grid.Column="0" Text="Размер иконок" VerticalAlignment="Center" Margin="0,4"/>
                <Slider    Grid.Row="3" Grid.Column="1" VerticalAlignment="Center" Margin="0,4"
                           Minimum="16" Maximum="96" Value="{Binding DefaultIconSize, Mode=TwoWay}"/>
                <TextBlock Grid.Row="3" Grid.Column="2" Margin="8,4,0,4" VerticalAlignment="Center"
                           Text="{Binding DefaultIconSize, StringFormat={}{0:F0} px}"/>
            </Grid>

            <Separator Margin="0,16,0,12"/>

            <!-- Правила сортировки -->
            <TextBlock Text="Правила сортировки" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,8"/>

            <Border BorderBrush="#CCCCCC" BorderThickness="1" CornerRadius="4" Height="140">
                <ListView ItemsSource="{Binding SortingRules}" BorderThickness="0">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="Критерий" Width="140"
                                            DisplayMemberBinding="{Binding Criterion}"/>
                            <GridViewColumn Header="Значение" Width="130"
                                            DisplayMemberBinding="{Binding Value}"/>
                            <GridViewColumn Header="Панель-назначение" Width="130"
                                            DisplayMemberBinding="{Binding TargetPanelId}"/>
                            <GridViewColumn Header="" Width="70">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="Удалить"
                                                FontSize="11"
                                                Padding="4,2"
                                                Command="{Binding DataContext.RemoveSortingRuleCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding Id}"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                        </GridView>
                    </ListView.View>
                </ListView>
            </Border>

            <!-- Редактор нового правила -->
            <Grid Margin="0,8,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <ComboBox Grid.Column="0"
                          Width="140"
                          Margin="0,0,8,0"
                          ItemsSource="{Binding SortingCriteria}"
                          SelectedItem="{Binding NewRuleCriterion, Mode=TwoWay}"
                          ToolTip="Критерий"/>

                <TextBox Grid.Column="1"
                         Margin="0,0,8,0"
                         Text="{Binding NewRuleValue, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="Значение (например .pdf или Report)"/>

                <ComboBox Grid.Column="2"
                          Margin="0,0,8,0"
                          ItemsSource="{Binding Panels}"
                          SelectedItem="{Binding NewRuleTargetPanel, Mode=TwoWay}"
                          DisplayMemberPath="Title"
                          ToolTip="Панель-назначение"/>

                <Button Grid.Column="3"
                        Content="Добавить правило"
                        Padding="10,6"
                        Command="{Binding AddSortingRuleCommand}"/>
            </Grid>

            <Button Content="Применить правила сейчас"
                    HorizontalAlignment="Right"
                    Padding="12,6"
                    Margin="0,8,0,0"
                    Command="{Binding ApplySortingRulesCommand}"/>

            <Separator Margin="0,16,0,12"/>

            <!-- Автозапуск -->
            <CheckBox Content="Запускать вместе с Windows"
                      IsChecked="{Binding AutostartEnabled, Mode=TwoWay}"/>

            <Separator Margin="0,16,0,12"/>

            <!-- Снапшоты раскладки -->
            <TextBlock Text="Снапшоты раскладки" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,8"/>

            <Border BorderBrush="#CCCCCC" BorderThickness="1" CornerRadius="4" Height="160">
                <ListView ItemsSource="{Binding LayoutSnapshots.Snapshots}"
                          BorderThickness="0"
                          SelectionMode="Single">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="Название" Width="200">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Name}" VerticalAlignment="Center"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="Дата" Width="130">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding CreatedAt, StringFormat={}{0:dd.MM.yyyy HH:mm}}"
                                                   VerticalAlignment="Center" Foreground="#666666"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="" Width="180">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <Button Content="Восстановить"
                                                    Command="{Binding DataContext.LayoutSnapshots.RestoreSnapshotCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding Id}"
                                                    Padding="6,3" Margin="0,0,4,0"
                                                    FontSize="11"/>
                                            <Button Content="Удалить"
                                                    Command="{Binding DataContext.LayoutSnapshots.DeleteSnapshotCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding Id}"
                                                    Padding="6,3"
                                                    FontSize="11"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                        </GridView>
                    </ListView.View>
                </ListView>
            </Border>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                <Button Content="Сохранить снапшот"
                        Command="{Binding LayoutSnapshots.CaptureSnapshotCommand}"
                        Padding="12,6"/>
            </StackPanel>

        </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
