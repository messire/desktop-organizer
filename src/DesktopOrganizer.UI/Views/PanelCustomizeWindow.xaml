<Window x:Class="DesktopOrganizer.UI.Views.PanelCustomizeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:conv="clr-namespace:DesktopOrganizer.UI.Converters"
        xmlns:uimodels="clr-namespace:DesktopOrganizer.UI.Models"
        mc:Ignorable="d"
        Title="{Binding WindowTitle}"
        Height="560" Width="420"
        ResizeMode="NoResize"
        ShowInTaskbar="True"
        Topmost="False"
        WindowStartupLocation="Manual">
    <!--
        docs/prompts/settings-window-redesign.md D-3: a normal, activatable, modeless window — unlike
        ChildWindow it carries no WS_EX_NOACTIVATE (see PanelCustomizeWindow.xaml.cs's remarks) and no
        OK/Cancel buttons; every control below applies to PanelCustomizeViewModel.Target live.
        FIX-B fix-cycle minor finding 7: ShowInTaskbar="True" so this modeless dialog can't get lost
        behind the (also non-owning, D-3 P-B1) settings window.
    -->
    <Window.Resources>
        <!-- Same converter/labels ChildWindow.xaml's "Icon layout" context-menu radio group and
             MainWindow.xaml's "Defaults for new panels" combos already use (P06 fix-cycle UX-P1) — not
             globally merged, so each window that needs it declares its own instance, same as
             MainWindow.xaml does. -->
        <conv:EnumDisplayNameConverter x:Key="EnumDisplayName"/>
    </Window.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16,12,16,12">
        <StackPanel>
            <TextBlock x:Name="TitleLabel" Text="Title" VerticalAlignment="Center" Margin="0,0,0,4"/>
            <TextBox Text="{Binding Appearance.SelectedPanelTitle, UpdateSourceTrigger=PropertyChanged}"
                     AutomationProperties.LabeledBy="{Binding ElementName=TitleLabel}"
                     Margin="0,0,0,12"/>

            <!-- ── Appearance ─────────────────────────────────────────────────────────────────── -->
            <Expander Header="Appearance" IsExpanded="True" Margin="0,0,0,12">
                <Grid Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="130"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock x:Name="AccentColorLabel" Grid.Row="0" Grid.Column="0" Text="Accent color (hex)" VerticalAlignment="Center" Margin="0,4"/>
                    <TextBox   x:Name="AccentColorTextBox" Grid.Row="0" Grid.Column="1" Margin="0,4"
                               AutomationProperties.LabeledBy="{Binding ElementName=AccentColorLabel}"
                               Text="{Binding Appearance.SelectedPanelAccentColor, UpdateSourceTrigger=LostFocus}"/>
                    <Border    Grid.Row="0" Grid.Column="2" Width="24" Height="24" Margin="8,4,0,4" CornerRadius="3"
                               BorderBrush="{StaticResource Brush.Settings.SwatchBorder}" BorderThickness="1"
                               Background="{Binding Appearance.SelectedPanelAccentColor, Converter={StaticResource HexBrush}}"/>

                    <TextBlock x:Name="TextColorLabel" Grid.Row="1" Grid.Column="0" Text="Text color (hex)" VerticalAlignment="Center" Margin="0,4"/>
                    <TextBox   x:Name="TextColorTextBox" Grid.Row="1" Grid.Column="1" Margin="0,4"
                               AutomationProperties.LabeledBy="{Binding ElementName=TextColorLabel}"
                               Text="{Binding Appearance.SelectedPanelTextColor, UpdateSourceTrigger=LostFocus}"/>
                    <Border    Grid.Row="1" Grid.Column="2" Width="24" Height="24" Margin="8,4,0,4" CornerRadius="3"
                               BorderBrush="{StaticResource Brush.Settings.SwatchBorder}" BorderThickness="1"
                               Background="{Binding Appearance.SelectedPanelTextColor, Converter={StaticResource HexBrush}}"/>

                    <TextBlock x:Name="OpacityLabel" Grid.Row="2" Grid.Column="0" Text="Surface opacity" VerticalAlignment="Center" Margin="0,4"/>
                    <Slider    x:Name="OpacitySlider" Grid.Row="2" Grid.Column="1" VerticalAlignment="Center" Margin="0,4"
                               AutomationProperties.LabeledBy="{Binding ElementName=OpacityLabel}"
                               Minimum="0" Maximum="1" TickFrequency="1" Value="{Binding Appearance.SelectedPanelSurfaceOpacity, Mode=TwoWay}"/>
                    <TextBlock Grid.Row="2" Grid.Column="2" Margin="8,4,0,4" VerticalAlignment="Center"
                               Text="{Binding Appearance.SelectedPanelSurfaceOpacity, StringFormat={}{0:P0}}"/>

                    <TextBlock x:Name="SurfaceStyleLabel" Grid.Row="3" Grid.Column="0" Text="Surface style" VerticalAlignment="Top" Margin="0,4"/>
                    <StackPanel Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,4">
                        <ComboBox ItemsSource="{Binding Appearance.SurfaceStyles}"
                                  SelectedItem="{Binding Appearance.SelectedPanelSurfaceStyle, Mode=TwoWay}"
                                  AutomationProperties.LabeledBy="{Binding ElementName=SurfaceStyleLabel}"
                                  AutomationProperties.HelpText="{Binding ElementName=SurfaceStyleGlassHint, Path=Text}"/>
                        <TextBlock x:Name="SurfaceStyleGlassHint"
                                   Text="Glass reads best on dark wallpapers; for light wallpapers, Solid or Ambient stay more readable."
                                   Foreground="{StaticResource Brush.Settings.TextMuted}" FontSize="11"
                                   TextWrapping="Wrap" Margin="0,4,0,0"/>
                    </StackPanel>

                    <TextBlock x:Name="IconSizeLabel" Grid.Row="4" Grid.Column="0" Text="Icon size" VerticalAlignment="Center" Margin="0,4"/>
                    <Slider    Grid.Row="4" Grid.Column="1" VerticalAlignment="Center" Margin="0,4"
                               AutomationProperties.LabeledBy="{Binding ElementName=IconSizeLabel}"
                               Minimum="16" Maximum="96" TickFrequency="4" IsSnapToTickEnabled="True" Value="{Binding Appearance.SelectedPanelIconSize, Mode=TwoWay}"/>
                    <TextBlock Grid.Row="4" Grid.Column="2" Margin="8,4,0,4" VerticalAlignment="Center"
                               Text="{Binding Appearance.SelectedPanelIconSize, StringFormat={}{0:F0} px}"/>
                </Grid>
            </Expander>

            <!-- ── Content ────────────────────────────────────────────────────────────────────── -->
            <Expander Header="Content" IsExpanded="True" Margin="0,0,0,12">
                <StackPanel Margin="0,10,0,0">
                    <!-- View — RadioButton group over PanelViewMode's two values (FIX-B fix-cycle minor
                         finding 11), for consistency with the settings window's own gesture radio
                         groups. EnumEquals (one-way "is this the active value") + a Command per option
                         is the same pattern ChildWindow.xaml's HeaderContextMenu "Icon layout"/"Arrange
                         icons" radio groups already use — both converters are globally merged
                         (Resources/Templates.xaml), so no local instance is declared for them here. -->
                    <TextBlock x:Name="ViewLabel" Text="View" VerticalAlignment="Center" Margin="0,0,0,4"/>
                    <StackPanel Orientation="Horizontal" AutomationProperties.LabeledBy="{Binding ElementName=ViewLabel}">
                        <RadioButton GroupName="PanelCustomizeViewMode" Content="List" Margin="0,0,16,0"
                                     Command="{Binding Appearance.SetViewModeCommand}"
                                     CommandParameter="{x:Static uimodels:PanelViewMode.List}">
                            <RadioButton.IsChecked>
                                <Binding Path="Appearance.SelectedPanelViewMode" Mode="OneWay"
                                         Converter="{StaticResource EnumEquals}"
                                         ConverterParameter="{x:Static uimodels:PanelViewMode.List}"/>
                            </RadioButton.IsChecked>
                        </RadioButton>
                        <RadioButton GroupName="PanelCustomizeViewMode" Content="Grid"
                                     Command="{Binding Appearance.SetViewModeCommand}"
                                     CommandParameter="{x:Static uimodels:PanelViewMode.Grid}">
                            <RadioButton.IsChecked>
                                <Binding Path="Appearance.SelectedPanelViewMode" Mode="OneWay"
                                         Converter="{StaticResource EnumEquals}"
                                         ConverterParameter="{x:Static uimodels:PanelViewMode.Grid}"/>
                            </RadioButton.IsChecked>
                        </RadioButton>
                    </StackPanel>

                    <TextBlock x:Name="ContentFilterLabel" Text="Content filter" VerticalAlignment="Center" Margin="0,12,0,4"/>
                    <ComboBox ItemsSource="{Binding ContentFilters}"
                              SelectedItem="{Binding ContentFilter, Mode=TwoWay}"
                              AutomationProperties.LabeledBy="{Binding ElementName=ContentFilterLabel}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Converter={StaticResource EnumDisplayName}}"/>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>

                    <!-- Sort order — RadioButton group over PanelSortMode's two values (finding 11).
                         Both options are disabled together while the panel is a Folder Portal, matching
                         the previous single ComboBox's IsEnabled — sort order isn't a per-option choice
                         in that state, the whole control is moot. -->
                    <TextBlock x:Name="SortModeLabel" Text="Sort order" VerticalAlignment="Center" Margin="0,12,0,4"/>
                    <StackPanel Orientation="Horizontal" AutomationProperties.LabeledBy="{Binding ElementName=SortModeLabel}"
                                IsEnabled="{Binding Appearance.SelectedPanelSupportsManualOrder}">
                        <RadioButton GroupName="PanelCustomizeSortMode" Content="Manual" Margin="0,0,16,0"
                                     Command="{Binding Appearance.SetSortModeCommand}"
                                     CommandParameter="{x:Static uimodels:PanelSortMode.Manual}">
                            <RadioButton.IsChecked>
                                <Binding Path="Appearance.SelectedPanelSortMode" Mode="OneWay"
                                         Converter="{StaticResource EnumEquals}"
                                         ConverterParameter="{x:Static uimodels:PanelSortMode.Manual}"/>
                            </RadioButton.IsChecked>
                        </RadioButton>
                        <RadioButton GroupName="PanelCustomizeSortMode" Content="By name"
                                     Command="{Binding Appearance.SetSortModeCommand}"
                                     CommandParameter="{x:Static uimodels:PanelSortMode.Name}">
                            <RadioButton.IsChecked>
                                <Binding Path="Appearance.SelectedPanelSortMode" Mode="OneWay"
                                         Converter="{StaticResource EnumEquals}"
                                         ConverterParameter="{x:Static uimodels:PanelSortMode.Name}"/>
                            </RadioButton.IsChecked>
                        </RadioButton>
                    </StackPanel>
                    <TextBlock x:Name="SortModeDescriptionText" Text="{Binding SortModeDescription}"
                               AutomationProperties.HelpText="{Binding ElementName=SortModeDescriptionText, Path=Text}"
                               Foreground="{StaticResource Brush.Settings.TextMuted}" FontSize="11"
                               TextWrapping="Wrap" Margin="0,4,0,0"/>

                    <TextBlock x:Name="FolderPortalLabel" Text="Folder Portal" VerticalAlignment="Center" Margin="0,12,0,4"/>
                    <TextBox Text="{Binding FolderPortalPath, Mode=OneWay}" IsReadOnly="True" Margin="0,0,0,4"
                             AutomationProperties.LabeledBy="{Binding ElementName=FolderPortalLabel}"/>
                    <StackPanel Orientation="Horizontal">
                        <Button Content="Browse…" Command="{Binding BrowseFolderCommand}" Padding="10,4" Margin="0,0,8,0"
                                AutomationProperties.Name="Browse for Folder Portal source"/>
                        <Button Content="Clear" Command="{Binding ClearFolderCommand}" Padding="10,4"
                                AutomationProperties.Name="Clear Folder Portal"/>
                    </StackPanel>
                    <TextBlock x:Name="FolderPortalDescriptionText"
                               Text="Mirrors a folder's contents instead of a manually curated item list. Folder Portal panels always sort by name and ignore manual drag-drop."
                               AutomationProperties.HelpText="{Binding ElementName=FolderPortalDescriptionText, Path=Text}"
                               Foreground="{StaticResource Brush.Settings.TextMuted}" FontSize="11"
                               TextWrapping="Wrap" Margin="0,4,0,0"/>
                </StackPanel>
            </Expander>

            <!-- ── Layout ─────────────────────────────────────────────────────────────────────── -->
            <Expander Header="Layout" IsExpanded="True" Margin="0,0,0,12">
                <StackPanel Margin="0,10,0,0">
                    <!-- FIX-B fix-cycle MAJOR finding M-1 (ADR-026): both controls below are gated by
                         CanChangeLayout, exactly like the panel's own context menu's "Icon layout"/
                         "Auto-size to content" items, and each shows the disabled reason as a
                         description — not only a tooltip. -->
                    <TextBlock x:Name="IconLayoutLabel" Text="Icon layout" VerticalAlignment="Center" Margin="0,4"/>
                    <ComboBox ItemsSource="{Binding IconLayoutPolicies}"
                              SelectedItem="{Binding IconLayoutPolicy, Mode=TwoWay}"
                              IsEnabled="{Binding CanChangeLayout}"
                              AutomationProperties.LabeledBy="{Binding ElementName=IconLayoutLabel}"
                              AutomationProperties.HelpText="{Binding ElementName=IconLayoutDescriptionText, Path=Text}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Converter={StaticResource EnumDisplayName}}"/>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <TextBlock x:Name="IconLayoutDescriptionText" Text="{Binding IconLayoutDescription}"
                               Foreground="{StaticResource Brush.Settings.TextMuted}" FontSize="11"
                               TextWrapping="Wrap" Margin="0,4,0,0"/>

                    <CheckBox x:Name="AutoSizeToContentCheckBox" Content="Auto-size to content"
                              IsChecked="{Binding IsAutoSizeToContent, Mode=TwoWay}"
                              IsEnabled="{Binding CanToggleAutoSizeToContent}"
                              AutomationProperties.HelpText="{Binding ElementName=AutoSizeToContentDescriptionText, Path=Text}"
                              Margin="0,12,0,0"/>
                    <TextBlock x:Name="AutoSizeToContentDescriptionText" Text="{Binding AutoSizeToContentDescription}"
                               Foreground="{StaticResource Brush.Settings.TextMuted}" FontSize="11"
                               TextWrapping="Wrap" Margin="0,4,0,0"/>
                </StackPanel>
            </Expander>
        </StackPanel>
    </ScrollViewer>
</Window>
