<UserControl x:Class="DesktopOrganizer.UI.Views.Settings.BackupSection"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignWidth="460">
    <StackPanel>
        <TextBlock Text="Backup" Style="{StaticResource Settings.PageHeader}"/>

        <Border Style="{StaticResource Settings.CardBorder}">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,16,0">
                        <TextBlock Text="Layout snapshots" Style="{StaticResource Settings.CardHeader}"/>
                        <TextBlock Style="{StaticResource Settings.CardDescription}"
                                   Text="Captures every panel's position, size, and appearance so you can restore this exact layout later."/>
                    </StackPanel>
                    <Button Grid.Column="1" Content="Save snapshot…" Padding="12,6" VerticalAlignment="Center"
                            Command="{Binding LayoutSnapshots.CaptureSnapshotCommand}"/>
                </Grid>

                <Border BorderBrush="{StaticResource Brush.Settings.CardBorder}" BorderThickness="1"
                        CornerRadius="{StaticResource Radius.Control}" Height="200" Margin="0,10,0,0">
                    <ListView ItemsSource="{Binding LayoutSnapshots.Snapshots}" BorderThickness="0" SelectionMode="Single"
                              AutomationProperties.Name="Layout snapshots">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="Name" Width="190">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Name}" VerticalAlignment="Center"/>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="Date" Width="120">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding CreatedAt, StringFormat={}{0:dd.MM.yyyy HH:mm}}"
                                                       VerticalAlignment="Center" Foreground="{StaticResource Brush.Settings.TextMuted}"/>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="" Width="140">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <Button Content="Restore" Padding="6,3" Margin="0,0,4,0" FontSize="11"
                                                        AutomationProperties.Name="{Binding Name, StringFormat='Restore {0}'}"
                                                        Command="{Binding DataContext.LayoutSnapshots.RestoreSnapshotCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding Id}"/>
                                                <Button Content="Delete" Padding="6,3" FontSize="11"
                                                        AutomationProperties.Name="{Binding Name, StringFormat='Delete {0}'}"
                                                        Command="{Binding DataContext.LayoutSnapshots.DeleteSnapshotCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding Id}"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                            </GridView>
                        </ListView.View>
                    </ListView>
                </Border>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
