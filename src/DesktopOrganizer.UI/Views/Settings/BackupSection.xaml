<UserControl x:Class="DesktopOrganizer.UI.Views.Settings.BackupSection"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:loc="clr-namespace:DesktopOrganizer.UI.Localization"
             mc:Ignorable="d"
             d:DesignWidth="460">
    <StackPanel>
        <TextBlock Text="{loc:Loc Settings_Nav_Backup}" Style="{StaticResource Settings.PageHeader}"/>

        <Border Style="{StaticResource Settings.CardBorder}">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,16,0">
                        <TextBlock Text="{loc:Loc Settings_Backup_LayoutSnapshots_Header}" Style="{StaticResource Settings.CardHeader}"/>
                        <TextBlock Style="{StaticResource Settings.CardDescription}"
                                   Text="{loc:Loc Settings_Backup_LayoutSnapshots_Description}"/>
                    </StackPanel>
                    <Button Grid.Column="1" Content="{loc:Loc Settings_Backup_SaveSnapshot_Button}" Padding="12,6" VerticalAlignment="Center"
                            Command="{Binding LayoutSnapshots.CaptureSnapshotCommand}"/>
                </Grid>

                <Border BorderBrush="{StaticResource Brush.Settings.CardBorder}" BorderThickness="1"
                        CornerRadius="{StaticResource Radius.Control}" Height="200" Margin="0,10,0,0">
                    <ListView ItemsSource="{Binding LayoutSnapshots.Snapshots}" BorderThickness="0" SelectionMode="Single"
                              AutomationProperties.Name="{loc:Loc Settings_Backup_LayoutSnapshots_Header}">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="{loc:Loc Settings_Backup_NameColumn_Header}" Width="190">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Name}" VerticalAlignment="Center"/>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="{loc:Loc Settings_Backup_DateColumn_Header}" Width="120">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{loc:LocBinding CreatedAt, FormatKey=Settings_Backup_CreatedAt_Format}"
                                                       VerticalAlignment="Center" Foreground="{StaticResource Brush.Settings.TextMuted}"/>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="" Width="140">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <Button Content="{loc:Loc Settings_Backup_Restore_Button}" Padding="6,3" Margin="0,0,4,0" FontSize="11"
                                                        AutomationProperties.Name="{loc:LocBinding Name, FormatKey=Settings_Backup_Restore_Format}"
                                                        Command="{Binding DataContext.LayoutSnapshots.RestoreSnapshotCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding Id}"/>
                                                <Button Content="{loc:Loc Settings_Backup_Delete_Button}" Padding="6,3" FontSize="11"
                                                        AutomationProperties.Name="{loc:LocBinding Name, FormatKey=Settings_Backup_Delete_Format}"
                                                        Command="{Binding DataContext.LayoutSnapshots.DeleteSnapshotCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding Id}"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                            </GridView>
                        </ListView.View>
                    </ListView>
                </Border>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
