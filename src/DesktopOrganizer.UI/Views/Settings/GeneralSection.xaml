<UserControl x:Class="DesktopOrganizer.UI.Views.Settings.GeneralSection"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignWidth="460">
    <StackPanel>
        <TextBlock Text="General" Style="{StaticResource Settings.PageHeader}"/>

        <Border Style="{StaticResource Settings.CardBorder}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Margin="0,0,16,0">
                    <TextBlock Text="Start with Windows" Style="{StaticResource Settings.CardHeader}"/>
                    <TextBlock Text="Launches DesktopOrganizer automatically when you sign in."
                               Style="{StaticResource Settings.CardDescription}"/>
                </StackPanel>
                <CheckBox Grid.Column="1" VerticalAlignment="Center"
                          Style="{StaticResource Settings.ToggleCheckBox}"
                          AutomationProperties.Name="Start with Windows"
                          IsChecked="{Binding AutostartEnabled, Mode=TwoWay}"/>
            </Grid>
        </Border>

        <Expander Header="Advanced" IsExpanded="False" Margin="0,4,0,0">
            <StackPanel Margin="0,10,0,0">
                <Border Style="{StaticResource Settings.CardBorder}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,16,0">
                            <TextBlock Text="Native resize (experimental)" Style="{StaticResource Settings.CardHeader}"/>
                            <TextBlock Style="{StaticResource Settings.CardDescription}"
                                       Text="Resizes panels via the OS native sizing loop instead of the built-in resize handles. Applies only to panels created after the app restarts."/>
                        </StackPanel>
                        <CheckBox Grid.Column="1" VerticalAlignment="Center"
                                  Style="{StaticResource Settings.ToggleCheckBox}"
                                  AutomationProperties.Name="Native resize (experimental)"
                                  IsChecked="{Binding NativePanelSizing, Mode=TwoWay}"/>
                    </Grid>
                </Border>

                <Border Style="{StaticResource Settings.CardBorder}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,16,0">
                            <TextBlock Text="Reset one-time hints" Style="{StaticResource Settings.CardHeader}"/>
                            <TextBlock Style="{StaticResource Settings.CardDescription}"
                                       Text="Shows the one-time Move-semantics hint again the next time a drag-drop moves a file into a panel."/>
                            <TextBlock Text="There are no hints to reset." Margin="0,4,0,0">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource Settings.CardDescription}">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasOneTimeHintsToReset}" Value="False">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                        <Button Grid.Column="1" Content="Reset" Padding="12,6" VerticalAlignment="Center"
                                AutomationProperties.Name="Reset one-time hints"
                                Command="{Binding ResetOneTimeHintsCommand}"/>
                    </Grid>
                </Border>
            </StackPanel>
        </Expander>
    </StackPanel>
</UserControl>
