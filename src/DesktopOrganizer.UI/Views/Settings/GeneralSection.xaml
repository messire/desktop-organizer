<UserControl x:Class="DesktopOrganizer.UI.Views.Settings.GeneralSection"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:loc="clr-namespace:DesktopOrganizer.UI.Localization"
             mc:Ignorable="d"
             d:DesignWidth="460">
    <StackPanel>
        <TextBlock Text="{loc:Loc Settings_Nav_General}" Style="{StaticResource Settings.PageHeader}"/>

        <!-- Language (docs/PLANS/localization.md §2.9 contract C-5): LanguageOptions/SelectedLanguageOption
             are provided by MainWindowViewModel (WP-5). Placed first per §4.5. -->
        <Border Style="{StaticResource Settings.CardBorder}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Margin="0,0,16,0">
                    <TextBlock Text="{loc:Loc Settings_General_Language_Header}" Style="{StaticResource Settings.CardHeader}"/>
                    <TextBlock Text="{loc:Loc Settings_General_Language_Description}"
                               Style="{StaticResource Settings.CardDescription}"/>
                </StackPanel>
                <ComboBox Grid.Column="1" MinWidth="140" VerticalAlignment="Center"
                          AutomationProperties.Name="{loc:Loc Settings_General_Language_Header}"
                          ItemsSource="{Binding LanguageOptions}"
                          SelectedItem="{Binding SelectedLanguageOption, Mode=TwoWay}"
                          DisplayMemberPath="DisplayName"/>
            </Grid>
        </Border>

        <Border Style="{StaticResource Settings.CardBorder}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Margin="0,0,16,0">
                    <TextBlock Text="{loc:Loc Settings_General_Autostart_Header}" Style="{StaticResource Settings.CardHeader}"/>
                    <TextBlock Text="{loc:Loc Settings_General_Autostart_Description}"
                               Style="{StaticResource Settings.CardDescription}"/>
                </StackPanel>
                <CheckBox Grid.Column="1" VerticalAlignment="Center"
                          Style="{StaticResource Settings.ToggleCheckBox}"
                          AutomationProperties.Name="{loc:Loc Settings_General_Autostart_Header}"
                          IsChecked="{Binding AutostartEnabled, Mode=TwoWay}"/>
            </Grid>
        </Border>

        <Expander Header="{loc:Loc Settings_General_Advanced_Header}" IsExpanded="False" Margin="0,4,0,0">
            <StackPanel Margin="0,10,0,0">
                <Border Style="{StaticResource Settings.CardBorder}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,16,0">
                            <TextBlock Text="{loc:Loc Settings_General_NativeResize_Header}" Style="{StaticResource Settings.CardHeader}"/>
                            <TextBlock Style="{StaticResource Settings.CardDescription}"
                                       Text="{loc:Loc Settings_General_NativeResize_Description}"/>
                        </StackPanel>
                        <CheckBox Grid.Column="1" VerticalAlignment="Center"
                                  Style="{StaticResource Settings.ToggleCheckBox}"
                                  AutomationProperties.Name="{loc:Loc Settings_General_NativeResize_Header}"
                                  IsChecked="{Binding NativePanelSizing, Mode=TwoWay}"/>
                    </Grid>
                </Border>

                <Border Style="{StaticResource Settings.CardBorder}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,16,0">
                            <TextBlock Text="{loc:Loc Settings_General_ResetHints_Header}" Style="{StaticResource Settings.CardHeader}"/>
                            <TextBlock Style="{StaticResource Settings.CardDescription}"
                                       Text="{loc:Loc Settings_General_ResetHints_Description}"/>
                            <TextBlock Text="{loc:Loc Settings_General_ResetHints_NoneMessage}" Margin="0,4,0,0">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource Settings.CardDescription}">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasOneTimeHintsToReset}" Value="False">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                        <Button Grid.Column="1" Content="{loc:Loc Settings_General_ResetHints_Button}" Padding="12,6" VerticalAlignment="Center"
                                AutomationProperties.Name="{loc:Loc Settings_General_ResetHints_Header}"
                                Command="{Binding ResetOneTimeHintsCommand}"/>
                    </Grid>
                </Border>
            </StackPanel>
        </Expander>
    </StackPanel>
</UserControl>
