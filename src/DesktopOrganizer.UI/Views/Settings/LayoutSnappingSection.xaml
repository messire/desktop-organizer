<UserControl x:Class="DesktopOrganizer.UI.Views.Settings.LayoutSnappingSection"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:models="clr-namespace:DesktopOrganizer.UI.Models"
             xmlns:loc="clr-namespace:DesktopOrganizer.UI.Localization"
             xmlns:controls="clr-namespace:DesktopOrganizer.UI.Controls"
             mc:Ignorable="d"
             d:DesignWidth="460">
    <StackPanel>
        <TextBlock Text="{loc:Loc Settings_Nav_LayoutSnapping}" Style="{StaticResource Settings.PageHeader}"/>

        <!-- Snap panel position to grid — toggle + step (GridStep/GridSize, GlobalDefaultsViewModel). -->
        <Border Style="{StaticResource Settings.CardBorder}">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,16,0">
                        <TextBlock Text="{loc:Loc Settings_Layout_SnapToGrid_Header}" Style="{StaticResource Settings.CardHeader}"/>
                        <TextBlock Style="{StaticResource Settings.CardDescription}"
                                   Text="{loc:Loc Settings_Layout_SnapToGrid_Description}"/>
                    </StackPanel>
                    <CheckBox Grid.Column="1" VerticalAlignment="Center"
                              Style="{StaticResource Settings.ToggleCheckBox}"
                              AutomationProperties.Name="{loc:Loc Settings_Layout_SnapToGrid_Header}"
                              IsChecked="{Binding SnapToGridEnabled, Mode=TwoWay}"/>
                </Grid>

                <!-- M-6 fix (docs/prompts/settings-window-redesign.md fix-cycle): Minimum is
                     SizeStepPolicy.GridStepMinimum (2, not a multiple of Step) so a legacy GridSize of 2
                     or 3 — persisted before this window existed — is shown unchanged instead of being
                     coerced up and written back on open (see
                     GlobalDefaultsViewModelTests.LegacyGridSizeTwoOrThree_IsShownUnchanged;
                     SteppedValueEditor never writes back on load — docs/PLANS/color-presets-and-size-step.md
                     §5.3). Delay=300 on the binding means dragging only commits (and saves) once the drag
                     settles, not once per crossed step. -->
                <!-- M-1 fix (review round): the grid-step editor previously had no visible caption of its
                     own (only an AutomationName) — add a TextBlock using the same existing
                     Settings_Layout_GridStep_Label key, matching the icon-size row's own
                     "label | editor" column layout (NewPanelDefaultsSection.xaml). -->
                <Grid Margin="0,10,0,0" IsEnabled="{Binding SnapToGridEnabled}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="220"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{loc:Loc Settings_Layout_GridStep_Label}" Style="{StaticResource Settings.CardHeader}" VerticalAlignment="Center"/>
                    <controls:SteppedValueEditor Grid.Column="1" VerticalAlignment="Center"
                                                  Minimum="{x:Static models:SizeStepPolicy.GridStepMinimum}"
                                                  Maximum="{x:Static models:SizeStepPolicy.GridStepMaximum}"
                                                  AutomationName="{loc:Loc Settings_Layout_GridStep_Label}"
                                                  Value="{Binding GridStep, Mode=TwoWay, Delay=300}"/>
                </Grid>
            </StackPanel>
        </Border>

        <!-- Magnet distance while dragging — enabled only while snapping is on. -->
        <Border Style="{StaticResource Settings.CardBorder}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="50"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2">
                    <TextBlock Text="{loc:Loc Settings_Layout_MagnetDistance_Header}" Style="{StaticResource Settings.CardHeader}"/>
                    <TextBlock Style="{StaticResource Settings.CardDescription}"
                               Visibility="{Binding SnapToGridEnabled, Converter={StaticResource BooleanToVisibility}}"
                               Text="{loc:Loc Settings_Layout_MagnetDistance_Description}"/>
                    <TextBlock Text="{loc:Loc Settings_Layout_MagnetDistance_RequiresSnap_Message}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource Settings.CardDescription}">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SnapToGridEnabled}" Value="False">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>

                <!-- Same slider-row shape as the grid-step card above: slider left, "N px" readout in a
                     fixed 50px column on the right, so the two readouts line up vertically. -->
                <Slider Grid.Row="1" Grid.Column="0" Margin="0,10,12,0"
                        Minimum="0" Maximum="64" TickFrequency="4"
                        SmallChange="1" LargeChange="4"
                        AutomationProperties.Name="{loc:Loc Settings_Layout_MagnetDistance_Header}"
                        Value="{Binding GridSnapDistance, Mode=TwoWay}"
                        IsEnabled="{Binding SnapToGridEnabled}"
                        VerticalAlignment="Center"/>
                <TextBlock Grid.Row="1" Grid.Column="1" Margin="0,10,0,0"
                           Text="{loc:LocBinding GridSnapDistance, FormatKey=Common_ValuePx_Format}"
                           VerticalAlignment="Center" TextAlignment="Right"/>
            </Grid>
        </Border>

        <!-- Snap panel size to icon grid -->
        <Border Style="{StaticResource Settings.CardBorder}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Margin="0,0,16,0">
                    <TextBlock Text="{loc:Loc Settings_Layout_SnapResizeToIconGrid_Header}" Style="{StaticResource Settings.CardHeader}"/>
                    <TextBlock Style="{StaticResource Settings.CardDescription}"
                               Text="{loc:Loc Settings_Layout_SnapResizeToIconGrid_Description}"/>
                </StackPanel>
                <CheckBox Grid.Column="1" VerticalAlignment="Center"
                          Style="{StaticResource Settings.ToggleCheckBox}"
                          AutomationProperties.Name="{loc:Loc Settings_Layout_SnapResizeToIconGrid_Header}"
                          IsChecked="{Binding SnapResizeToIconGrid, Mode=TwoWay}"/>
            </Grid>
        </Border>

        <!-- Lock layout -->
        <Border Style="{StaticResource Settings.CardBorder}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Margin="0,0,16,0">
                    <TextBlock Text="{loc:Loc Common_LockLayout}" Style="{StaticResource Settings.CardHeader}"/>
                    <TextBlock Style="{StaticResource Settings.CardDescription}"
                               Text="{loc:Loc Settings_Layout_LockLayout_Description}"/>
                </StackPanel>
                <CheckBox Grid.Column="1" VerticalAlignment="Center"
                          Style="{StaticResource Settings.ToggleCheckBox}"
                          AutomationProperties.Name="{loc:Loc Common_LockLayout}"
                          IsChecked="{Binding IsLayoutLocked, Mode=TwoWay}"/>
            </Grid>
        </Border>

        <!-- Move/resize outside Edit layout mode — RadioButton group over the 3 NormalModeLayoutGestures values. -->
        <Border Style="{StaticResource Settings.CardBorder}">
            <StackPanel>
                <TextBlock Text="{loc:Loc Settings_Layout_NormalModeGestures_Header}" Style="{StaticResource Settings.CardHeader}"/>
                <TextBlock Style="{StaticResource Settings.CardDescription}"
                           Text="{loc:Loc Settings_Layout_NormalModeGestures_Description}"/>
                <StackPanel Margin="0,6,0,0">
                    <RadioButton GroupName="NormalModeLayoutGestures" Style="{StaticResource Settings.RadioOption}"
                                 Content="{x:Static models:NormalModeLayoutGestures.MoveAndResize}"
                                 ContentTemplate="{StaticResource Settings.EnumRadioLabel}"
                                 AutomationProperties.Name="{loc:Loc Enum_NormalModeLayoutGestures_MoveAndResize}">
                        <RadioButton.IsChecked>
                            <Binding Path="NormalModeLayoutGestures" Converter="{StaticResource EnumToBoolean}"
                                     ConverterParameter="{x:Static models:NormalModeLayoutGestures.MoveAndResize}"/>
                        </RadioButton.IsChecked>
                    </RadioButton>
                    <RadioButton GroupName="NormalModeLayoutGestures" Style="{StaticResource Settings.RadioOption}"
                                 Content="{x:Static models:NormalModeLayoutGestures.MoveOnly}"
                                 ContentTemplate="{StaticResource Settings.EnumRadioLabel}"
                                 AutomationProperties.Name="{loc:Loc Enum_NormalModeLayoutGestures_MoveOnly}">
                        <RadioButton.IsChecked>
                            <Binding Path="NormalModeLayoutGestures" Converter="{StaticResource EnumToBoolean}"
                                     ConverterParameter="{x:Static models:NormalModeLayoutGestures.MoveOnly}"/>
                        </RadioButton.IsChecked>
                    </RadioButton>
                    <RadioButton GroupName="NormalModeLayoutGestures" Style="{StaticResource Settings.RadioOption}"
                                 Content="{x:Static models:NormalModeLayoutGestures.None}"
                                 ContentTemplate="{StaticResource Settings.EnumRadioLabel}"
                                 AutomationProperties.Name="{loc:Loc Enum_NormalModeLayoutGestures_None}">
                        <RadioButton.IsChecked>
                            <Binding Path="NormalModeLayoutGestures" Converter="{StaticResource EnumToBoolean}"
                                     ConverterParameter="{x:Static models:NormalModeLayoutGestures.None}"/>
                        </RadioButton.IsChecked>
                    </RadioButton>
                </StackPanel>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
