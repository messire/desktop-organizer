<UserControl x:Class="DesktopOrganizer.UI.Views.Settings.NewPanelDefaultsSection"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:loc="clr-namespace:DesktopOrganizer.UI.Localization"
             mc:Ignorable="d"
             d:DesignWidth="460">
    <StackPanel>
        <TextBlock Text="{loc:Loc Settings_Nav_NewPanelDefaults}" Style="{StaticResource Settings.PageHeader}"/>
        <TextBlock Style="{StaticResource Settings.CardDescription}" Margin="0,-6,0,10"
                   Text="{loc:Loc Settings_NewPanelDefaults_Description}"/>

        <!-- Accent color -->
        <Border Style="{StaticResource Settings.CardBorder}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{loc:Loc Settings_NewPanelDefaults_AccentColor_Label}" Style="{StaticResource Settings.CardHeader}" VerticalAlignment="Center"/>
                <TextBox Grid.Column="1" Width="90" VerticalAlignment="Center" Margin="0,0,8,0"
                         AutomationProperties.Name="{loc:Loc Settings_NewPanelDefaults_AccentColor_Label}"
                         Text="{Binding DefaultBackgroundColor, UpdateSourceTrigger=LostFocus}"/>
                <Border Grid.Column="2" Width="24" Height="24" CornerRadius="3"
                        BorderBrush="{StaticResource Brush.Settings.SwatchBorder}" BorderThickness="1"
                        Background="{Binding DefaultBackgroundColor, Converter={StaticResource HexBrush}}"/>
            </Grid>
        </Border>

        <!-- Text color -->
        <Border Style="{StaticResource Settings.CardBorder}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{loc:Loc Settings_NewPanelDefaults_TextColor_Label}" Style="{StaticResource Settings.CardHeader}" VerticalAlignment="Center"/>
                <TextBox Grid.Column="1" Width="90" VerticalAlignment="Center" Margin="0,0,8,0"
                         AutomationProperties.Name="{loc:Loc Settings_NewPanelDefaults_TextColor_Label}"
                         Text="{Binding DefaultTextColor, UpdateSourceTrigger=LostFocus}"/>
                <Border Grid.Column="2" Width="24" Height="24" CornerRadius="3"
                        BorderBrush="{StaticResource Brush.Settings.SwatchBorder}" BorderThickness="1"
                        Background="{Binding DefaultTextColor, Converter={StaticResource HexBrush}}"/>
            </Grid>
        </Border>

        <!-- Opacity -->
        <Border Style="{StaticResource Settings.CardBorder}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="140"/>
                    <ColumnDefinition Width="40"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{loc:Loc Settings_NewPanelDefaults_Opacity_Label}" Style="{StaticResource Settings.CardHeader}" VerticalAlignment="Center"/>
                <Slider Grid.Column="1" VerticalAlignment="Center" Minimum="0" Maximum="1"
                        AutomationProperties.Name="{loc:Loc Settings_NewPanelDefaults_Opacity_Label}"
                        Value="{Binding DefaultOpacity, Mode=TwoWay}"/>
                <!-- {0:P0} is left to WPF's own culture resolution via FrameworkElement.Language/CultureSync
                     (docs/PLANS/localization.md §8 inventory note) — no LocBinding needed here. -->
                <TextBlock Grid.Column="2" Text="{Binding DefaultOpacity, StringFormat={}{0:P0}}"
                           VerticalAlignment="Center" TextAlignment="Right"/>
            </Grid>
        </Border>

        <!-- Icon size -->
        <Border Style="{StaticResource Settings.CardBorder}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="140"/>
                    <ColumnDefinition Width="48"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{loc:Loc Common_IconSize_Header}" Style="{StaticResource Settings.CardHeader}" VerticalAlignment="Center"/>
                <Slider Grid.Column="1" VerticalAlignment="Center" Minimum="16" Maximum="96"
                        TickFrequency="4" IsSnapToTickEnabled="True"
                        AutomationProperties.Name="{loc:Loc Common_IconSize_Header}"
                        Value="{Binding DefaultIconSize, Mode=TwoWay}"/>
                <TextBlock Grid.Column="2" Text="{loc:LocBinding DefaultIconSize, FormatKey=Common_ValuePx_Format}"
                           VerticalAlignment="Center" TextAlignment="Right"/>
            </Grid>
        </Border>

        <!-- Surface style -->
        <Border Style="{StaticResource Settings.CardBorder}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="150"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Margin="0,0,16,0">
                    <TextBlock Text="{loc:Loc Common_SurfaceStyle_Header}" Style="{StaticResource Settings.CardHeader}"/>
                    <TextBlock Style="{StaticResource Settings.CardDescription}"
                               Text="{loc:Loc Settings_NewPanelDefaults_SurfaceStyle_Description}"/>
                </StackPanel>
                <ComboBox Grid.Column="1" VerticalAlignment="Center"
                          AutomationProperties.Name="{loc:Loc Common_SurfaceStyle_Header}"
                          ItemsSource="{Binding SurfaceStyleOptions}"
                          SelectedItem="{Binding DefaultSurfaceStyle, Mode=TwoWay}"
                          ItemTemplate="{StaticResource Settings.EnumRadioLabel}"/>
            </Grid>
        </Border>

        <!-- Panel geometry -->
        <Border Style="{StaticResource Settings.CardBorder}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="150"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Margin="0,0,16,0">
                    <TextBlock Text="{loc:Loc Settings_NewPanelDefaults_PanelGeometry_Header}" Style="{StaticResource Settings.CardHeader}"/>
                    <TextBlock Style="{StaticResource Settings.CardDescription}"
                               Text="{loc:Loc Settings_NewPanelDefaults_PanelGeometry_Description}"/>
                </StackPanel>
                <ComboBox Grid.Column="1" VerticalAlignment="Center"
                          AutomationProperties.Name="{loc:Loc Settings_NewPanelDefaults_PanelGeometry_Header}"
                          ItemsSource="{Binding PanelGeometryModeOptions}"
                          SelectedItem="{Binding DefaultPanelGeometryMode, Mode=TwoWay}"
                          ItemTemplate="{StaticResource Settings.EnumRadioLabel}"/>
            </Grid>
        </Border>

        <!-- Icon layout -->
        <Border Style="{StaticResource Settings.CardBorder}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="150"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Margin="0,0,16,0">
                    <TextBlock Text="{loc:Loc Common_IconLayout_Header}" Style="{StaticResource Settings.CardHeader}"/>
                    <TextBlock Style="{StaticResource Settings.CardDescription}"
                               Text="{loc:Loc Settings_NewPanelDefaults_IconLayout_Description}"/>
                </StackPanel>
                <ComboBox Grid.Column="1" VerticalAlignment="Center"
                          AutomationProperties.Name="{loc:Loc Common_IconLayout_Header}"
                          ItemsSource="{Binding IconLayoutPolicyOptions}"
                          SelectedItem="{Binding DefaultIconLayoutPolicy, Mode=TwoWay}"
                          ItemTemplate="{StaticResource Settings.EnumRadioLabel}"/>
            </Grid>
        </Border>

        <!-- Take from selected panel -->
        <Border Style="{StaticResource Settings.CardBorder}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Margin="0,0,16,0">
                    <TextBlock Text="{loc:Loc Settings_NewPanelDefaults_TakeFromSelected_Header}" Style="{StaticResource Settings.CardHeader}"/>
                    <TextBlock Style="{StaticResource Settings.CardDescription}"
                               Text="{loc:Loc Settings_NewPanelDefaults_TakeFromSelected_Description}"/>
                </StackPanel>
                <Button Grid.Column="1" Content="{loc:Loc Settings_NewPanelDefaults_Take_Button}" Padding="12,6" VerticalAlignment="Center"
                        AutomationProperties.Name="{loc:Loc Settings_NewPanelDefaults_TakeFromSelected_Header}"
                        Command="{Binding TakeDefaultsFromSelectedPanelCommand}"/>
            </Grid>
        </Border>
    </StackPanel>
</UserControl>
