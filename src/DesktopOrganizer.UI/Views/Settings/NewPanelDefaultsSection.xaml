<UserControl x:Class="DesktopOrganizer.UI.Views.Settings.NewPanelDefaultsSection"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:loc="clr-namespace:DesktopOrganizer.UI.Localization"
             xmlns:controls="clr-namespace:DesktopOrganizer.UI.Controls"
             xmlns:models="clr-namespace:DesktopOrganizer.UI.Models"
             xmlns:self="clr-namespace:DesktopOrganizer.UI.Views.Settings"
             mc:Ignorable="d"
             d:DesignWidth="460">
    <StackPanel>
        <TextBlock Text="{loc:Loc Settings_Nav_NewPanelDefaults}" Style="{StaticResource Settings.PageHeader}"/>
        <TextBlock Style="{StaticResource Settings.CardDescription}" Margin="0,-6,0,10"
                   Text="{loc:Loc Settings_NewPanelDefaults_Description}"/>

        <!-- Colors (ADR-042): Preview + Mode + Accent colour + Advanced — the SAME redesigned colour editor
             PanelCustomizeWindow uses, via the shared PanelPreviewCard/PanelColorEditor controls. -->
        <controls:PanelPreviewCard PreviewTitle="{loc:Loc Panel_NewTitle}"
                                    AccentHex="{Binding DefaultColors.AccentColor}"
                                    TextHex="{Binding DefaultColors.TextColor}"
                                    SurfaceStyle="{Binding DefaultSurfaceStyle}"
                                    SurfaceOpacity="{Binding DefaultOpacity}"
                                    IconSize="{Binding DefaultIconSize}"/>
        <!-- Backlog 1.x item 5 (§5.2): Surface style/Opacity used to be this section's own stand-alone
             "Surface" card (release-polish-1.0 visual review item 5), duplicated near-verbatim in
             PanelCustomizeWindow.xaml. Both now live inside PanelColorEditor's collapsed-by-default
             "Advanced" card via AdvancedExtraContent — see that DependencyProperty's own remarks
             (PanelColorEditor.xaml.cs) for why every binding below targets THIS SECTION's own DataContext
             (RelativeSource AncestorType=self:NewPanelDefaultsSection — plain AncestorType=UserControl
             would incorrectly resolve to PanelColorEditor itself, also a UserControl, sitting in between)
             rather than inheriting PanelColorEditor's own (DefaultColors, which owns no surface state).
             SetDefaultSurfaceStyleCommand still writes through the EXACT SAME DefaultSurfaceStyle property
             (and therefore the same IAppSettings.DefaultSurfaceStyle setter) it always did — no new setting,
             only a different location.
             Backlog 1.x wave 2 review (M-G): the actual Surface style/Opacity markup is now the shared
             controls:SurfaceOptionsEditor (Controls/SurfaceOptionsEditor.xaml) — this section and
             PanelCustomizeWindow.xaml each used to duplicate ~70 lines of it near-verbatim; see that
             control's own remarks for why it no longer needs the "Path=Children[0]" LabeledBy workaround
             the inline markup this replaces used to need. -->
        <controls:PanelColorEditor DataContext="{Binding DefaultColors}">
            <controls:PanelColorEditor.AdvancedExtraContent>
                <controls:SurfaceOptionsEditor
                    SurfaceStyle="{Binding DataContext.DefaultSurfaceStyle, RelativeSource={RelativeSource AncestorType=self:NewPanelDefaultsSection}, Mode=OneWay}"
                    SurfaceStyleCommand="{Binding DataContext.SetDefaultSurfaceStyleCommand, RelativeSource={RelativeSource AncestorType=self:NewPanelDefaultsSection}}"
                    SurfaceOpacity="{Binding DataContext.DefaultOpacity, RelativeSource={RelativeSource AncestorType=self:NewPanelDefaultsSection}, Mode=TwoWay}"/>
            </controls:PanelColorEditor.AdvancedExtraContent>
        </controls:PanelColorEditor>

        <!-- Icon size — M-3 fix (6.5 review round): now a real controls:SettingsCard, same as every other
             card below it. Previously kept as a manual Border+Grid because SettingsCard's Header/
             Description/ActionContent were plain DependencyProperties, not registered as LOGICAL children —
             SettingsCard.cs's own M-3 remarks close that gap (Header/Description/ActionContent are now
             genuine logical children, the same way PanelColorEditor.AdvancedExtraContent already was), so
             SizeEditorsWiringTests.NewPanelDefaultsSection_SteppedValueEditor_UsesIconSizeRange_AndHostsPanelColorEditor's
             own LogicalTreeHelper walk still finds this SteppedValueEditor unchanged. -->
        <controls:SettingsCard Header="{loc:Loc Common_IconSize_Header}">
            <controls:SettingsCard.ActionContent>
                <controls:SteppedValueEditor VerticalAlignment="Center"
                                              Minimum="{x:Static models:SizeStepPolicy.IconSizeMinimum}"
                                              Maximum="{x:Static models:SizeStepPolicy.IconSizeMaximum}"
                                              AutomationName="{loc:Loc Common_IconSize_Header}"
                                              Value="{Binding DefaultIconSize, Mode=TwoWay}"/>
            </controls:SettingsCard.ActionContent>
        </controls:SettingsCard>

        <!-- Panel geometry — UX#7: the ru-RU enum labels this ComboBox shows (Settings.EnumRadioLabel,
             TextWrapping="Wrap") run noticeably longer than their en-US counterparts, hence MinWidth 190
             rather than SettingsCard's own Auto ActionContent column sizing to the shorter en-US text. -->
        <controls:SettingsCard Header="{loc:Loc Settings_NewPanelDefaults_PanelGeometry_Header}"
                                Description="{loc:Loc Settings_NewPanelDefaults_PanelGeometry_Description}">
            <controls:SettingsCard.ActionContent>
                <ComboBox MinWidth="190" VerticalAlignment="Center"
                          AutomationProperties.Name="{loc:Loc Settings_NewPanelDefaults_PanelGeometry_Header}"
                          ItemsSource="{Binding PanelGeometryModeOptions}"
                          SelectedItem="{Binding DefaultPanelGeometryMode, Mode=TwoWay}"
                          ItemTemplate="{StaticResource Settings.EnumRadioLabel}"/>
            </controls:SettingsCard.ActionContent>
        </controls:SettingsCard>

        <!-- Icon layout -->
        <controls:SettingsCard Header="{loc:Loc Common_IconLayout_Header}"
                                Description="{loc:Loc Settings_NewPanelDefaults_IconLayout_Description}">
            <controls:SettingsCard.ActionContent>
                <ComboBox MinWidth="190" VerticalAlignment="Center"
                          AutomationProperties.Name="{loc:Loc Common_IconLayout_Header}"
                          ItemsSource="{Binding IconLayoutPolicyOptions}"
                          SelectedItem="{Binding DefaultIconLayoutPolicy, Mode=TwoWay}"
                          ItemTemplate="{StaticResource Settings.EnumRadioLabel}"/>
            </controls:SettingsCard.ActionContent>
        </controls:SettingsCard>

        <!-- Take from selected panel -->
        <controls:SettingsCard Header="{loc:Loc Settings_NewPanelDefaults_TakeFromSelected_Header}"
                                Description="{loc:Loc Settings_NewPanelDefaults_TakeFromSelected_Description}">
            <controls:SettingsCard.ActionContent>
                <Button Content="{loc:Loc Settings_NewPanelDefaults_Take_Button}" VerticalAlignment="Center"
                        AutomationProperties.Name="{loc:Loc Settings_NewPanelDefaults_TakeFromSelected_Header}"
                        Command="{Binding TakeDefaultsFromSelectedPanelCommand}"/>
            </controls:SettingsCard.ActionContent>
        </controls:SettingsCard>
    </StackPanel>
</UserControl>
