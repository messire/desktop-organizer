<UserControl x:Class="DesktopOrganizer.UI.Views.Settings.PagesSection"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:loc="clr-namespace:DesktopOrganizer.UI.Localization"
             mc:Ignorable="d"
             d:DesignWidth="460">
    <StackPanel>
        <TextBlock Text="{loc:Loc Settings_Nav_Pages}" Style="{StaticResource Settings.PageHeader}"/>

        <Border Style="{StaticResource Settings.CardBorder}">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{loc:Loc Settings_Nav_Pages}" Style="{StaticResource Settings.CardHeader}" VerticalAlignment="Center"/>
                    <Button Grid.Column="1" Content="{loc:Loc Settings_Pages_AddPage_Button}" Padding="12,6" Command="{Binding AddPageCommand}"/>
                </Grid>

                <ItemsControl ItemsSource="{Binding Pages}" Margin="0,10,0,0"
                              AutomationProperties.Name="{loc:Loc Settings_Nav_Pages}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="{StaticResource Brush.Settings.CardBorder}" BorderThickness="0,0,0,1" Padding="0,8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                                        <!-- Page IDs are DATA, never re-translated when the language changes
                                             (D-5/L-10) — only "default" resolves to a localized display name;
                                             any other ID (including "Page N") is shown exactly as-is. -->
                                        <TextBlock Text="{loc:LocBinding Converter={StaticResource PageDisplayName}}" VerticalAlignment="Center"/>
                                        <TextBlock Text="{loc:Loc Settings_Pages_CurrentBadge}" VerticalAlignment="Center"
                                                   Margin="4,0,0,0"
                                                   Foreground="{StaticResource Brush.Settings.TextMuted}" FontSize="11">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Value="True">
                                                            <DataTrigger.Binding>
                                                                <MultiBinding Converter="{StaticResource EqualityToBool}">
                                                                    <Binding/>
                                                                    <Binding Path="DataContext.CurrentPage" RelativeSource="{RelativeSource AncestorType=UserControl}"/>
                                                                </MultiBinding>
                                                            </DataTrigger.Binding>
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>

                                    <Button Grid.Column="1" Content="{loc:Loc Settings_Pages_MakeCurrent_Button}" Padding="8,4" Margin="0,0,8,0"
                                            FontSize="11"
                                            AutomationProperties.Name="{loc:LocBinding Converter={StaticResource PageDisplayName}, FormatKey=Settings_Pages_MakeCurrent_Format}"
                                            Command="{Binding DataContext.SwitchPageCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"/>
                                    <Button Grid.Column="2" Content="{loc:Loc Common_Remove_Button}" Padding="8,4" FontSize="11"
                                            AutomationProperties.Name="{loc:LocBinding Converter={StaticResource PageDisplayName}, FormatKey=Settings_Pages_Remove_Format}"
                                            Command="{Binding DataContext.RemovePageCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
