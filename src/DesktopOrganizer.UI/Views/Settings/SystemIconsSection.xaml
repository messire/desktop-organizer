<UserControl x:Class="DesktopOrganizer.UI.Views.Settings.SystemIconsSection"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:loc="clr-namespace:DesktopOrganizer.UI.Localization"
             xmlns:controls="clr-namespace:DesktopOrganizer.UI.Controls"
             mc:Ignorable="d"
             d:DesignWidth="460">
    <StackPanel>
        <TextBlock Text="{loc:Loc Settings_Nav_SystemIcons}" Style="{StaticResource Settings.PageHeader}"/>

        <!-- Show system icons panel -->
        <controls:SettingsCard Header="{loc:Loc Settings_SystemIcons_ShowPanel_Header}"
                                Description="{loc:Loc Settings_SystemIcons_ShowPanel_Description}">
            <controls:SettingsCard.ActionContent>
                <CheckBox VerticalAlignment="Center"
                          Style="{StaticResource Theme.ToggleSwitch}"
                          AutomationProperties.Name="{loc:Loc Settings_SystemIcons_ShowPanel_Header}"
                          IsChecked="{Binding SystemIconsPanelEnabled, Mode=TwoWay}"/>
            </controls:SettingsCard.ActionContent>
        </controls:SettingsCard>

        <!-- Show on all virtual desktops -->
        <controls:SettingsCard IsEnabled="{Binding SystemIconsPanelEnabled}"
                                Header="{loc:Loc Settings_SystemIcons_AllVirtualDesktops_Header}"
                                Description="{loc:Loc Settings_SystemIcons_AllVirtualDesktops_Description}">
            <controls:SettingsCard.ActionContent>
                <CheckBox VerticalAlignment="Center"
                          Style="{StaticResource Theme.ToggleSwitch}"
                          AutomationProperties.Name="{loc:Loc Settings_SystemIcons_AllVirtualDesktops_Header}"
                          IsChecked="{Binding SystemIconsPanelOnAllVirtualDesktops, Mode=TwoWay}"/>
            </controls:SettingsCard.ActionContent>
            <StackPanel>
                <TextBlock Text="{loc:Loc Settings_SystemIcons_EnablePanelFirst_Message}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource Settings.CardDescription}">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SystemIconsPanelEnabled}" Value="False">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <!-- Circuit-breaker feedback (finalization MAJOR M-3, ADR-016): the checkbox above stays
                     checked even after the background poll gives up on this system. -->
                <StackPanel Orientation="Horizontal" Margin="0,8,0,0"
                            Visibility="{Binding SystemIconsVirtualDesktopFeatureIneffective, Converter={StaticResource BooleanToVisibility}}">
                    <TextBlock Text="⚠" Foreground="{DynamicResource Theme.Text.Caution}" FontWeight="Bold" Margin="0,0,4,0"/>
                    <TextBlock Text="{loc:Loc Settings_SystemIcons_FeatureIneffective_Message}"
                               Foreground="{DynamicResource Theme.Text.Caution}"
                               FontSize="{DynamicResource Font.Size.Caption}" TextWrapping="Wrap"/>
                </StackPanel>
            </StackPanel>
        </controls:SettingsCard>

        <!-- Visible icons -->
        <controls:SettingsCard IsEnabled="{Binding SystemIconsPanelEnabled}"
                                Header="{loc:Loc Settings_SystemIcons_VisibleIcons_Header}">
            <StackPanel>
                <TextBlock Text="{loc:Loc Settings_SystemIcons_EnablePanelFirst_Message}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource Settings.CardDescription}">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SystemIconsPanelEnabled}" Value="False">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <!-- SystemIconsItems[i].Label is refreshed in place by SystemIconsPanelManager on
                     CultureChanged (docs/PLANS/localization.md §2.9, WP-3) — an ordinary data binding is
                     enough here since the source VALUE itself changes on language switch. -->
                <ItemsControl ItemsSource="{Binding SystemIconsItems}" Margin="0,6,0,0"
                              AutomationProperties.Name="{loc:Loc Settings_SystemIcons_VisibleIcons_Header}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <CheckBox Content="{Binding Label}" IsChecked="{Binding IsVisible, Mode=TwoWay}" Margin="0,3"
                                      AutomationProperties.Name="{Binding Label}"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </controls:SettingsCard>

        <!-- Icon size -->
        <controls:SettingsCard IsEnabled="{Binding SystemIconsPanelEnabled}"
                                Header="{loc:Loc Common_IconSize_Header}">
            <controls:SettingsCard.ActionContent>
                <ComboBox MinWidth="150" VerticalAlignment="Center"
                          AutomationProperties.Name="{loc:Loc Common_IconSize_Header}"
                          ItemsSource="{Binding SystemIconSizeOptions}"
                          SelectedItem="{Binding SystemIconsSize, Mode=TwoWay}"
                          ItemTemplate="{StaticResource Settings.EnumRadioLabel}"/>
            </controls:SettingsCard.ActionContent>
            <TextBlock Text="{loc:Loc Settings_SystemIcons_EnablePanelFirst_Message}">
                <TextBlock.Style>
                    <Style TargetType="TextBlock" BasedOn="{StaticResource Settings.CardDescription}">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding SystemIconsPanelEnabled}" Value="False">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </controls:SettingsCard>
    </StackPanel>
</UserControl>
