<Window x:Class="DesktopOrganizer.UI.Views.SystemIconsPanelWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:DesktopOrganizer.UI.ViewModels"
        mc:Ignorable="d"
        Title="SystemIconsPanel"
        SizeToContent="Width"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        AllowsTransparency="True"
        Background="Transparent"
        WindowStartupLocation="Manual"
        ShowActivated="False">
    <!--
        No Topmost here, by design (revises the ADR-019 trade-off). ADR-019 shipped Topmost="True"
        because dropping the WorkerW parenting left the panel with no way back up the Z-order once
        another window covered it (WS_EX_NOACTIVATE means a click never raises it). That restored
        reachability at the cost of the panel floating over every application, which is not what a
        desktop sidebar should do. The reachability problem is now solved from the other end instead:
        SystemIconsPanelManager re-asserts, on a timer, the Z-order slot directly above the shell
        desktop window (Progman), so the panel keeps sinking back behind ordinary windows — but not
        behind the wallpaper — and is only ever visible over the desktop itself. Progman rather than
        the HWND_BOTTOM pseudo-handle: HWND_BOTTOM only means "below everything else", which does not
        exclude "below the window that paints the wallpaper" (ADR-001 rejected it for that reason).
        ShowActivated="False" stays: the window must not steal focus when it is first shown, since
        the desktop styles (WS_EX_NOACTIVATE) can only be applied after Show() — see ADR-019 §R0.5.
    -->
    <d:Window.DataContext>
        <d:DesignInstance Type="vm:SystemIconsPanelViewModel" IsDesignTimeCreatable="False"/>
    </d:Window.DataContext>

    <!--
        Outer border provides a semi-transparent dark background strip for the panel.
        Width is auto (SizeToContent=Width on the Window drives this).
        Background: Brush.Sidebar.Background (Resources/Styles/Brushes.xaml, C5, D-2/§2.2) — the exact
        same translucent-black value the inline literal here used to have, just named; not
        Brush.Surface.Base (that token is fully opaque by design) or the
        PanelSurfaceBrushConverter/PanelTheme machinery ChildWindow's PanelChrome uses, since this
        sidebar is not a themed panel with its own AccentColor (D-7).
    -->
    <Border Background="{StaticResource Brush.Sidebar.Background}" Padding="4,8">
        <!--
            Grid wraps ItemsControl + insertion indicator so the indicator
            can be positioned absolutely over the items list during drag-reorder.
        -->
        <Grid x:Name="PanelGrid">
            <!--
                ItemsControl -> ListBox (ui-polishing-1 §5.3, D-F1): gives the sidebar the same
                single-selection semantics and selection/hover chrome as the fence panels
                (PanelItemContainerStyle, Resources/Styles/Panels.xaml as of C5 — B-F1's fixed,
                non-clipped border; C5 additionally gives its selected state the panel's own
                PanelTheme.Accent, which for this window is always the neutral default since it never
                sets PanelTheme.Accent — D-7), without duplicating any of its hex tokens.
                Background/BorderThickness/Padding are all
                explicitly zeroed out below to keep the default ListBox theme's own chrome (a
                Padding="1" and a themed border, same trap documented next to ListViewTemplate in
                Templates.xaml) from adding unaccounted pixels to the window's SizeToContent="Width"
                measurement. ScrollViewer.HorizontalScrollBarVisibility="Disabled" for the same reason
                — the vertical StackPanel content only ever grows downward.
            -->
            <ListBox x:Name="IconsListBox"
                     ItemsSource="{Binding VisibleItems}"
                     SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
                     SelectionMode="Single"
                     Background="Transparent"
                     BorderThickness="0"
                     Padding="0"
                     ItemContainerStyle="{StaticResource PanelItemContainerStyle}"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     AllowDrop="True"
                     PreviewMouseLeftButtonDown="IconsListBox_PreviewMouseLeftButtonDown"
                     PreviewMouseMove="IconsListBox_PreviewMouseMove"
                     DragOver="IconsListBox_DragOver"
                     Drop="IconsListBox_Drop"
                     DragLeave="IconsListBox_DragLeave">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <!--
                            Left vertical (matches the pre-migration ItemsControl layout). The
                            drag-reorder code-behind locates this panel by type
                            (FindVisualChild<StackPanel> in SystemIconsPanelWindow.xaml.cs) rather than
                            by name, so it survives the ItemsControl -> ListBox swap unchanged.
                        -->
                        <StackPanel Orientation="Vertical"/>
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <!--
                            Each item uses a Border + MouseBinding instead of Button so that
                            DoubleClick does NOT also fire a Click event (FIX 5).
                            Right-click and drag wiring is unchanged.
                        -->
                        <Border x:Name="IconBorder"
                                Background="Transparent"
                                Padding="4"
                                ToolTip="{Binding Label}"
                                PreviewMouseRightButtonUp="IconButton_PreviewMouseRightButtonUp"
                                AllowDrop="True"
                                DragOver="IconButton_DragOver"
                                Drop="IconButton_Drop">
                            <Border.InputBindings>
                                <MouseBinding Gesture="LeftDoubleClick"
                                              Command="{Binding DataContext.OpenItemCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                              CommandParameter="{Binding Kind}"/>
                            </Border.InputBindings>
                            <StackPanel Orientation="Vertical" HorizontalAlignment="Center">
                                <Image Source="{Binding Icon}"
                                       Width="{Binding DataContext.IconSizePx, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                       Height="{Binding DataContext.IconSizePx, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                       RenderOptions.BitmapScalingMode="HighQuality"
                                       Stretch="Uniform"/>
                                <TextBlock Text="{Binding Label}"
                                           Foreground="{StaticResource Brush.Text.Primary}"
                                           FontSize="10"
                                           TextAlignment="Center"
                                           HorizontalAlignment="Center"
                                           TextWrapping="NoWrap"
                                           Margin="0,3,0,0"/>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <!--
                Insertion indicator: a 2 px horizontal line shown during drag-reorder.
                Hidden by default; shown/positioned in DragOver, hidden in Drop/DragLeave.
                Brush.Border.Focus (Resources/Styles/Brushes.xaml) — the same Ambient Accent token
                ChildWindow.xaml's own ReorderInsertionIndicator uses for the identical purpose (C4);
                that file's own comment documents it as approximating the old hardcoded blue literal
                this element used to have.
            -->
            <Border x:Name="InsertionIndicator"
                    Background="{StaticResource Brush.Border.Focus}"
                    Height="2"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Top"
                    Margin="0,0,0,0"
                    Visibility="Collapsed"
                    IsHitTestVisible="False"/>
        </Grid>
    </Border>
</Window>
